// A small filesystem for the block device behind stdlib/fs/disk.bl0.
// Everything lives in bl0 and talks to the disk only through
// Disk.read(sector) / Disk.write(sector) and the sector buffer, so it moves to
// another machine with nothing but a new Disk driver.
//
// Layout (512-byte sectors, all integers 32-bit big-endian, the byte order of
// peek32/poke32):
//   sector 0            superblock: magic 'BL0F', version, total sectors,
//                       fatStart, fatSectors, dirStart, dirSectors, dataStart
//   FAT                 one 32-bit entry per data sector: 0 = free, -1 = last
//                       sector of a file, otherwise (next data sector + 1)
//   directory           64-byte entries, 8 per sector: name (UTF-8, zero
//                       padded, at most 47 bytes) at 0, first data sector + 1
//                       at 48 (0 = empty file), size in bytes at 52, owner
//                       user id (16 bits) at 56, group id at 58, mode at 60 (bit
//                       15 set = the mode is recorded, bits 0-8 rwxrwxrwx, bit 9
//                       the sticky bit (only the owner of a file or of its folder may
//                       remove or rename it there - the kernel enforces it); an
//                       entry written before these existed has all zero there
//                       and counts as owner 0, group 0, mode 0644 for a file and
//                       0755 for a folder). An entry whose first name byte is 0
//                       is free.
//   data                the rest
//
// The namespace is flat: a name may contain '/', which is just a character -
// ls takes a prefix, so "docs/a.txt" behaves like a file in a folder, but
// there are no directories to create or remove.
//
// A file's new contents are written to freshly allocated sectors first and
// only then does the directory entry switch to them, so a write that fails
// halfway (disk full, power cut) leaves the old contents intact.
//
// The folder the host shares (--bridge-fs, see hostfs.bl0) appears as the
// directory 'host/' of this same namespace, when one is attached: every call
// below - read, write, append, remove, rename, size, list, mkdir via a name ending
// in '/' - works on it exactly as on the disk, and rename/copy-by-readData can
// cross between the two. Code never needs to know which one it is talking to.
// (Disk-only limits - 47-byte names, the 128-entry directory - do not apply there.)
//
// Errors are exceptions whose message starts with "fs: " (catch them with
// try/catch); "not found" is a nil/false return instead. Every public call
// takes Fs.lock, so cores may share the filesystem.

import 'disk.bl0';
import '../str/utf8.bl0';
import 'hostfs.bl0';

def class Fs {
    static field lock;
    static field mounted;
    static field magic;
    static field total;
    static field fatStart;
    static field fatSectors;
    static field dirStart;
    static field dirSectors;
    static field dataStart;
    static field dataSectors;
    static field hint;        // where the next free-sector search starts
    static field freeSlot;    // set by lookup(): first empty directory entry, -1 if none
    static field curUid;      // who the operation in progress is for (see runAs): owner of what it creates
    static field curGid;
    static field umask;       // permission bits a new file or folder does not get
    static field gate;        // the system call that user-mode callers go through, or nil (see run)
    static field volumes;     // the file systems found on the drives: [unit, total, fatStart, fatSectors, dirStart, dirSectors, dataStart, dataSectors, hint]; [0] is the root (nil = gone)
    static field mounts;      // [[folder, index into volumes], ...]: other drives shown as folders of the root
    static field current;     // the volume the statics above describe

    // ---- sector buffer helpers ----

    static def readSector(s) {
        if (!Disk.read(s)) { throw('fs: cannot read sector ' + s); }
    }

    static def writeSector(s) {
        if (!Disk.write(s)) { throw('fs: cannot write sector ' + s); }
    }

    static def zeroBuffer() {
        i = 0;
        while (i < 512) {
            poke32(Disk.bufAddr + i, 0);
            i += 4;
        }
    }

    // ---- FAT ----

    static def fatGet(d) {
        Fs.readSector(Fs.fatStart + (d >> 7));
        return peek32(Disk.bufAddr + ((d & 127) << 2));
    }

    static def fatSet(d, value) {
        Fs.readSector(Fs.fatStart + (d >> 7));
        poke32(Disk.bufAddr + ((d & 127) << 2), value);
        Fs.writeSector(Fs.fatStart + (d >> 7));
    }

    // claims a free data sector as the end of a chain; -1 when the disk is full
    static def allocate() {
        n = Fs.dataSectors;
        d = Fs.hint;
        checked = 0;
        while (checked < n) {
            if (d >= n) { d = 0; }
            sec = Fs.fatStart + (d >> 7);
            first = (d >> 7) << 7;
            Fs.readSector(sec);
            idx = d - first;
            while (idx < 128 && first + idx < n && checked < n) {
                if (peek32(Disk.bufAddr + (idx << 2)) == 0) {
                    poke32(Disk.bufAddr + (idx << 2), -1);
                    Fs.writeSector(sec);
                    Fs.hint = first + idx + 1;
                    return first + idx;
                }
                idx += 1;
                checked += 1;
            }
            d = first + 128;
        }
        return -1;
    }

    static def freeCount() {
        n = Fs.dataSectors;
        free = 0;
        d = 0;
        while (d < n) {
            Fs.readSector(Fs.fatStart + (d >> 7));
            idx = 0;
            while (idx < 128 && d + idx < n) {
                if (peek32(Disk.bufAddr + (idx << 2)) == 0) { free += 1; }
                idx += 1;
            }
            d += 128;
        }
        return free;
    }

    // number of sectors in the chain starting at 'first' (a directory-entry value, 0 = none)
    static def chainLength(first) {
        count = 0;
        v = first;
        while (v > 0 && count <= Fs.dataSectors) {
            count += 1;
            v = Fs.fatGet(v - 1);
        }
        return count;
    }

    static def freeChain(first) {
        v = first;
        count = 0;
        while (v > 0 && count <= Fs.dataSectors) {
            next = Fs.fatGet(v - 1);
            Fs.fatSet(v - 1, 0);
            v = next;
            count += 1;
        }
    }

    // ---- directory ----

    static def entrySector(e) {
        return Fs.dirStart + (e >> 3);
    }

    static def entryAddr(e) {
        return Disk.bufAddr + ((e & 7) << 6);
    }

    // a name as bytes, or an error if it cannot be stored
    static def encodeName(name) {
        bytes = Utf8.encode(name);
        if (len(bytes) == 0 || len(bytes) > 47) {
            free(bytes);
            throw('fs: a file name must be 1 to 47 bytes');
        }
        i = 0;
        while (i < len(bytes)) {
            if (bytes[i] < 32) {
                free(bytes);
                throw('fs: a file name cannot contain control characters');
            }
            i += 1;
        }
        return bytes;
    }

    // directory entry index of the file called 'nameBytes', -1 if there is none;
    // also sets Fs.freeSlot
    static def lookup(nameBytes) {
        Fs.freeSlot = -1;
        count = Fs.dirSectors << 3;
        e = 0;
        while (e < count) {
            if ((e & 7) == 0) { Fs.readSector(Fs.entrySector(e)); }
            addr = Fs.entryAddr(e);
            if (peek8(addr) == 0) {
                if (Fs.freeSlot < 0) { Fs.freeSlot = e; }
            } else {
                same = true;
                i = 0;
                while (i < len(nameBytes)) {
                    if (peek8(addr + i) != nameBytes[i]) { same = false; break; }
                    i += 1;
                }
                if (same && peek8(addr + len(nameBytes)) == 0) { return e; }
            }
            e += 1;
        }
        return -1;
    }

    static def entryFirst(e) {
        Fs.readSector(Fs.entrySector(e));
        return peek32(Fs.entryAddr(e) + 48);
    }

    static def entrySize(e) {
        Fs.readSector(Fs.entrySector(e));
        return peek32(Fs.entryAddr(e) + 52);
    }

    // owner, group and mode as recorded in entry e: [uid, gid, mode] with mode as stored (bit 15 = recorded)
    static def entryMeta(e) {
        Fs.readSector(Fs.entrySector(e));
        addr = Fs.entryAddr(e);
        return [(peek8(addr + 56) << 8) | peek8(addr + 57), (peek8(addr + 58) << 8) | peek8(addr + 59), (peek8(addr + 60) << 8) | peek8(addr + 61)];
    }

    // the meta of a file or folder that is being created now
    static def newMeta(folder) {
        base = folder ? 0x1FF : 0x1B6;          // 0777 / 0666, less the umask (which only ever takes rwx bits away)
        return [Fs.curUid, Fs.curGid, 0x8000 | (base & ~Fs.umask)];
    }

    static def setEntry(e, nameBytes, first, size, meta) {
        Fs.readSector(Fs.entrySector(e));
        addr = Fs.entryAddr(e);
        i = 0;
        while (i < 64) {
            poke8(addr + i, 0);
            i += 1;
        }
        i = 0;
        while (i < len(nameBytes)) {
            poke8(addr + i, nameBytes[i]);
            i += 1;
        }
        poke32(addr + 48, first);
        poke32(addr + 52, size);
        poke8(addr + 56, (meta[0] >> 8) & 255);
        poke8(addr + 57, meta[0] & 255);
        poke8(addr + 58, (meta[1] >> 8) & 255);
        poke8(addr + 59, meta[1] & 255);
        poke8(addr + 60, (meta[2] >> 8) & 255);
        poke8(addr + 61, meta[2] & 255);
        Fs.writeSector(Fs.entrySector(e));
    }

    static def clearEntry(e) {
        Fs.readSector(Fs.entrySector(e));
        addr = Fs.entryAddr(e);
        i = 0;
        while (i < 64) {
            poke8(addr + i, 0);
            i += 1;
        }
        Fs.writeSector(Fs.entrySector(e));
    }

    // ---- file contents ----

    // the bytes of the file whose chain starts at 'first', as an array
    static def readBytes(first, size) {
        out = [];
        v = first;
        remaining = size;
        while (v > 0 && remaining > 0) {
            Fs.readSector(Fs.dataStart + v - 1);
            k = remaining < 512 ? remaining : 512;
            i = 0;
            while (i < k) {
                push(out, peek8(Disk.bufAddr + i));
                i += 1;
            }
            remaining -= k;
            v = Fs.fatGet(v - 1);
        }
        return out;
    }

    static def fillBuffer(data, pos) {
        Fs.zeroBuffer();
        k = len(data) - pos;
        if (k > 512) { k = 512; }
        i = 0;
        while (i < k) {
            poke8(Disk.bufAddr + i, data[pos + i]);
            i += 1;
        }
    }

    // makes the file 'nameBytes' contain 'data' (an array of bytes)
    static def store(nameBytes, data) {
        e = Fs.lookup(nameBytes);
        slot = Fs.freeSlot;
        if (e < 0 && slot < 0) { throw('fs: the directory is full'); }
        old = 0;
        if (e >= 0) { old = Fs.entryFirst(e); }

        size = len(data);
        n = (size + 511) >> 9;
        if (Fs.freeCount() + Fs.chainLength(old) < n) { throw('fs: no space left on device'); }

        sectors = [];
        i = 0;
        while (i < n) {
            d = Fs.allocate();
            if (d < 0) {
                // only reachable if the disk changed under us: give back what was taken
                j = 0;
                while (j < len(sectors)) { Fs.fatSet(sectors[j], 0); j += 1; }
                free(sectors);
                throw('fs: no space left on device');
            }
            push(sectors, d);
            i += 1;
        }
        i = 0;
        while (i + 1 < n) {
            Fs.fatSet(sectors[i], sectors[i + 1] + 1);
            i += 1;
        }
        i = 0;
        while (i < n) {
            Fs.fillBuffer(data, i << 9);
            Fs.writeSector(Fs.dataStart + sectors[i]);
            i += 1;
        }
        first = 0;
        if (n > 0) { first = sectors[0] + 1; }
        target = e < 0 ? slot : e;
        // an existing file keeps its owner and mode; a new one gets the caller's
        meta = e >= 0 ? Fs.entryMeta(e) : Fs.newMeta(nameBytes[len(nameBytes) - 1] == 47);
        Fs.setEntry(target, nameBytes, first, size, meta);
        Fs.freeChain(old);
        free(sectors);
    }

    // ---- mounting and formatting ----

    // the file system on the drive that is selected, as a volume record; nil if there is none
    static def readVolume() {
        if (!Disk.present() || !Disk.read(0)) { return nil; }
        b = Disk.bufAddr;
        if (peek32(b) != Fs.magic || peek32(b + 4) != 1) { return nil; }
        total = peek32(b + 8);
        if (total != Disk.sectors) { return nil; }
        return [Disk.unit, total, peek32(b + 12), peek32(b + 16), peek32(b + 20), peek32(b + 24), peek32(b + 28), total - peek32(b + 28), 0];
    }

    // makes volume i the one the statics describe (and its drive the one the disk driver talks to)
    static def useVolume(i) {
        if (i == Fs.current) { return nil; }
        Fs.volumes[Fs.current][8] = Fs.hint;
        v = Fs.volumes[i];
        Disk.select(v[0]);
        Fs.total = v[1];
        Fs.fatStart = v[2];
        Fs.fatSectors = v[3];
        Fs.dirStart = v[4];
        Fs.dirSectors = v[5];
        Fs.dataStart = v[6];
        Fs.dataSectors = v[7];
        Fs.hint = v[8];
        Fs.current = i;
    }

    // the root file system: the one on drive 0
    static def doMount() {
        Fs.mounted = false;
        Disk.select(0);
        v = Fs.readVolume();
        if (v == nil) { return false; }
        if (len(Fs.volumes) == 0) { push(Fs.volumes, v); } else { Fs.volumes[0] = v; }
        Fs.current = -1;
        Fs.useVolumeFresh(0);
        Fs.mounted = true;
        return true;
    }

    // like useVolume, without saving the old statics (they are not a volume's yet)
    static def useVolumeFresh(i) {
        Fs.current = i;
        v = Fs.volumes[i];
        Fs.total = v[1];
        Fs.fatStart = v[2];
        Fs.fatSectors = v[3];
        Fs.dirStart = v[4];
        Fs.dirSectors = v[5];
        Fs.dataStart = v[6];
        Fs.dataSectors = v[7];
        Fs.hint = 0;
    }

    static def doFormat() {
        Disk.select(0);
        Fs.formatDisk();
        Fs.doMount();
    }

    // writes an empty file system on the selected drive
    static def formatDisk() {
        if (!Disk.present()) { throw('fs: no disk'); }
        total = Disk.sectors;
        if (total < 16) { throw('fs: the disk is too small (16 sectors at least)'); }
        dirSectors = total >> 5;
        if (dirSectors < 1) { dirSectors = 1; }
        if (dirSectors > 16) { dirSectors = 16; }
        fat = 1;
        while (true) {
            need = (total - 1 - dirSectors - fat + 127) >> 7;
            if (need <= fat) { break; }
            fat = need;
        }
        fatStart = 1;
        dirStart = fatStart + fat;
        dataStart = dirStart + dirSectors;

        Fs.zeroBuffer();
        s = 1;
        while (s < dataStart) {
            Fs.writeSector(s);
            s += 1;
        }
        b = Disk.bufAddr;
        poke32(b, Fs.magic);
        poke32(b + 4, 1);
        poke32(b + 8, total);
        poke32(b + 12, fatStart);
        poke32(b + 16, fat);
        poke32(b + 20, dirStart);
        poke32(b + 24, dirSectors);
        poke32(b + 28, dataStart);
        Fs.writeSector(0);
    }

    // ---- the shared host folder, mounted at 'host/' ----

    // the path inside the shared folder for a name under 'host/', nil if the name is
    // on the disk (also when no folder is attached: then 'host' is an ordinary name)
    static def host(name) {
        if (!Hfs.present || Fs.current != 0) { return nil; }
        if (name == 'host' || name == 'host/') { return ''; }
        if (strFind(name, 'host/', 0) != 0) { return nil; }
        rel = strSub(name, 5, len(name));
        if (len(rel) > 0 && strSub(rel, len(rel) - 1, len(rel)) == '/') { rel = strSub(rel, 0, len(rel) - 1); }
        return rel;
    }

    // true/false for a name under 'host/', nil for a disk name
    static def hostIsDir(name) {
        rel = Fs.host(name);
        if (rel == nil) { return nil; }
        if (rel == '') { return true; }
        return Hfs.size(rel) == -2;
    }

    static def hostList(prefix) {
        rest = strSub(prefix, 5, len(prefix));
        cut = -1;
        i = len(rest) - 1;
        while (i >= 0 && cut < 0) {
            if (strSub(rest, i, i + 1) == '/') { cut = i; }
            i -= 1;
        }
        dir = cut < 0 ? '' : strSub(rest, 0, cut);
        start = strSub(rest, cut + 1, len(rest));
        out = [];
        names = [];
        try {
            names = Hfs.list(dir);
        } catch (e) {
            return out;
        }
        i = 0;
        while (i < len(names)) {
            n = names[i];
            folder = strSub(n, len(n) - 1, len(n)) == '/';
            base = folder ? strSub(n, 0, len(n) - 1) : n;
            if (strFind(base, start, 0) == 0) {
                full = dir == '' ? base : dir + '/' + base;
                push(out, ['host/' + full + (folder ? '/' : ''), folder ? 0 : Hfs.size(full)]);
            }
            i += 1;
        }
        return out;
    }

    // ---- operations (called with the lock held) ----

    static def need() {
        if (!Fs.mounted) { throw('fs: no filesystem on the disk (format it first)'); }
    }

    static def doWrite(name, text) {
        rel = Fs.host(name);
        if (rel != nil) {
            if (strSub(name, len(name) - 1, len(name)) == '/') {
                Hfs.mkdir(rel);
            } else {
                data = Utf8.encode(text);
                Hfs.write(rel, data);
                free(data);
            }
            return nil;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        data = Utf8.encode(text);
        Fs.store(nb, data);
        free(data);
        free(nb);
    }

    // adds to the end of a file: fills the last sector, then chains new ones, so
    // the cost does not grow with the file (a log can be appended to forever)
    static def doAppend(name, text) {
        rel = Fs.host(name);
        if (rel != nil) {
            old = Hfs.size(rel) >= 0 ? Hfs.read(rel) : [];
            extra = Utf8.encode(text);
            i = 0;
            while (i < len(extra)) {
                push(old, extra[i]);
                i += 1;
            }
            Hfs.write(rel, old);
            free(extra);
            free(old);
            return nil;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        extra = Utf8.encode(text);
        n = len(extra);
        e = Fs.lookup(nb);
        if (n == 0) {
            if (e < 0) { Fs.store(nb, extra); }
            free(extra);
            free(nb);
            return nil;
        }
        first = 0;
        size = 0;
        if (e >= 0) {
            first = Fs.entryFirst(e);
            size = Fs.entrySize(e);
        }
        if (e < 0 || first == 0) {
            Fs.store(nb, extra);
            free(extra);
            free(nb);
            return nil;
        }
        // last sector of the chain
        last = first - 1;
        steps = 0;
        while (steps <= Fs.dataSectors) {
            next = Fs.fatGet(last);
            if (next <= 0) { break; }
            last = next - 1;
            steps += 1;
        }
        off = size & 511;
        pos = 0;
        if (off != 0) {
            Fs.readSector(Fs.dataStart + last);
            k = 512 - off;
            if (k > n) { k = n; }
            i = 0;
            while (i < k) {
                poke8(Disk.bufAddr + off + i, extra[i]);
                i += 1;
            }
            Fs.writeSector(Fs.dataStart + last);
            pos = k;
        }
        rest = n - pos;
        count = (rest + 511) >> 9;
        if (count > 0) {
            if (Fs.freeCount() < count) { throw('fs: no space left on device'); }
            sectors = [];
            i = 0;
            while (i < count) {
                d = Fs.allocate();
                if (d < 0) { throw('fs: no space left on device'); }
                push(sectors, d);
                i += 1;
            }
            i = 0;
            while (i + 1 < count) {
                Fs.fatSet(sectors[i], sectors[i + 1] + 1);
                i += 1;
            }
            i = 0;
            while (i < count) {
                Fs.fillBuffer(extra, pos + (i << 9));
                Fs.writeSector(Fs.dataStart + sectors[i]);
                i += 1;
            }
            Fs.fatSet(last, sectors[0] + 1);
            free(sectors);
        }
        Fs.setEntry(e, nb, first, size + n, Fs.entryMeta(e));
        free(extra);
        free(nb);
    }

    static def doRead(name) {
        rel = Fs.host(name);
        if (rel != nil) {
            bytes = Fs.hostBytes(rel);
            if (bytes == nil) { return nil; }
            text = Utf8.decode(bytes);
            free(bytes);
            return text;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        if (e < 0) { return nil; }
        first = Fs.entryFirst(e);
        bytes = Fs.readBytes(first, Fs.entrySize(e));
        text = Utf8.decode(bytes);
        free(bytes);
        return text;
    }

    // the file as an array of bytes (nil if missing) - for binary data
    static def doReadData(name) {
        rel = Fs.host(name);
        if (rel != nil) { return Fs.hostBytes(rel); }
        Fs.need();
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        if (e < 0) { return nil; }
        first = Fs.entryFirst(e);
        return Fs.readBytes(first, Fs.entrySize(e));
    }

    static def doWriteData(name, bytes) {
        rel = Fs.host(name);
        if (rel != nil) {
            Hfs.write(rel, bytes);
            return nil;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        Fs.store(nb, bytes);
        free(nb);
    }

    static def doSize(name) {
        rel = Fs.host(name);
        if (rel != nil) {
            n = Hfs.size(rel);
            return n < 0 ? -1 : n;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        if (e < 0) { return -1; }
        return Fs.entrySize(e);
    }

    static def doRemove(name) {
        rel = Fs.host(name);
        if (rel != nil) {
            if (rel == '' || Hfs.size(rel) == -1) { return false; }
            Hfs.remove(rel);
            return true;
        }
        Fs.need();
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        if (e < 0) { return false; }
        first = Fs.entryFirst(e);
        Fs.clearEntry(e);
        Fs.freeChain(first);
        return true;
    }

    static def doRename(from, to) {
        if (Fs.host(from) != nil || Fs.host(to) != nil) { return Fs.moveAcross(from, to); }
        Fs.need();
        fb = Fs.encodeName(from);
        tb = Fs.encodeName(to);
        e = Fs.lookup(fb);
        if (e < 0) {
            free(fb);
            free(tb);
            return false;
        }
        if (Fs.lookup(tb) >= 0) {
            free(fb);
            free(tb);
            throw('fs: ' + to + ' already exists');
        }
        first = Fs.entryFirst(e);
        size = Fs.entrySize(e);
        Fs.setEntry(e, tb, first, size, Fs.entryMeta(e));
        free(fb);
        free(tb);
        return true;
    }

    // rename where one side is the shared folder: copy, then delete the original
    static def moveAcross(from, to) {
        data = Fs.doReadData(from);
        if (data == nil) { return false; }
        if (Fs.doSize(to) >= 0) {
            free(data);
            throw('fs: ' + to + ' already exists');
        }
        Fs.doWriteData(to, data);
        free(data);
        Fs.doRemove(from);
        return true;
    }

    // array of [name, size], sorted by name, for the files whose name starts with 'prefix'
    static def doList(prefix) {
        if (strFind(prefix, 'host/', 0) == 0 && Hfs.present && Fs.current == 0) {
            result = Fs.hostList(prefix);
            Fs.sortEntries(result);
            return result;
        }
        Fs.need();
        result = [];
        count = Fs.dirSectors << 3;
        e = 0;
        while (e < count) {
            if ((e & 7) == 0) { Fs.readSector(Fs.entrySector(e)); }
            addr = Fs.entryAddr(e);
            if (peek8(addr) != 0) {
                bytes = [];
                i = 0;
                while (i < 47 && peek8(addr + i) != 0) {
                    push(bytes, peek8(addr + i));
                    i += 1;
                }
                name = Utf8.decode(bytes);
                free(bytes);
                if (strFind(name, prefix, 0) == 0) {
                    push(result, [name, peek32(addr + 52)]);
                }
            }
            e += 1;
        }
        // the shared folder shows up as a directory of the root
        if (Hfs.present && Fs.current == 0 && strFind('host/', prefix, 0) == 0) { push(result, ['host/', 0]); }
        Fs.sortEntries(result);
        return result;
    }

    // insertion sort by name
    static def sortEntries(result) {
        i = 1;
        while (i < len(result)) {
            item = result[i];
            j = i - 1;
            while (j >= 0 && result[j][0] > item[0]) {
                result[j + 1] = result[j];
                j -= 1;
            }
            result[j + 1] = item;
            i += 1;
        }
    }

    // a file under 'host/' as bytes; nil if missing
    static def hostBytes(rel) {
        n = Hfs.size(rel);
        if (n == -1) { return nil; }
        if (n == -2) { throw('fs: host/' + rel + ' is a folder'); }
        return Hfs.read(rel);
    }

    // [total sectors, data sectors, free data sectors, files]
    static def doInfo() {
        Fs.need();
        files = 0;
        count = Fs.dirSectors << 3;
        e = 0;
        while (e < count) {
            if ((e & 7) == 0) { Fs.readSector(Fs.entrySector(e)); }
            if (peek8(Fs.entryAddr(e)) != 0) { files += 1; }
            e += 1;
        }
        return [Fs.total, Fs.dataSectors, Fs.freeCount(), files];
    }

    // ---- owners and modes ----

    // overwrites the owner, group and mode of entry e
    static def writeMeta(e, meta) {
        Fs.readSector(Fs.entrySector(e));
        addr = Fs.entryAddr(e);
        poke8(addr + 56, (meta[0] >> 8) & 255);
        poke8(addr + 57, meta[0] & 255);
        poke8(addr + 58, (meta[1] >> 8) & 255);
        poke8(addr + 59, meta[1] & 255);
        poke8(addr + 60, (meta[2] >> 8) & 255);
        poke8(addr + 61, meta[2] & 255);
        Fs.writeSector(Fs.entrySector(e));
    }

    // [owner, group, permission bits (rwxrwxrwx = 0-511, sticky = 512), size, kind] for a file (kind 0) or a folder (kind 1), nil if
    // there is none. A folder is its marker entry 'name/' when it has one, otherwise it only exists as long
    // as something is below it (owner 0, group 0, 0755). The shared host folder has no owners: 0777.
    static def doStat(name) {
        if (name == '') { return [0, 0, 0x1ED, 0, 1]; }
        rel = Fs.host(name);
        if (rel != nil) {
            n = rel == '' ? -2 : Hfs.size(rel);
            if (n == -1) { return nil; }
            return [0, 0, 0x1FF, n < 0 ? 0 : n, n < 0 ? 1 : 0];
        }
        Fs.need();
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        folder = false;
        if (e < 0) {
            mb = Fs.encodeName(name + '/');
            e = Fs.lookup(mb);
            free(mb);
            folder = true;
        }
        if (e >= 0) {
            meta = Fs.entryMeta(e);
            perm = (meta[2] & 0x8000) != 0 ? (meta[2] & 0x3FF) : (folder ? 0x1ED : 0x1A4);
            return [meta[0], meta[1], perm, folder ? 0 : Fs.entrySize(e), folder ? 1 : 0];
        }
        inside = Fs.doList(name + '/');
        if (len(inside) > 0) { return [0, 0, 0x1ED, 0, 1]; }
        return nil;
    }

    // the entry index holding the meta of 'name' (a file, or the marker of a folder, which is made when
    // the folder has none yet); -1 for something that is not on the disk
    static def metaEntry(name) {
        nb = Fs.encodeName(name);
        e = Fs.lookup(nb);
        free(nb);
        if (e >= 0) { return e; }
        mb = Fs.encodeName(name + '/');
        e = Fs.lookup(mb);
        if (e < 0) {
            if (len(Fs.doList(name + '/')) == 0) { free(mb); return -1; }
            Fs.store(mb, []);
            e = Fs.lookup(mb);
        }
        free(mb);
        return e;
    }

    // false if there is no such file or folder
    static def doChmod(name, mode) {
        if (Fs.host(name) != nil) { throw('fs: the shared host folder has no modes'); }
        Fs.need();
        e = Fs.metaEntry(name);
        if (e < 0) { return false; }
        meta = Fs.entryMeta(e);
        meta[2] = 0x8000 | (mode & 0x3FF);
        Fs.writeMeta(e, meta);
        return true;
    }

    // who = [uid, gid]; false if there is no such file or folder
    static def doChown(name, who) {
        if (Fs.host(name) != nil) { throw('fs: the shared host folder has no owners'); }
        Fs.need();
        e = Fs.metaEntry(name);
        if (e < 0) { return false; }
        st = Fs.doStat(name);
        meta = Fs.entryMeta(e);
        meta[2] = 0x8000 | st[2];                   // an entry from before modes were recorded keeps what it counted as
        meta[0] = who[0];
        meta[1] = who[1];
        Fs.writeMeta(e, meta);
        return true;
    }

    // ---- public API: one lock around every operation ----

    // Every file-system call comes through here. A caller in user mode does not touch the disk: it asks the
    // kernel (the 'gate', a system call the kernel registers with Fs.gate = vector), which checks who may do
    // what and calls runAs() for them. Kernel code, and anything before the gate exists, runs directly.
    static def run(op, a, b) {
        if (Fs.gate != nil && !isPrivileged()) { return syscall(Fs.gate, [op, a, b]); }
        return Fs.runAs(0, 0, op, a, b);
    }

    // the operation for user 'uid', group 'gid': what it creates is theirs
    static def runAs(uid, gid, op, a, b) {
        lock(Fs.lock);
        Fs.curUid = uid;
        Fs.curGid = gid;
        result = nil;
        try {
            result = Fs.routed(op, a, b);
        } catch (err) {
            Fs.useVolume(0);
            unlock(Fs.lock);
            throw(err);
        }
        unlock(Fs.lock);
        return result;
    }

    // one operation on the volume that is current
    static def dispatch(op, a, b) {
        result = nil;
        if (op == 1) { Fs.doWrite(a, b); }
        else if (op == 2) { result = Fs.doRead(a); }
        else if (op == 3) { result = Fs.doRemove(a); }
        else if (op == 4) { result = Fs.doList(a); }
        else if (op == 5) { result = Fs.doRename(a, b); }
        else if (op == 6) { result = Fs.doSize(a); }
        else if (op == 7) { result = Fs.doInfo(); }
        else if (op == 8) { Fs.doFormat(); }
        else if (op == 9) { result = Fs.doMount(); }
        else if (op == 10) { Fs.doAppend(a, b); }
        else if (op == 11) { result = Fs.doReadData(a); }
        else if (op == 12) { Fs.doWriteData(a, b); }
        else if (op == 13) { result = Fs.doStat(a); }
        else if (op == 14) { result = Fs.doChmod(a, b); }
        else if (op == 15) { result = Fs.doChown(a, b); }
        else if (op == 16) { result = Fs.doMountUnit(a, b); }
        else if (op == 17) { result = Fs.doUmount(a); }
        else if (op == 18) { Fs.doFormatUnit(a); }
        else if (op == 19) { result = Fs.doMounts(); }
        else if (op == 20) { result = Fs.doUnits(); }
        return result;
    }

    // ---- other drives, mounted as folders ----
    //
    // A drive with a file system of its own appears as a folder of the root: after Fs.mountDrive(1, 'mnt/usb'), a name
    // below 'mnt/usb/' lives on drive 1, and the folder itself is the drive's top level. The folder must exist (it
    // is an ordinary one on the root disk). routed() looks at the first name of an operation, switches to that
    // drive's volume for the duration (the sector buffer and geometry are one set of statics, so everything
    // happens under Fs.lock) and gives the answer back with the folder's name put in front where names come back.

    // [volume index, the name inside that volume] for a name below a mount point, nil for the root disk. The
    // mount point itself (no trailing '/') stays the root's own folder for what is about the folder - its owner,
    // its mode, removing it - and is the drive's top level for everything else.
    static def resolve(name, op) {
        i = 0;
        while (i < len(Fs.mounts)) {
            point = Fs.mounts[i][0];
            idx = Fs.mounts[i][1];
            if (name == point) {
                if (op == 3 || op == 5 || op == 6 || op == 13 || op == 14 || op == 15) { return nil; }
                return [idx, ''];
            }
            if (strFind(name, point + '/', 0) == 0) { return [idx, strSub(name, len(point) + 1, len(name))]; }
            i += 1;
        }
        return nil;
    }

    static def onVolume(idx, op, a, b) {
        Fs.useVolume(idx);
        result = nil;
        try {
            result = Fs.dispatch(op, a, b);
        } catch (err) {
            Fs.useVolume(0);
            throw(err);
        }
        Fs.useVolume(0);
        return result;
    }

    static def routed(op, a, b) {
        if (len(Fs.mounts) == 0 || op >= 16 || op == 8 || op == 9) { return Fs.dispatch(op, a, b); }
        if (op == 5) { return Fs.routedRename(a, b); }
        if (a == nil) { return Fs.dispatch(op, a, b); }
        if (op == 4) { return Fs.routedList(a); }
        r = Fs.resolve(a, op);
        if (r == nil) { return Fs.dispatch(op, a, b); }
        if (r[1] == '') {
            // the drive's top level is a folder: it cannot be written to as a file or taken away
            if (op == 1) { return nil; }                 // making the folder that is already there
            if (op == 3) { throw('fs: ' + strSub(a, 0, len(a) - (strSub(a, len(a) - 1, len(a)) == '/' ? 1 : 0)) + ' is a mount point (unmount it)'); }
            if (op == 2 || op == 10 || op == 11 || op == 12) { throw('fs: ' + a + ' is a folder'); }
        }
        return Fs.onVolume(r[0], op, r[1], b);
    }

    static def withPoint(names, point) {
        i = 0;
        while (i < len(names)) {
            names[i] = [point + '/' + names[i][0], names[i][1]];
            i += 1;
        }
        return names;
    }

    // the listing of everything whose name starts with 'prefix': the root's, plus - for mount points below the
    // prefix - what the drives hold, and - for a prefix inside a mount point - only the drive's
    static def routedList(prefix) {
        r = Fs.resolve(prefix, 4);
        if (r != nil) {
            point = '';
            i = 0;
            while (i < len(Fs.mounts)) {
                if (Fs.mounts[i][1] == r[0]) { point = Fs.mounts[i][0]; }
                i += 1;
            }
            names = Fs.withPoint(Fs.onVolume(r[0], 4, r[1], nil), point);
            if (r[1] == '') { push(names, [point + '/', 0]); }        // the folder itself exists even when the drive is empty
            Fs.sortEntries(names);
            return names;
        }
        result = Fs.dispatch(4, prefix, nil);
        i = 0;
        while (i < len(Fs.mounts)) {
            point = Fs.mounts[i][0];
            if (strFind(point + '/', prefix, 0) == 0) {
                inside = Fs.withPoint(Fs.onVolume(Fs.mounts[i][1], 4, '', nil), point);
                j = 0;
                while (j < len(inside)) { push(result, inside[j]); j += 1; }
            }
            i += 1;
        }
        Fs.sortEntries(result);
        return result;
    }

    static def routedRename(from, to) {
        ra = Fs.resolve(from, 5);
        rb = Fs.resolve(to, 5);
        i = 0;
        while (i < len(Fs.mounts)) {
            if (from == Fs.mounts[i][0] || to == Fs.mounts[i][0]) { throw('fs: ' + Fs.mounts[i][0] + ' is a mount point'); }
            i += 1;
        }
        ia = ra == nil ? 0 : ra[0];
        ib = rb == nil ? 0 : rb[0];
        if (ia == ib) {
            if (ia == 0) { return Fs.dispatch(5, from, to); }
            return Fs.onVolume(ia, 5, ra[1], rb[1]);
        }
        // from one drive to another: copy, then delete the original
        data = Fs.routed(11, from, nil);
        if (data == nil) { return false; }
        if (Fs.routed(6, to, nil) >= 0) {
            free(data);
            throw('fs: ' + to + ' already exists');
        }
        Fs.routed(12, to, data);
        free(data);
        Fs.routed(3, from, nil);
        return true;
    }

    // mounts drive 'unit' (which holds a file system) as the folder 'point'
    static def doMountUnit(unit, point) {
        Fs.need();
        if (point == '' || point == 'host' || strFind(point, 'host/', 0) == 0) { throw('fs: cannot mount there'); }
        if (unit < 1 || unit >= Disk.units()) { throw('fs: no drive ' + unit); }
        i = 0;
        while (i < len(Fs.mounts)) {
            if (Fs.volumes[Fs.mounts[i][1]][0] == unit) { throw('fs: drive ' + unit + ' is already mounted on ' + Fs.mounts[i][0]); }
            if (Fs.mounts[i][0] == point || strFind(point, Fs.mounts[i][0] + '/', 0) == 0 || strFind(Fs.mounts[i][0], point + '/', 0) == 0) {
                throw('fs: ' + point + ' is in a mounted drive or holds one');
            }
            i += 1;
        }
        st = Fs.doStat(point);
        if (st == nil || st[4] != 1) { throw('fs: ' + point + ': no such folder'); }
        Disk.select(unit);
        v = Fs.readVolume();
        Disk.select(Fs.volumes[Fs.current][0]);
        if (v == nil) { throw('fs: drive ' + unit + ' holds no file system (format it first)'); }
        push(Fs.volumes, v);
        push(Fs.mounts, [point, len(Fs.volumes) - 1]);
        return true;
    }

    // the folder 'point' goes back to being an ordinary folder of the root disk
    static def doUmount(point) {
        kept = [];
        found = false;
        i = 0;
        while (i < len(Fs.mounts)) {
            if (Fs.mounts[i][0] == point) {
                Fs.volumes[Fs.mounts[i][1]] = nil;
                found = true;
            } else {
                push(kept, Fs.mounts[i]);
            }
            i += 1;
        }
        if (!found) { throw('fs: ' + point + ' is not a mount point'); }
        Fs.mounts = kept;
        return true;
    }

    // an empty file system on drive 'unit', which must not be mounted (nor be the root's)
    static def doFormatUnit(unit) {
        if (unit < 0 || unit >= Disk.units()) { throw('fs: no drive ' + unit); }
        i = 0;
        while (i < len(Fs.volumes)) {
            if (Fs.volumes[i] != nil && Fs.volumes[i][0] == unit) { throw('fs: drive ' + unit + ' is in use (unmount it first)'); }
            i += 1;
        }
        Disk.select(unit);
        try {
            Fs.formatDisk();
        } catch (err) {
            Disk.select(Fs.volumes[Fs.current][0]);
            throw(err);
        }
        Disk.select(Fs.volumes[Fs.current][0]);
    }

    // [[folder, drive, total sectors, free data sectors], ...] for what is mounted
    static def doMounts() {
        out = [];
        i = 0;
        while (i < len(Fs.mounts)) {
            idx = Fs.mounts[i][1];
            Fs.useVolume(idx);
            push(out, [Fs.mounts[i][0], Fs.volumes[idx][0], Fs.total, Fs.freeCount()]);
            Fs.useVolume(0);
            i += 1;
        }
        return out;
    }

    // [[drive, sectors, where it is mounted ('/' = the root, '' = nowhere)], ...] for every drive
    static def doUnits() {
        out = [];
        n = Disk.units();
        u = 0;
        while (u < n) {
            Disk.select(u);
            where = '';
            if (u == 0) { where = '/'; }
            i = 0;
            while (i < len(Fs.mounts)) {
                if (Fs.volumes[Fs.mounts[i][1]][0] == u) { where = Fs.mounts[i][0]; }
                i += 1;
            }
            push(out, [u, Disk.sectors, where]);
            u += 1;
        }
        Disk.select(Fs.volumes[Fs.current][0]);
        return out;
    }

    // Disk.init() must have run. False when the disk holds no filesystem.
    static def mount() { return Fs.run(9, nil, nil); }
    static def format() { Fs.run(8, nil, nil); }
    static def write(name, text) { Fs.run(1, name, text); }
    static def append(name, text) { Fs.run(10, name, text); }
    // the file's text, or nil if there is no such file
    static def read(name) { return Fs.run(2, name, nil); }
    // the same for binary data: an array of ints 0-255 (readData gives nil if missing)
    static def readData(name) { return Fs.run(11, name, nil); }
    static def writeData(name, bytes) { Fs.run(12, name, bytes); }
    // true if the file existed
    static def remove(name) { return Fs.run(3, name, nil); }
    static def rename(from, to) { return Fs.run(5, from, to); }
    // size in bytes, -1 if there is no such file
    static def size(name) { return Fs.run(6, name, nil); }
    static def exists(name) { return Fs.run(6, name, nil) >= 0; }
    // array of [name, size]
    static def list(prefix) { return Fs.run(4, prefix, nil); }
    // [total sectors, data sectors, free data sectors, files]
    static def info() { return Fs.run(7, nil, nil); }
    // the same for the drive that holds 'name'
    static def infoOf(name) { return Fs.run(7, name, nil); }
    // mounts drive 'unit' (it must hold a file system) as the existing folder 'point'; unmount puts it away
    static def mountDrive(unit, point) { return Fs.run(16, unit, point); }
    static def unmountDrive(point) { return Fs.run(17, point, nil); }
    // an empty file system on an unused drive
    static def formatUnit(unit) { Fs.run(18, unit, nil); }
    // [[folder, drive, total sectors, free data sectors], ...]
    static def mountList() { return Fs.run(19, nil, nil); }
    // [[drive, sectors, where mounted], ...]
    static def driveList() { return Fs.run(20, nil, nil); }
    // [owner, group, permission bits (0-511: rwxrwxrwx), size, kind (0 file, 1 folder)], nil if there is none
    static def stat(name) { return Fs.run(13, name, nil); }
    static def chmod(name, mode) { return Fs.run(14, name, mode); }
    static def chown(name, uid, gid) { return Fs.run(15, name, [uid, gid]); }
}
Fs.magic = 0x424C3046; // 'BL0F'
Fs.mounted = false;
Fs.lock = newMutex();
Fs.volumes = [];
Fs.mounts = [];
Fs.current = 0;
Fs.curUid = 0;
Fs.curGid = 0;
Fs.umask = 0x12;     // 022
Fs.gate = nil;
