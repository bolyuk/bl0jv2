// there's no substring opcode, so this builds one a character at a time.
// shared dependency of find.bl0 and trim.bl0.

def class Substr {
    static def substr(s, from, to) {
        result = '';
        i = from;
        while (i < to) {
            result = result + s[i];
            i = i + 1;
        }
        return result;
    }
}
