import 'substr.bl0';

def class Find {
    // index of the first occurrence of sub in s, or -1; '' is found at 0
    static def find(s, sub) {
        return strFind(s, sub, 0);
    }

    // same, but starting the search at index 'from'
    static def findFrom(s, sub, from) {
        return strFind(s, sub, from);
    }
}
