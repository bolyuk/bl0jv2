// no char-case primitive exists, so casing goes through a lookup against
// paired alphabet strings instead.

def class Case {
    static def indexOfChar(s, c) {
        i = 0;
        while (i < len(s)) {
            if (s[i] == c) { return i; }
            i = i + 1;
        }
        return -1;
    }

    static def upper(s) {
        lowerAlpha = 'abcdefghijklmnopqrstuvwxyz';
        upperAlpha = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        result = '';
        i = 0;
        while (i < len(s)) {
            idx = Case.indexOfChar(lowerAlpha, s[i]);
            if (idx >= 0) { result = result + upperAlpha[idx]; }
            else { result = result + s[i]; }
            i = i + 1;
        }
        return result;
    }

    static def lower(s) {
        lowerAlpha = 'abcdefghijklmnopqrstuvwxyz';
        upperAlpha = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        result = '';
        i = 0;
        while (i < len(s)) {
            idx = Case.indexOfChar(upperAlpha, s[i]);
            if (idx >= 0) { result = result + lowerAlpha[idx]; }
            else { result = result + s[i]; }
            i = i + 1;
        }
        return result;
    }
}
