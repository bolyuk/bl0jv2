// SHA-512 (FIPS 180-4) over an array of bytes: Sha512.digest(bytes) is the 64 bytes of the hash (an array of
// numbers 0-255). A 64-bit word is two 32-bit numbers (high, low) - the VM's integers are 32 bits and wrap - and the
// carry out of the low half is found with the usual bit formula. Not constant-time.

def class Sha512 {
    static field k;      // the 80 round constants as (high, low) pairs
    static field init;   // the 8 starting words as (high, low) pairs

    // the carry out of x + y whose 32-bit sum is s
    static def carry(x, y, s) {
        return ((x & y) | ((x | y) & ~s)) >>> 31;
    }

    // a 64-bit (hi, lo) rotated right by n (1 - 63, not 32 itself being special): the high half and the low half
    static def rotHi(hi, lo, n) {
        if (n < 32) { return (hi >>> n) | (lo << (32 - n)); }
        if (n == 32) { return lo; }
        m = n - 32;
        return (lo >>> m) | (hi << (32 - m));
    }

    static def rotLo(hi, lo, n) {
        if (n < 32) { return (lo >>> n) | (hi << (32 - n)); }
        if (n == 32) { return hi; }
        m = n - 32;
        return (hi >>> m) | (lo << (32 - m));
    }

    // the compression of one 128-byte block at 'at' in 'm' into the state h (16 numbers)
    static def block(h, m, at) {
        w = [];
        t = 0;
        while (t < 16) {
            j = at + t * 8;
            push(w, (m[j] << 24) | (m[j + 1] << 16) | (m[j + 2] << 8) | m[j + 3]);
            push(w, (m[j + 4] << 24) | (m[j + 5] << 16) | (m[j + 6] << 8) | m[j + 7]);
            t += 1;
        }
        while (t < 80) {
            // s0 = rotr1 ^ rotr8 ^ shr7 of w[t-15]; s1 = rotr19 ^ rotr61 ^ shr6 of w[t-2]
            xh = w[2 * (t - 15)]; xl = w[2 * (t - 15) + 1];
            s0h = Sha512.rotHi(xh, xl, 1) ^ Sha512.rotHi(xh, xl, 8) ^ (xh >>> 7);
            s0l = Sha512.rotLo(xh, xl, 1) ^ Sha512.rotLo(xh, xl, 8) ^ ((xl >>> 7) | (xh << 25));
            yh = w[2 * (t - 2)]; yl = w[2 * (t - 2) + 1];
            s1h = Sha512.rotHi(yh, yl, 19) ^ Sha512.rotHi(yh, yl, 61) ^ (yh >>> 6);
            s1l = Sha512.rotLo(yh, yl, 19) ^ Sha512.rotLo(yh, yl, 61) ^ ((yl >>> 6) | (yh << 26));
            // w[t] = w[t-16] + s0 + w[t-7] + s1
            lo = w[2 * (t - 16) + 1] + s0l;
            hi = w[2 * (t - 16)] + s0h + Sha512.carry(w[2 * (t - 16) + 1], s0l, lo);
            l2 = lo + w[2 * (t - 7) + 1];
            hi = hi + w[2 * (t - 7)] + Sha512.carry(lo, w[2 * (t - 7) + 1], l2);
            l3 = l2 + s1l;
            hi = hi + s1h + Sha512.carry(l2, s1l, l3);
            push(w, hi);
            push(w, l3);
            t += 1;
        }
        k = Sha512.k;
        ah = h[0]; al = h[1]; bh = h[2]; bl = h[3]; ch_ = h[4]; cl = h[5]; dh = h[6]; dl = h[7];
        eh = h[8]; el = h[9]; fh = h[10]; fl = h[11]; gh = h[12]; gl = h[13]; hh = h[14]; hl = h[15];
        t = 0;
        while (t < 80) {
            // S1 = rotr14 ^ rotr18 ^ rotr41 of e
            S1h = Sha512.rotHi(eh, el, 14) ^ Sha512.rotHi(eh, el, 18) ^ Sha512.rotHi(eh, el, 41);
            S1l = Sha512.rotLo(eh, el, 14) ^ Sha512.rotLo(eh, el, 18) ^ Sha512.rotLo(eh, el, 41);
            chh = (eh & fh) ^ ((~eh) & gh);
            chl = (el & fl) ^ ((~el) & gl);
            // T1 = h + S1 + ch + k[t] + w[t]
            l1 = hl + S1l;
            t1h = hh + S1h + Sha512.carry(hl, S1l, l1);
            l2 = l1 + chl;
            t1h = t1h + chh + Sha512.carry(l1, chl, l2);
            l3 = l2 + k[2 * t + 1];
            t1h = t1h + k[2 * t] + Sha512.carry(l2, k[2 * t + 1], l3);
            l4 = l3 + w[2 * t + 1];
            t1h = t1h + w[2 * t] + Sha512.carry(l3, w[2 * t + 1], l4);
            t1l = l4;
            // T2 = S0 + maj; S0 = rotr28 ^ rotr34 ^ rotr39 of a
            S0h = Sha512.rotHi(ah, al, 28) ^ Sha512.rotHi(ah, al, 34) ^ Sha512.rotHi(ah, al, 39);
            S0l = Sha512.rotLo(ah, al, 28) ^ Sha512.rotLo(ah, al, 34) ^ Sha512.rotLo(ah, al, 39);
            mjh = (ah & bh) ^ (ah & ch_) ^ (bh & ch_);
            mjl = (al & bl) ^ (al & cl) ^ (bl & cl);
            t2l = S0l + mjl;
            t2h = S0h + mjh + Sha512.carry(S0l, mjl, t2l);
            hh = gh; hl = gl; gh = fh; gl = fl; fh = eh; fl = el;
            // e = d + T1
            nl = dl + t1l;
            eh = dh + t1h + Sha512.carry(dl, t1l, nl);
            el = nl;
            dh = ch_; dl = cl; ch_ = bh; cl = bl; bh = ah; bl = al;
            // a = T1 + T2
            nl = t1l + t2l;
            ah = t1h + t2h + Sha512.carry(t1l, t2l, nl);
            al = nl;
            t += 1;
        }
        Sha512.addInto(h, 0, ah, al); Sha512.addInto(h, 2, bh, bl); Sha512.addInto(h, 4, ch_, cl); Sha512.addInto(h, 6, dh, dl);
        Sha512.addInto(h, 8, eh, el); Sha512.addInto(h, 10, fh, fl); Sha512.addInto(h, 12, gh, gl); Sha512.addInto(h, 14, hh, hl);
    }

    // h[at], h[at + 1] += (hi, lo)
    static def addInto(h, at, hi, lo) {
        s = h[at + 1] + lo;
        h[at] = h[at] + hi + Sha512.carry(h[at + 1], lo, s);
        h[at + 1] = s;
    }

    static def digest(data) {
        n = len(data);
        padded = [];
        i = 0;
        while (i < n) { push(padded, data[i]); i += 1; }
        push(padded, 0x80);
        while ((len(padded) % 128) != 112) { push(padded, 0); }
        i = 0;
        while (i < 12) { push(padded, 0); i += 1; }              // the length in bits is 128 bits; ours (a message under 256 MB) fits in 32
        bits = n * 8;
        push(padded, (bits >>> 24) & 255);
        push(padded, (bits >>> 16) & 255);
        push(padded, (bits >>> 8) & 255);
        push(padded, bits & 255);
        h = [];
        i = 0;
        while (i < 16) { push(h, Sha512.init[i]); i += 1; }
        at = 0;
        while (at < len(padded)) {
            Sha512.block(h, padded, at);
            at += 128;
        }
        out = [];
        i = 0;
        while (i < 16) {
            push(out, (h[i] >>> 24) & 255);
            push(out, (h[i] >>> 16) & 255);
            push(out, (h[i] >>> 8) & 255);
            push(out, h[i] & 255);
            i += 1;
        }
        return out;
    }
}
