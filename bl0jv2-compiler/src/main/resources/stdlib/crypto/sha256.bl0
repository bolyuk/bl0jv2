// SHA-256 (FIPS 180-4) over text (UTF-8) or an array of bytes. Sha256.hex('abc') is
// 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'. Written for 32-bit wrapping
// integers: + wraps, >>> is the logical shift. Not constant-time, and not a password-stretching function
// by itself: callers add a salt and repeat it (see aeon-os/lib/users.bl0).

import '../str/utf8.bl0';

def class Sha256 {
    static field k;

    static def rotr(x, n) {
        return (x >>> n) | (x << (32 - n));
    }

    static def hexWord(w) {
        digits = '0123456789abcdef';
        out = '';
        shift = 28;
        while (shift >= 0) {
            out = out + digits[(w >>> shift) & 15];
            shift -= 4;
        }
        return out;
    }

    // the digest of an array of bytes, as 8 words
    static def words(data) {
        n = len(data);
        padded = [];
        i = 0;
        while (i < n) { push(padded, data[i]); i += 1; }
        push(padded, 0x80);
        while ((len(padded) % 64) != 56) { push(padded, 0); }
        bits = n * 8;
        push(padded, 0);
        push(padded, 0);
        push(padded, 0);
        push(padded, (n >>> 29) & 255);
        push(padded, (bits >>> 24) & 255);
        push(padded, (bits >>> 16) & 255);
        push(padded, (bits >>> 8) & 255);
        push(padded, bits & 255);

        h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
        k = Sha256.k;
        block = 0;
        while (block < len(padded)) {
            w = [];
            t = 0;
            while (t < 16) {
                j = block + t * 4;
                push(w, (padded[j] << 24) | (padded[j + 1] << 16) | (padded[j + 2] << 8) | padded[j + 3]);
                t += 1;
            }
            while (t < 64) {
                s0 = Sha256.rotr(w[t - 15], 7) ^ Sha256.rotr(w[t - 15], 18) ^ (w[t - 15] >>> 3);
                s1 = Sha256.rotr(w[t - 2], 17) ^ Sha256.rotr(w[t - 2], 19) ^ (w[t - 2] >>> 10);
                push(w, w[t - 16] + s0 + w[t - 7] + s1);
                t += 1;
            }
            a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4]; f = h[5]; g = h[6]; hh = h[7];
            t = 0;
            while (t < 64) {
                S1 = Sha256.rotr(e, 6) ^ Sha256.rotr(e, 11) ^ Sha256.rotr(e, 25);
                ch = (e & f) ^ ((~e) & g);
                t1 = hh + S1 + ch + k[t] + w[t];
                S0 = Sha256.rotr(a, 2) ^ Sha256.rotr(a, 13) ^ Sha256.rotr(a, 22);
                maj = (a & b) ^ (a & c) ^ (b & c);
                t2 = S0 + maj;
                hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
                t += 1;
            }
            h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
            h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
            block += 64;
        }
        return h;
    }

    // the 32 bytes of the digest of an array of bytes
    static def digest(data) {
        h = Sha256.words(data);
        out = [];
        i = 0;
        while (i < 8) {
            push(out, (h[i] >>> 24) & 255);
            push(out, (h[i] >>> 16) & 255);
            push(out, (h[i] >>> 8) & 255);
            push(out, h[i] & 255);
            i += 1;
        }
        return out;
    }

    static def hexOfBytes(data) {
        h = Sha256.words(data);
        out = '';
        i = 0;
        while (i < 8) { out = out + Sha256.hexWord(h[i]); i += 1; }
        return out;
    }

    static def hex(text) {
        bytes = Utf8.encode(text);
        out = Sha256.hexOfBytes(bytes);
        free(bytes);
        return out;
    }
}
Sha256.k = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
