import 'nic.bl0';
import '../arrlib.bl0';
import '../str/char.bl0';

// minimal IPv4-shaped header: fixed 20 bytes, no options, no fragmentation
// (identification/flags/fragment-offset are always 0). Real enough to
// practice header packing and a real checksum, not a full RFC791
// implementation - this is a toy stack over a loopback device that can't
// corrupt or reorder anything, not a real routable IP implementation.
//
// layout (byte offsets):
//   0      version_ihl    always 0x45 (version 4, 5 x 32-bit words = 20 bytes)
//   1      tos            always 0
//   2-3    total length   header + payload, big-endian u16
//   4-5    identification always 0 (no fragmentation support)
//   6-7    flags+fragOff  always 0
//   8      ttl            always 64
//   9      protocol       17 = UDP (the only one this stack builds)
//   10-11  header checksum
//   12-15  source address, big-endian u32
//   16-19  destination address, big-endian u32
//
// byteAt/u16From/u32From/checksum live here as Ip's own static methods
// (not free functions) even though stdlib/net/tcp.bl0 uses them just as
// much as this file does - they're byte/wire-format primitives every
// protocol layer in this stack builds on, and Ip is already the lowest
// one, the same way a real stack's own byte-order helpers tend to live in
// the IP layer's own utility code.
def class Ip {
    static field protoIcmp;
    static field protoUdp;
    static field protoTcp;

    // one byte out of v, 'shift' bits up from the bottom - the one
    // primitive every header-packing/parsing method below is built from
    static def byteAt(v, shift) {
        return (v >>> shift) & 0xFF;
    }

    static def u16From(bytes, offset) {
        return (bytes[offset] << 8) | bytes[offset + 1];
    }

    static def u32From(bytes, offset) {
        return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3];
    }

    // byte -> single-char string for reconstructing a payload: the character whose code is the byte, for every
    // byte 0-255, so a payload survives the trip through a string exactly (bytesOf() is the way back) - binary
    // protocols such as SSH depend on it. Such a string is a carrier for bytes, not text to print: the bytes
    // above 127 are the characters U+0080 - U+00FF.
    static def netByteToChar(b) {
        return strChar(b);
    }

    // an array of byte values as a string of the same characters
    static def stringOf(bytes) {
        parts = [];
        i = 0;
        while (i < len(bytes)) { push(parts, strChar(bytes[i])); i += 1; }
        return strJoin(parts, '');
    }

    // standard Internet checksum (RFC1071): ones'-complement sum of 16-bit
    // words, carries folded back in, then complemented. An odd-length
    // input's last byte is treated as a word with an implicit zero low
    // byte, same as every real IP/TCP/UDP checksum does.
    static def checksum(bytes) {
        return Ip.finishSum(Ip.partialSum(bytes, 0));
    }

    // the running 16-bit-word sum of 'bytes' on top of 'sum' (not yet folded or
    // complemented). Summing a message in pieces is the same as summing it
    // whole PROVIDED every piece but the last has an even length - then no
    // word straddles two pieces. TCP's checksum uses that to sum pseudo-header,
    // header and payload where they are, instead of copying them into one array.
    static def partialSum(bytes, sum) {
        return Ip.sumRange(bytes, 0, len(bytes), sum);
    }

    // the same over bytes[from .. to)
    static def sumRange(bytes, from, to, sum) {
        i = from;
        n = to;
        while (i < n) {
            word = bytes[i] * 256;
            if (i + 1 < n) { word = word + bytes[i + 1]; }
            sum = sum + word;
            i = i + 2;
        }
        return sum;
    }

    // carries folded back in, complemented
    static def finishSum(sum) {
        while (sum > 0xFFFF) {
            sum = (sum & 0xFFFF) + (sum >>> 16);
        }
        return (~sum) & 0xFFFF;
    }

    // true if bytes[0..20) is an IPv4 header whose checksum field is consistent:
    // summing a header that includes its own correct checksum gives all ones,
    // i.e. finishSum() == 0
    static def headerValid(bytes) {
        if (len(bytes) < 20) { return false; }
        if ((bytes[0] >>> 4) != 4) { return false; }
        return Ip.finishSum(Ip.sumRange(bytes, 0, 20, 0)) == 0;
    }

    // 'a.b.c.d' -> the 32-bit address, or nil if it is not a dotted quad
    // (four decimal parts, each 0-255, nothing else in the string)
    static def parseAddr(text) {
        n = len(text);
        value = 0;
        part = 0;
        digits = 0;
        parts = 0;
        i = 0;
        while (i < n) {
            c = int(text[i]);
            if (c >= 48 && c <= 57) {
                part = part * 10 + (c - 48);
                digits = digits + 1;
                if (part > 255 || digits > 3) { return nil; }
            } else {
                if (c != 46 || digits == 0) { return nil; }
                value = (value << 8) | part;
                part = 0;
                digits = 0;
                parts = parts + 1;
            }
            i = i + 1;
        }
        if (digits == 0 || parts != 3) { return nil; }
        return (value << 8) | part;
    }

    // the 32-bit address as 'a.b.c.d'
    static def formatAddr(addr) {
        return str(Ip.byteAt(addr, 24)) + '.' + str(Ip.byteAt(addr, 16)) + '.' + str(Ip.byteAt(addr, 8)) + '.' + str(Ip.byteAt(addr, 0));
    }

    // a string's characters as an array of byte values 0-255
    static def bytesOf(message) {
        result = [];
        i = 0;
        n = len(message);
        while (i < n) { push(result, int(message[i])); i = i + 1; }
        return result;
    }

    // builds a 20-byte header with the checksum field zeroed, computes the
    // real checksum over that, then patches it in - the standard two-pass
    // approach, since a checksum can't cover itself in one pass
    static def buildHeader(srcAddr, dstAddr, proto, payloadLen) {
        totalLen = 20 + payloadLen;
        h = [
            0x45, 0,
            Ip.byteAt(totalLen, 8), Ip.byteAt(totalLen, 0),
            0, 0,
            0, 0,
            64, proto,
            0, 0,
            Ip.byteAt(srcAddr, 24), Ip.byteAt(srcAddr, 16), Ip.byteAt(srcAddr, 8), Ip.byteAt(srcAddr, 0),
            Ip.byteAt(dstAddr, 24), Ip.byteAt(dstAddr, 16), Ip.byteAt(dstAddr, 8), Ip.byteAt(dstAddr, 0)
        ];
        cs = Ip.checksum(h);
        h[10] = Ip.byteAt(cs, 8);
        h[11] = Ip.byteAt(cs, 0);
        return h;
    }
}
Ip.protoIcmp = 1;
Ip.protoUdp = 17;
Ip.protoTcp = 6;

def class IpHeader {
    field srcAddr;
    field dstAddr;
    field proto;
    field payloadLen; // bytes AFTER the 20-byte header (totalLen - 20)

    static def parse(frame) {
        h = new IpHeader();
        h.srcAddr = Ip.u32From(frame, 12);
        h.dstAddr = Ip.u32From(frame, 16);
        h.proto = frame[9];
        h.payloadLen = Ip.u16From(frame, 2) - 20;
        return h;
    }
}
