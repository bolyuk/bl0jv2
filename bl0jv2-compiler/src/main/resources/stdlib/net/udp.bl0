import 'ip.bl0'; // brings in Ip.netByteToChar() too - see its own doc
import 'net.bl0';

// minimal UDP over the IP layer below: an 8-byte header (src port, dst
// port, length, checksum) plus a payload. The checksum field is always
// left at 0 - RFC768 explicitly allows this over IPv4 ("If the computed
// checksum is zero, it is transmitted as all ones... An all zero
// transmitted checksum means the transmitter generated no checksum"), and
// a real UDP checksum needs a pseudo-header (src/dst IP + protocol + UDP
// length prepended before checksumming) that buys nothing extra on a
// loopback link that can't corrupt data in the first place.
//
// message is a bl0jv2 STRING, not a byte array - the only rich text type
// this language has, so it's the natural payload type for callers, even
// though every header (and the frame itself) underneath is plain bytes.
//
// split into two classes, mirroring ip.bl0's own Ip/IpHeader split: Udp
// holds the protocol-level operations (send/receive/hasPacket - there's
// only ever "the one UDP layer", nothing to make an instance of), while
// UdpPacket is pure data plus its own parse-from-a-frame factory.

def class Udp {
    static def buildHeader(srcPort, dstPort, payloadLen) {
        udpLen = 8 + payloadLen;
        return [
            Ip.byteAt(srcPort, 8), Ip.byteAt(srcPort, 0),
            Ip.byteAt(dstPort, 8), Ip.byteAt(dstPort, 0),
            Ip.byteAt(udpLen, 8), Ip.byteAt(udpLen, 0),
            0, 0
        ];
    }

    // binary-safe: payload is an array of ints, each 0-255. Use this
    // instead of Udp.send() for anything that isn't plain text - a DNS
    // query (see dns.bl0) is the reason this exists: Udp.send()'s own
    // message string goes through Ip.netByteToChar() first, which only
    // round-trips printable ASCII plus \r/\n/\t/\0 (see its own doc) and
    // would silently corrupt most of a real binary protocol's bytes.
    static def sendBytes(srcIp, srcPort, dstIp, dstPort, payload) {
        udpHeader = Udp.buildHeader(srcPort, dstPort, len(payload));
        ipHeader = Ip.buildHeader(srcIp, dstIp, Ip.protoUdp, len(udpHeader) + len(payload));

        frame = Arr.appendAll(Arr.appendAll(ipHeader, udpHeader), payload);

        Nic.send(frame);
    }

    static def send(srcIp, srcPort, dstIp, dstPort, message) {
        Udp.sendBytes(srcIp, srcPort, dstIp, dstPort, Ip.bytesOf(message));
    }

    static field queue; // received datagrams (UdpPacket), oldest first
    static field lock;

    // Net.pump() calls this, under Net.pumpLock, for every UDP datagram
    static def handleFrame(ipHeader, frame) {
        if (len(frame) < 28) { return nil; }
        pkt = UdpPacket.parse(frame, ipHeader);
        lock(Udp.lock);
        push(Udp.queue, pkt);
        unlock(Udp.lock);
    }

    // true if a datagram is waiting. Pumps the NIC first, so a frame that has
    // arrived but not yet been sorted by protocol counts.
    static def hasPacket() {
        Net.pump();
        lock(Udp.lock);
        result = len(Udp.queue) > 0;
        unlock(Udp.lock);
        return result;
    }

    // blocks until a datagram for 'port' (any port if port < 0) arrives, or
    // timeoutMs passes (negative = forever); returns it, or nil on timeout.
    // Datagrams for other ports stay queued for whoever wants them. Sleeps on
    // Nic.rxEvent - generation read before the queue is scanned, so one that
    // lands in between is not slept through.
    static def recvWait(port, timeoutMs) {
        deadline = ticks() + timeoutMs;
        while (true) {
            gen = eventGen(Nic.rxEvent);
            Net.pump();
            pkt = Udp.take(port);
            if (pkt != nil) { return pkt; }
            if (timeoutMs < 0) {
                waitEvent(Nic.rxEvent, gen, -1);
            } else {
                remaining = deadline - ticks();
                if (remaining <= 0) { return nil; }
                waitEvent(Nic.rxEvent, gen, remaining);
            }
        }
    }

    // removes and returns the oldest queued datagram for 'port' (any if port < 0), or nil
    static def take(port) {
        lock(Udp.lock);
        found = nil;
        i = 0;
        while (found == nil && i < len(Udp.queue)) {
            if (port < 0 || Udp.queue[i].dstPort == port) { found = i; }
            i = i + 1;
        }
        result = nil;
        if (found != nil) {
            result = Udp.queue[found];
            rest = [];
            j = 0;
            while (j < len(Udp.queue)) {
                if (j != found) { push(rest, Udp.queue[j]); }
                j = j + 1;
            }
            Udp.queue = rest;
        }
        unlock(Udp.lock);
        return result;
    }
}
Udp.queue = [];
Udp.lock = newMutex();
Net.register(Ip.protoUdp, Udp.handleFrame);

def class UdpPacket {
    field srcIp;
    field srcPort;
    field dstIp;
    field dstPort;
    field message;      // string, via Ip.netByteToChar() - see receive()'s own doc on what this loses
    field payloadBytes; // array of ints, each 0-255 - lossless, use this for anything binary (DNS - see dns.bl0)

    // the oldest queued datagram, or nil if none is (pumps the NIC first).
    // Callers normally check Udp.hasPacket() first; Udp.recvWait() waits.
    static def receive() {
        Net.pump();
        return Udp.take(-1);
    }

    // builds a UdpPacket from a received frame. Fills in BOTH pkt.message
    // (lossy for anything outside Ip.netByteToChar()'s own range) and
    // pkt.payloadBytes (lossless) - see this class's own doc on which to
    // actually use.
    static def parse(frame, ipHeader) {

        srcPort = Ip.u16From(frame, 20);
        dstPort = Ip.u16From(frame, 22);
        udpLen = Ip.u16From(frame, 24);
        payloadLen = udpLen - 8;

        message = '';
        payloadBytes = [];
        i = 0;
        while (i < payloadLen) {
            b = frame[28 + i];
            push(payloadBytes, b);
            message = message + Ip.netByteToChar(b);
            i = i + 1;
        }

        pkt = new UdpPacket();
        pkt.srcIp = ipHeader.srcAddr;
        pkt.srcPort = srcPort;
        pkt.dstIp = ipHeader.dstAddr;
        pkt.dstPort = dstPort;
        pkt.message = message;
        pkt.payloadBytes = payloadBytes;
        return pkt;
    }
}
