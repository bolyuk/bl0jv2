import 'udp.bl0';
import '../str/split.bl0';

// DNS resolution as a REAL protocol (RFC1035) over the SAME udp.bl0 stack
// everything else in this project uses - not a magic host-side shortcut.
// A query goes out through Udp.sendBytes() (binary-safe - see its own doc
// on why plain Udp.send()'s string payload can't carry a real DNS packet's
// arbitrary bytes) exactly like any other UDP datagram; whatever answers
// arrives back through the ordinary UdpPacket.receive() path. The only
// thing special about this file is that it speaks the DNS wire format
// itself, in bl0jv2 - the SAME thing ip.bl0/udp.bl0/tcp.bl0 already do for
// their own protocols, not a new kind of shortcut.
//
// Reaching a real DNS server at all needs --bridge-outbound (the CLI's
// own flag - see UdpOutboundBridge's own doc): that's what lets
// Udp.send()/sendBytes() actually leave the machine, the same as
// TcpConn.connect() needs it to reach a real TCP peer.

def class Dns {
    static field myIp;
    static field myPort;
    static field serverIp; // 8.8.8.8 by default - Google Public DNS, picked for being about as stable/available as a public resolver gets; override this if your own network intercepts/blocks port 53 to a foreign resolver (see this project's own notes on that)
    static field nextId;

    // one length-prefixed label per '.'-separated part, terminated by a
    // zero length byte - e.g. 'a.b' -> [1]'a'[1]'b'[0]. No compression on
    // the way out (queries never need it - compression exists to shrink
    // RESPONSES, which can repeat the query name), see skipName() for the
    // read side.
    static def encodeName(hostname) {
        labels = Split.split(hostname, '.');
        result = [];
        i = 0;
        while (i < len(labels)) {
            label = labels[i];
            push(result, len(label));
            j = 0;
            while (j < len(label)) {
                push(result, int(label[j]));
                j = j + 1;
            }
            i = i + 1;
        }
        push(result, 0);
        return result;
    }

    static def buildQuery(hostname, id) {
        header = [
            Ip.byteAt(id, 8), Ip.byteAt(id, 0),
            0x01, 0x00, // flags: RD=1 (recursion desired), everything else 0
            0x00, 0x01, // QDCOUNT=1
            0x00, 0x00, // ANCOUNT=0
            0x00, 0x00, // NSCOUNT=0
            0x00, 0x00  // ARCOUNT=0
        ];
        qname = Dns.encodeName(hostname);

        packet = [];
        i = 0; while (i < len(header)) { push(packet, header[i]); i = i + 1; }
        i = 0; while (i < len(qname)) { push(packet, qname[i]); i = i + 1; }
        push(packet, 0x00); push(packet, 0x01); // QTYPE=1 (A)
        push(packet, 0x00); push(packet, 0x01); // QCLASS=1 (IN)
        return packet;
    }

    // returns the byte offset right after the name starting at 'offset' -
    // a name is either a chain of length-prefixed labels ending in a zero
    // byte (like encodeName() writes), or a COMPRESSION POINTER: a byte
    // with its top two bits set (>= 0xC0) followed by one more byte,
    // together giving a 14-bit offset elsewhere in the packet where the
    // real name lives. Real DNS servers use pointers constantly (RFC1035
    // 3.4) to avoid repeating the query name in every answer record - this
    // only needs to skip PAST a name, never follow where a pointer leads,
    // so a pointer is always exactly 2 bytes here regardless of what it
    // points at.
    static def skipName(bytes, offset) {
        i = offset;
        while (true) {
            b = bytes[i];
            if (b == 0) { return i + 1; }
            if ((b & 0xC0) == 0xC0) { return i + 2; }
            i = i + 1 + b;
        }
    }

    // walks the answer section looking for the first A record (type 1)
    // and returns its address in this project's own fake 32-bit format -
    // 0 if there isn't one (NXDOMAIN, only CNAMEs with no A record behind
    // them, truncated response, etc.). A real resolver would also follow a
    // CNAME chain across separate queries when the answer doesn't include
    // the A record directly - this doesn't, since every CNAME target this
    // stack has actually been tested against was accompanied by its own A
    // record in the SAME response, which real authoritative servers
    // commonly do.
    static def parseResponse(bytes) {
        ancount = (bytes[6] << 8) | bytes[7];
        pos = Dns.skipName(bytes, 12) + 4; // past the header + question section (QNAME + QTYPE + QCLASS)

        i = 0;
        while (i < ancount) {
            pos = Dns.skipName(bytes, pos);
            rtype = (bytes[pos] << 8) | bytes[pos + 1];
            rdlength = (bytes[pos + 8] << 8) | bytes[pos + 9];
            rdataStart = pos + 10;

            if (rtype == 1 && rdlength == 4) {
                return (bytes[rdataStart] << 24) | (bytes[rdataStart + 1] << 16)
                        | (bytes[rdataStart + 2] << 8) | bytes[rdataStart + 3];
            }

            pos = rdataStart + rdlength;
            i = i + 1;
        }
        return 0;
    }

    // resolves 'hostname' to this project's own fake 32-bit address format
    // - the SAME representation ip.bl0's own srcAddr/dstAddr fields use, so
    // the result can be passed straight into TcpConn.connect()/Udp.send()
    // as the destination address. Returns 0 on failure (NXDOMAIN, no A
    // record, or nothing answered within the wait bound) - 0.0.0.0 is not
    // a real routable address, so this doubles as the "resolution failed"
    // sentinel. Shares Udp.hasPacket()/UdpPacket.receive()'s one NIC queue
    // with anything else this bl0jv2 program is doing over UDP at the same
    // time (see this stack's own established "one shared wire" trade-off)
    // - a reply meant for a concurrent, unrelated UDP exchange could be
    // mistaken for this query's own answer if both are in flight together.
    //
    // Nic.send() loops a sent frame back to its own sender too, even with
    // a real bridge attached (see nic.bl0's own doc on why: it keeps every
    // single-process demo working the same way whether or not a bridge
    // happens to be attached) - meaning the query THIS method just sent
    // arrives back through UdpPacket.receive() exactly like a real answer
    // would, almost always before the real one does. The check below is
    // what any other outbound-UDP client code in this project needs too:
    // skip a packet whose source is literally ourselves before trusting it
    // as a reply.
    static def resolve(hostname) {
        id = Dns.nextId;
        Dns.nextId = Dns.nextId + 1;

        query = Dns.buildQuery(hostname, id);
        Udp.sendBytes(Dns.myIp, Dns.myPort, Dns.serverIp, 53, query);

        i = 0;
        while (i < 300) {
            i = i + 1;
            gen = eventGen(Nic.rxEvent);
            if (!Udp.hasPacket()) { waitEvent(Nic.rxEvent, gen, 20); continue; }

            pkt = UdpPacket.receive();
            if (pkt.srcIp == Dns.myIp && pkt.srcPort == Dns.myPort) { continue; }

            return Dns.parseResponse(pkt.payloadBytes);
        }
        return 0;
    }
}
Dns.myIp = 0x0A000001;
Dns.myPort = 53000;
Dns.serverIp = 0x08080808;
Dns.nextId = 1;
