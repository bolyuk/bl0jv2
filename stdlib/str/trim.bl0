import 'substr.bl0';

def isSpaceChar(c) {
    sp = ' ';
    tab = '\t';
    nl = '\n';
    cr = '\r';
    return c == sp[0] || c == tab[0] || c == nl[0] || c == cr[0];
}

def trim(s) {
    start = 0;
    end = len(s);
    while (start < end && isSpaceChar(s[start])) { start = start + 1; }
    while (end > start && isSpaceChar(s[end - 1])) { end = end - 1; }
    return substr(s, start, end);
}
