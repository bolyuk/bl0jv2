import 'nic.bl0';
import '../str/char.bl0';

// minimal IPv4-shaped header: fixed 20 bytes, no options, no fragmentation
// (identification/flags/fragment-offset are always 0). Real enough to
// practice header packing and a real checksum, not a full RFC791
// implementation - this is a toy stack over a loopback device that can't
// corrupt or reorder anything, not a real routable IP implementation.
//
// layout (byte offsets):
//   0      version_ihl    always 0x45 (version 4, 5 x 32-bit words = 20 bytes)
//   1      tos            always 0
//   2-3    total length   header + payload, big-endian u16
//   4-5    identification always 0 (no fragmentation support)
//   6-7    flags+fragOff  always 0
//   8      ttl            always 64
//   9      protocol       17 = UDP (the only one this stack builds)
//   10-11  header checksum
//   12-15  source address, big-endian u32
//   16-19  destination address, big-endian u32
def class Ip {
    static field protoUdp;
    static field protoTcp;
}
Ip.protoUdp = 17;
Ip.protoTcp = 6;

// one byte out of v, 'shift' bits up from the bottom - the one primitive
// every header-packing/parsing function below is built from
def byteAt(v, shift) {
    return (v >>> shift) & 0xFF;
}

def u16From(bytes, offset) {
    return (bytes[offset] << 8) | bytes[offset + 1];
}

def u32From(bytes, offset) {
    return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3];
}

// byte -> single-char string for reconstructing a payload - NOT the same
// job stdlib/str/char.bl0's char() does. That one is for rendering a
// keystroke on a console: anything outside printable ASCII has no
// drawable glyph, so it maps to '?' on purpose. A network payload has no
// such luxury - HTTP's own '\r\n\r\n' framing (see http.bl0) needs \r/\n
// to survive a round trip through here INTACT, not collapse to '?' and
// silently break every request/response boundary. So this preserves \r,
// \n, \t and \0 as themselves before falling back to char()'s printable-
// range handling for everything else. It's still not a lossless 0-255
// round trip in general: bl0jv2's lexer only recognizes a small fixed set
// of \-escapes (see Bl0jv2_Lexer's own unescape()), so a string literal
// naming most OTHER control bytes can't be written in this language at
// all - covering the specific bytes this stack's own framing actually
// uses is as far as that limitation lets this go.
def netByteToChar(b) {
    if (b == 13) { return '\r'; }
    if (b == 10) { return '\n'; }
    if (b == 9) { return '\t'; }
    if (b == 0) { return '\0'; }
    return char(b);
}

// standard Internet checksum (RFC1071): ones'-complement sum of 16-bit
// words, carries folded back in, then complemented. An odd-length input's
// last byte is treated as a word with an implicit zero low byte, same as
// every real IP/TCP/UDP checksum does.
def ipChecksum(bytes) {
    sum = 0;
    i = 0;
    while (i < len(bytes)) {
        word = bytes[i] * 256;
        if (i + 1 < len(bytes)) { word = word + bytes[i + 1]; }
        sum = sum + word;
        i = i + 2;
    }
    while (sum > 0xFFFF) {
        sum = (sum & 0xFFFF) + (sum >>> 16);
    }
    return (~sum) & 0xFFFF;
}

// builds a 20-byte header with the checksum field zeroed, computes the
// real checksum over that, then patches it in - the standard two-pass
// approach, since a checksum can't cover itself in one pass
def ipBuildHeader(srcAddr, dstAddr, proto, payloadLen) {
    totalLen = 20 + payloadLen;
    h = [
        0x45, 0,
        byteAt(totalLen, 8), byteAt(totalLen, 0),
        0, 0,
        0, 0,
        64, proto,
        0, 0,
        byteAt(srcAddr, 24), byteAt(srcAddr, 16), byteAt(srcAddr, 8), byteAt(srcAddr, 0),
        byteAt(dstAddr, 24), byteAt(dstAddr, 16), byteAt(dstAddr, 8), byteAt(dstAddr, 0)
    ];
    cs = ipChecksum(h);
    h[10] = byteAt(cs, 8);
    h[11] = byteAt(cs, 0);
    return h;
}

def class IpHeader {
    field srcAddr;
    field dstAddr;
    field proto;
    field payloadLen; // bytes AFTER the 20-byte header (totalLen - 20)
}

def ipParseHeader(frame) {
    h = new IpHeader();
    h.srcAddr = u32From(frame, 12);
    h.dstAddr = u32From(frame, 16);
    h.proto = frame[9];
    h.payloadLen = u16From(frame, 2) - 20;
    return h;
}
