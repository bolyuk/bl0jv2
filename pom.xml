<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>bl0jv2</groupId>
    <artifactId>bl0jv2-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>bl0jv2-common</module>
        <module>bl0jv2-runtime</module>
        <module>bl0jv2-compiler</module>
        <module>bl0jv2-cli</module>
        <module>bl0jv2-ide</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <junit.version>5.11.3</junit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>bl0jv2</groupId>
                <artifactId>bl0jv2-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>bl0jv2</groupId>
                <artifactId>bl0jv2-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>bl0jv2</groupId>
                <artifactId>bl0jv2-compiler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- bl0jv2-cli's own tests (Bl0jv2_StdlibTest, TcpOutboundBridgeTest)
                             resolve stdlib/ scripts as "stdlib/..." relative to the process's
                             working directory, same as the CLI itself does at runtime - stdlib/
                             lives at the repo root, not inside any one module, so every module's
                             tests run with that as their cwd (matching the pre-split single-module
                             behavior, where basedir was already the repo root) -->
                        <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <url>https://maven.bolyuk.org/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <url>https://maven.bolyuk.org/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
