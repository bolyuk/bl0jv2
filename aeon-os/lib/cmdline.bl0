// aeon-os: parsing a command line - words with quoting, pipes and redirections.
//
//   ls "my folder" | grep txt > found.txt        a pipeline of stages
//   Cmdline.parse(line)  ->  array of Stage, one per command (empty for an empty line)
//
// Quoting: 'single' is literal; "double" understands \" \\ \n (newline) \t (tab);
// outside quotes a backslash makes the next character literal, so \| or \  are
// ordinary characters. Operators (| > >> <) need no spaces around them; inside
// quotes they are text. A Stage has words (the command is words[0]) and
// optionally inFile (< file), outFile (> file or >> file) and append (true for >>). A trailing '&' runs
// the whole line in the background: the last Stage has background = true.
// Syntax errors are thrown as "syntax error: ...".
//
// Variables: Cmdline.expand(line, lookup) replaces $NAME and ${NAME} (letters, digits, _) by what
// lookup(name) returns (nil is an empty text) - everywhere except inside 'single quotes' and after a
// backslash. It works on the line before it is split, so a value is parsed like typed text. A $ that
// is not followed by a name stays as it is. $? $# $* are names of one character.
//
// Cmdline.splitList(line) cuts a line at ; && || (outside quotes) into [[operator, text], ...]: ; always runs the
// part, && when the one before it succeeded, || when it failed (see runCommand in shell.bl0).

import 'arith.bl0';

def class Stage {
    field words;
    field globs;        // for each word: true when it holds a * or ? outside quotes (see lib/glob.bl0)
    field inFile;
    field outFile;
    field append;
    field background;

    def init() {
        this.words = [];
        this.globs = [];
        this.inFile = nil;
        this.outFile = nil;
        this.append = false;
        this.background = false;
    }
}

def class Cmdline {
    // [[isOperator, text, hasPattern], ...]
    static def tokenize(line) {
        tokens = [];
        n = len(line);
        word = '';
        inWord = false;
        globby = false;      // the word holds a * or ? outside quotes
        i = 0;
        while (i < n) {
            c = strSub(line, i, i + 1);
            if (c == ' ' || c == '\t') {
                if (inWord) { push(tokens, [false, word, globby]); word = ''; inWord = false; globby = false; }
                i += 1;
            } else if (c == '|' || c == '<' || c == '>' || c == '&') {
                if (inWord) { push(tokens, [false, word, globby]); word = ''; inWord = false; globby = false; }
                op = c;
                if (c == '>' && i + 1 < n && strSub(line, i + 1, i + 2) == '>') { op = '>>'; i += 1; }
                push(tokens, [true, op]);
                i += 1;
            } else if (c == "'") {
                inWord = true;
                close = strFind(line, "'", i + 1);
                if (close < 0) { throw('syntax error: unterminated quote'); }
                word = word + strSub(line, i + 1, close);
                i = close + 1;
            } else if (c == '"') {
                inWord = true;
                i += 1;
                closed = false;
                while (i < n && !closed) {
                    d = strSub(line, i, i + 1);
                    if (d == '"') {
                        closed = true;
                    } else if (d == '\\' && i + 1 < n) {
                        e = strSub(line, i + 1, i + 2);
                        if (e == 'n') { word = word + strChar(10); }
                        else if (e == 't') { word = word + strChar(9); }
                        else if (e == '"' || e == '\\') { word = word + e; }
                        else { word = word + d + e; }
                        i += 1;
                    } else {
                        word = word + d;
                    }
                    i += 1;
                }
                if (!closed) { throw('syntax error: unterminated quote'); }
            } else if (c == '\\') {
                if (i + 1 >= n) { throw('syntax error: a line cannot end with a backslash'); }
                inWord = true;
                word = word + strSub(line, i + 1, i + 2);
                i += 2;
            } else {
                inWord = true;
                if (c == '*' || c == '?') { globby = true; }
                word = word + c;
                i += 1;
            }
        }
        if (inWord) { push(tokens, [false, word, globby]); }
        return tokens;
    }

    // the line cut at ; && || outside quotes: [[operator, text], ...]; the operator says how the part follows the one
    // before it (the first is ';'). Empty parts are left out: 'a;; b' is two.
    static def splitList(line) {
        parts = [];
        op = ';';
        start = 0;
        n = len(line);
        i = 0;
        while (i < n) {
            c = strSub(line, i, i + 1);
            if (c == "'") {
                close = strFind(line, "'", i + 1);
                i = close < 0 ? n : close + 1;
            } else if (c == '"') {
                i += 1;
                while (i < n && strSub(line, i, i + 1) != '"') {
                    if (strSub(line, i, i + 1) == '\\') { i += 1; }
                    i += 1;
                }
                i += 1;
            } else if (c == '\\') {
                i += 2;
            } else if (c == '$' && i + 1 < n && strSub(line, i + 1, i + 2) == '(') {
                close = Cmdline.closingParen(line, i + 2);      // what is inside $( ) is for the substitution to cut
                i = close < 0 ? n : close + 1;
            } else if (c == ';' || (c == '&' && i + 1 < n && strSub(line, i + 1, i + 2) == '&')
                    || (c == '|' && i + 1 < n && strSub(line, i + 1, i + 2) == '|')) {
                text = strSub(line, start, i);
                if (Cmdline.hasText(text)) { push(parts, [op, text]); }
                op = c == ';' ? ';' : c + c;
                i += c == ';' ? 1 : 2;
                start = i;
            } else {
                i += 1;
            }
        }
        text = strSub(line, start, n);
        if (Cmdline.hasText(text)) { push(parts, [op, text]); }
        return parts;
    }

    // the first word of a line (up to a space), '' for an empty line
    static def firstWord(line) {
        t = line;
        i = 0;
        while (i < len(t) && (strSub(t, i, i + 1) == ' ' || strSub(t, i, i + 1) == '\t')) { i += 1; }
        j = i;
        while (j < len(t) && strSub(t, j, j + 1) != ' ' && strSub(t, j, j + 1) != '\t') { j += 1; }
        return strSub(t, i, j);
    }

    // NAME=value as the whole line, the value being one word (spaces only inside quotes or $( )): [name, value text];
    // nil when the line is anything else
    static def singleAssignment(line) {
        eq = strFind(line, '=', 0);
        if (eq < 1) { return nil; }
        j = 0;
        while (j < eq) {
            c = strSub(line, j, j + 1);
            if (!Cmdline.isNameChar(c) || (j == 0 && strFind('0123456789', c, 0) >= 0)) { return nil; }
            j += 1;
        }
        n = len(line);
        i = eq + 1;
        while (i < n) {
            c = strSub(line, i, i + 1);
            if (c == "'") {
                close = strFind(line, "'", i + 1);
                if (close < 0) { return nil; }
                i = close + 1;
            } else if (c == '"') {
                i += 1;
                while (i < n && strSub(line, i, i + 1) != '"') {
                    if (strSub(line, i, i + 1) == '\\') { i += 1; }
                    i += 1;
                }
                i += 1;
            } else if (c == '$' && i + 1 < n && strSub(line, i + 1, i + 2) == '(') {
                close = Cmdline.closingParen(line, i + 2);
                if (close < 0) { return nil; }
                i = close + 1;
            } else if (c == ' ' || c == '\t' || c == '|' || c == '<' || c == '>' || c == '&') {
                return nil;
            } else if (c == '\\') {
                i += 2;
            } else {
                i += 1;
            }
        }
        return [strSub(line, 0, eq), strSub(line, eq + 1, n)];
    }

    static def hasText(text) {
        i = 0;
        while (i < len(text)) {
            c = strSub(text, i, i + 1);
            if (c != ' ' && c != '\t') { return true; }
            i += 1;
        }
        return false;
    }

    static def isNameChar(c) {
        return strFind('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_', c, 0) >= 0;
    }

    // the position of the ) that closes a ( whose text starts at 'from' (quotes inside are text); -1 when there is none
    static def closingParen(line, from) {
        depth = 1;
        i = from;
        n = len(line);
        while (i < n) {
            c = strSub(line, i, i + 1);
            if (c == "'") {
                close = strFind(line, "'", i + 1);
                if (close < 0) { return -1; }
                i = close;
            } else if (c == '"') {
                i += 1;
                while (i < n && strSub(line, i, i + 1) != '"') {
                    if (strSub(line, i, i + 1) == '\\') { i += 1; }
                    i += 1;
                }
            } else if (c == '(') {
                depth += 1;
            } else if (c == ')') {
                depth -= 1;
                if (depth == 0) { return i; }
            }
            i += 1;
        }
        return -1;
    }

    // $(command) is what the command prints (subst(text) says it); $((sum)) is a number (see lib/arith.bl0)
    static def expand(line, lookup, subst) {
        out = '';
        n = len(line);
        i = 0;
        while (i < n) {
            c = strSub(line, i, i + 1);
            if (c == "'") {
                close = strFind(line, "'", i + 1);
                if (close < 0) { return out + strSub(line, i, n); }      // the tokenizer reports it
                out = out + strSub(line, i, close + 1);
                i = close + 1;
            } else if (c == '\\' && i + 1 < n) {
                out = out + strSub(line, i, i + 2);
                i += 2;
            } else if (c == '$') {
                name = '';
                next = i + 1;
                paren = i + 1 < n && strSub(line, i + 1, i + 2) == '(';
                end = paren ? Cmdline.closingParen(line, i + 2) : -1;
                if (paren && end < 0) { throw('syntax error: unterminated $('); }
                if (paren && end > i + 3 && strSub(line, i + 2, i + 3) == '(' && strSub(line, end - 1, end) == ')') {
                    inner = Cmdline.expand(strSub(line, i + 3, end - 1), lookup, subst);
                    out = out + Arith.eval(inner, lookup);
                    next = end + 1;
                    name = nil;
                } else if (paren && subst != nil) {
                    out = out + subst(strSub(line, i + 2, end));
                    next = end + 1;
                    name = nil;
                } else if (i + 1 < n && strFind('?#*', strSub(line, i + 1, i + 2), 0) >= 0) {
                    name = strSub(line, i + 1, i + 2);       // $? the last status, $# the number of arguments, $* all of them
                    next = i + 2;
                } else if (i + 1 < n && strSub(line, i + 1, i + 2) == '{') {
                    close = strFind(line, '}', i + 2);
                    if (close < 0) { throw('syntax error: unterminated ${'); }
                    name = strSub(line, i + 2, close);
                    next = close + 1;
                } else {
                    j = i + 1;
                    while (j < n && Cmdline.isNameChar(strSub(line, j, j + 1))) { j += 1; }
                    name = strSub(line, i + 1, j);
                    next = j;
                }
                if (name == nil) {
                    // done above
                } else if (name == '') {
                    out = out + '$';
                    next = i + 1;
                } else {
                    v = lookup(name);
                    if (v != nil) { out = out + v; }
                }
                i = next;
            } else {
                out = out + c;
                i += 1;
            }
        }
        return out;
    }

    static def parse(line) {
        tokens = Cmdline.tokenize(line);
        stages = [];
        cur = new Stage();
        background = false;
        i = 0;
        while (i < len(tokens)) {
            t = tokens[i];
            if (!t[0]) {
                push(cur.words, t[1]);
                push(cur.globs, t[2]);
            } else if (t[1] == '&') {
                if (i + 1 < len(tokens)) { throw('syntax error: & must end the line'); }
                background = true;
            } else if (t[1] == '|') {
                if (len(cur.words) == 0) { throw('syntax error: nothing before |'); }
                if (cur.outFile != nil) { throw('syntax error: a redirected output cannot be piped on'); }
                push(stages, cur);
                cur = new Stage();
            } else {
                if (i + 1 >= len(tokens) || tokens[i + 1][0]) { throw('syntax error: ' + t[1] + ' needs a file name'); }
                target = tokens[i + 1][1];
                if (t[1] == '<') {
                    if (len(stages) > 0) { throw('syntax error: only the first command can read from a file'); }
                    cur.inFile = target;
                } else {
                    cur.outFile = target;
                    cur.append = t[1] == '>>';
                }
                i += 1;
            }
            i += 1;
        }
        if (len(cur.words) == 0) {
            if (len(stages) > 0) { throw('syntax error: nothing after |'); }
            if (cur.inFile != nil || cur.outFile != nil) { throw('syntax error: a redirection needs a command'); }
            if (background) { throw('syntax error: nothing to run in the background'); }
            return stages;
        }
        cur.background = background;
        push(stages, cur);
        return stages;
    }
}
