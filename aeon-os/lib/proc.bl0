// aeon-os: processes. A process is a program running on a core of its own: the shell starts one
// with 'command &' (or as a stage of a pipeline), the starter picks a worker core that is free,
// prepares that core's Ctx (command line, folder, redirections, pipes) and dispatches the job to
// it; the job loads the program from the disk, runs it in user mode, records how it ended and
// frees the core. There is no time-slicing - a core runs one job at a time to its end - so the number
// of processes at once is the number of worker cores (the VM's -n option minus the one the shell
// itself runs on).
//
// Everything about a process is in the Process table, which any program can read (ps) and add a stop
// request to (kill): a request, because a program stops only at a checkpoint (see kernel.bl0's
// checkAbort).

import '../kernel.bl0';
import 'loader.bl0';
import '../../stdlib/arrlib.bl0';
import 'userland.bl0';
import 'mem.bl0';
import 'limits.bl0';

def class Process {
    field pid;
    field name;
    field path;
    field core;
    field state;       // 'running', 'done', 'failed' (an error ended it) or 'killed'
    field message;     // what ended it, when it did not simply finish
    field started;
    field ended;
    field reported;    // the shell has told the user it ended
    field background;
    field uid;         // who it runs for
    field quiet;       // a job started by crond: no notice on the terminal when it ends, a line in the log instead
    field system;      // the shell: listed by ps, but not something to wait for or stop
    field account;     // the memory account it is charged to (see lib/mem.bl0)
    field memory;      // how much it held when it ended

    def init(pid, name, path, core) {
        this.pid = pid;
        this.name = name;
        this.path = path;
        this.core = core;
        this.state = 'running';
        this.message = '';
        this.started = ticks();
        this.ended = 0;
        this.reported = false;
        this.background = false;
        this.system = false;
        this.quiet = false;
        this.uid = 0;
        this.account = 0;
        this.memory = 0;
    }
}

def class Proc {
    static field table;
    static field nextPid;
    static field mutex;
    static field changed;    // signalled whenever a process ends
    static field busy;       // per core: running a job

    // privileged, once, after Ctx and the abort words exist
    static def init() {
        // the shell is a process too: pid 1, on core 0, running as long as the machine is
        shell = new Process(1, 'shell', '', 0);
        shell.system = true;
        Proc.table = [shell];
        Proc.nextPid = 2;
        Proc.mutex = newMutex();
        Proc.changed = newEvent();
        Proc.busy = [];
        i = 0;
        while (i < coreCount()) {
            push(Proc.busy, false);
            i += 1;
        }
    }

    static def workers() {
        return coreCount() - 1;
    }

    // number of worker cores with no job
    static def freeCores() {
        n = 0;
        i = 1;
        while (i < coreCount()) {
            if (!Proc.busy[i]) { n += 1; }
            i += 1;
        }
        return n;
    }

    static def find(pid) {
        i = 0;
        while (i < len(Proc.table)) {
            if (Proc.table[i].pid == pid) { return Proc.table[i]; }
            i += 1;
        }
        return nil;
    }

    // Starts 'path' with 'words' as its command line on a free worker core, and returns the Process.
    // Privileged (it dispatches): the shell calls it through a syscall. 'io' is [inPath, outPath, pipeIn,
    // pipeOut, background] or [..., background, quiet]. 'who' - [uid, gid, groups] - is who it runs for when the
    // caller is root; in every other case it runs for the caller.
    static def spawn(path, words, cwd, io, who) {
        // whose process it will be: the caller, or whoever root says
        parent = Ctx.me();
        uid = parent.uid;
        if (who != nil && parent.uid == 0) { uid = who[0]; }
        allowed = Limits.of(uid)[1];
        if (allowed > 0 && Proc.countOf(uid) >= allowed) {
            throw('too many processes: ' + Limits.nameOf(uid) + ' may have ' + allowed + ' running at once (etc/limits)');
        }
        lock(Proc.mutex);
        core = -1;
        i = 1;
        while (i < coreCount() && core < 0) {
            if (!Proc.busy[i]) { core = i; }
            i += 1;
        }
        if (core < 0) {
            unlock(Proc.mutex);
            throw('no free core to run it on (the machine has ' + coreCount() + '; -n sets that)');
        }
        Proc.busy[core] = true;
        pid = Proc.nextPid;
        Proc.nextPid += 1;
        p = new Process(pid, words[0], path, core);
        p.background = io[4];
        p.quiet = len(io) > 5 && io[5];
        push(Proc.table, p);
        unlock(Proc.mutex);
        Proc.trim();
        c = Ctx.table[core];
        c.reset();
        parent = Ctx.me();                 // the job runs for whoever started it
        c.uid = parent.uid;
        c.gid = parent.gid;
        c.groups = parent.groups;
        if (who != nil && parent.uid == 0) {
            c.uid = who[0];
            c.gid = who[1];
            c.groups = who[2];
        }
        p.uid = c.uid;
        c.words = words;
        c.cwd = cwd;
        c.inPath = io[0];
        c.outPath = io[1];
        c.pipeIn = io[2];
        c.pipeOut = io[3];
        c.background = io[4];
        c.pid = pid;
        poke32(Abort.base + 4 * core, 0);
        abortSetForegroundJob(core, !io[4]);
        dispatch(procEntry, core, pid);
        return p;
    }

    // how many processes of a user are running (the shell is not counted)
    static def countOf(uid) {
        n = 0;
        i = 0;
        while (i < len(Proc.table)) {
            p = Proc.table[i];
            if (p.state == 'running' && !p.system && p.uid == uid) { n += 1; }
            i += 1;
        }
        return n;
    }

    // drops the oldest finished processes beyond 32
    static def trim() {
        lock(Proc.mutex);
        finished = 0;
        i = 0;
        while (i < len(Proc.table)) {
            if (Proc.table[i].state != 'running') { finished += 1; }
            i += 1;
        }
        i = 0;
        while (finished > 32 && i < len(Proc.table)) {
            if (Proc.table[i].state != 'running') {
                Proc.table = Arr.concat(Arr.slice(Proc.table, 0, i), Arr.slice(Proc.table, i + 1, len(Proc.table)));
                finished -= 1;
            } else {
                i += 1;
            }
        }
        unlock(Proc.mutex);
    }

    static def finish(p, state, message) {
        lock(Proc.mutex);
        p.state = state;
        p.message = message;
        p.ended = ticks();
        Proc.busy[p.core] = false;
        abortSetForegroundJob(p.core, false);
        unlock(Proc.mutex);
        signalEvent(Proc.changed);
        if (p.background) {
            text = '[' + p.pid + '] ' + p.name + ' ';
            if (state == 'done') { text = text + 'done'; }
            else if (state == 'killed') { text = text + 'killed'; }
            else { text = text + 'failed: ' + message; }
            p.reported = true;
            if (p.quiet) {
                // a job nobody is watching: the log is where it says how it went
                Log.write('job ' + text);
            } else {
                // tell the user, without breaking into what they are typing
                consoleAsync(text + '\n');
            }
        }
    }

    // asks the process to stop; true if there was a running process of that number
    static def kill(pid) {
        p = Proc.find(pid);
        if (p == nil || p.state != 'running' || p.system) { return false; }
        abortRequest(p.core);
        return true;
    }

    // sleeps until process 'pid' is no longer running (all of them when pid is 0)
    static def waitFor(pid) {
        while (true) {
            gen = eventGen(Proc.changed);
            if (!Proc.anyRunning(pid)) { return nil; }
            checkAbort();
            waitEvent(Proc.changed, gen, 200);
        }
    }

    static def anyRunning(pid) {
        i = 0;
        while (i < len(Proc.table)) {
            p = Proc.table[i];
            if (p.state == 'running' && !p.system && (pid == 0 || p.pid == pid)) { return true; }
            i += 1;
        }
        return false;
    }
}

// the job on a worker core (dispatched by Proc.spawn): runs the program to its end and records how it ended
def procEntry(pid) {
    p = Proc.find(pid);
    c = Ctx.table[currentCore()];
    state = 'done';
    message = '';
    p.account = Mem.accountOf(pid);
    Mem.begin(p.account, Limits.of(p.uid)[0]);
    try {
        loadAndRun(p.path, 0);
    } catch (e) {
        text = programError(str(e));
        if (text == 'interrupted') {
            state = 'killed';
        } else {
            state = 'failed';
            message = text;
        }
    }
    p.memory = Mem.end(p.account);
    c.finish();
    Proc.finish(p, state, message);
}
