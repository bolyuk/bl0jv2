// aeon-os: what a program started from the disk needs. Importing this gives a
// program the console, the filesystem (folders and paths included) and its
// environment; startProgram() connects them to the kernel's disk driver, which
// is the one thing a separately loaded program cannot have set up itself.
//
// A program is a plain .bl0 file:
//
//   import '../lib/userland.bl0';
//   startProgram();
//   ... Prog.words[0] is the command name, Prog.words[1..] its arguments ...
//
// compiled and put on the disk as bin/<name>.bl0c (see aeon-os/README or
// --disk-put). It runs unprivileged and everything it does to the machine goes
// through syscalls the kernel offers. When it returns, the shell is back.

import '../kernel.bl0';
import 'pipe.bl0';
import 'term.bl0';
import '../../stdlib/fs/dirs.bl0';
import '../../stdlib/str/split.bl0';
import '../../stdlib/str/fmt.bl0';
import '../../stdlib/arrlib.bl0';
import '../../stdlib/fs/hostfs.bl0';

// What a program knows about the job it is part of - one per core, because programs may run on
// several cores at once: its command line (words[0] is the command), the folder it started in, where
// its standard input and output go (a file path, a pipe, or the terminal when both are empty), the
// text it has queued for a file, and the number of the process it is. The shell (or the process
// starter, for a program on another core) fills it in before the program starts; the shared libraries
// make this the same table for everyone.
def class Ctx {
    static field table;

    field words;
    field cwd;
    field inPath;
    field outPath;
    field pipeIn;
    field pipeOut;
    field buffer;
    field size;
    field pid;
    field background;     // no terminal: reading standard input gives nothing
    field uid;            // who the job runs for (see lib/perm.bl0); the kernel sets these
    field gid;            // the primary group
    field groups;         // every group (numbers), the primary first
    field stack;          // the identities su has switched away from, newest last

    def init() {
        this.words = [];
        this.cwd = '';
        this.inPath = '';
        this.outPath = '';
        this.pipeIn = nil;
        this.pipeOut = nil;
        this.buffer = [];
        this.size = 0;
        this.pid = 0;
        this.background = false;
        this.uid = 0;
        this.gid = 0;
        this.groups = [0];
        this.stack = [];
    }

    // the context of the core running this code
    static def me() {
        if (Ctx.table == nil) { Ctx.setup(coreCount()); }
        return Ctx.table[currentCore()];
    }

    static def setup(cores) {
        table = [];
        i = 0;
        while (i < cores) {
            push(table, new Ctx());
            i += 1;
        }
        Ctx.table = table;
    }

    // start afresh for a new job
    def reset() {
        this.inPath = '';
        this.outPath = '';
        this.pipeIn = nil;
        this.pipeOut = nil;
        this.buffer = [];
        this.size = 0;
        this.background = false;
    }

    // what was queued for a file goes to it
    def flush() {
        if (len(this.buffer) == 0) { return nil; }
        text = strJoin(this.buffer, '');
        this.buffer = [];
        this.size = 0;
        Fs.append(this.outPath, text);
    }

    // the job's output is complete: queued file text is written, and the ends of its pipes close so
    // the other side sees the end
    def finish() {
        try {
            this.flush();
        } catch (e) {
            // the file could not be written (no permission, no space): say so, the job is over anyway
            sayErr(str(e));
        }
        if (this.pipeOut != nil) { this.pipeOut.closeWrite(); }
        if (this.pipeIn != nil) { this.pipeIn.closeRead(); }
    }
}

// the words of a command line, without the empty pieces repeated spaces leave
def tokens(text) {
    raw = Split.split(text, ' ');
    words = [];
    i = 0;
    while (i < len(raw)) {
        if (raw[i] != '') { push(words, raw[i]); }
        i += 1;
    }
    return words;
}

// everything from word 'from' on, joined with single spaces
def restOf(words, from) {
    return Arr.join(Arr.slice(words, from, len(words)), ' ');
}

// a non-negative whole number written in decimal (up to nine digits), or nil
def unsignedNumber(text) {
    n = 0;
    i = 0;
    if (len(text) == 0 || len(text) > 9) { return nil; }
    while (i < len(text)) {
        c = int(text[i]);
        if (c < 48 || c > 57) { return nil; }
        n = n * 10 + (c - 48);
        i += 1;
    }
    return n;
}

def portNumber(text) {
    n = 0;
    i = 0;
    if (len(text) == 0 || len(text) > 5) { return nil; }
    while (i < len(text)) {
        c = int(text[i]);
        if (c < 48 || c > 57) { return nil; }
        n = n * 10 + (c - 48);
        i += 1;
    }
    if (n < 1 || n > 65535) { return nil; }
    return n;
}

// text to standard output, one line at a time
def printText(text) {
    lines = Split.split(text, strChar(10));
    i = 0;
    last = len(lines);
    if (last > 0 && lines[last - 1] == '') { last -= 1; }
    while (i < last) {
        line = lines[i];
        if (len(line) > 0 && strSub(line, len(line) - 1, len(line)) == strChar(13)) { line = strSub(line, 0, len(line) - 1); }
        say(line);
        i += 1;
    }
}

def isSpace(c) {
    return c == ' ' || c == strChar(10) || c == strChar(13) || c == strChar(9);
}

// --- standard input and output ---
//
// A program writes with say() and reads with inputText(); where that goes is the
// shell's business: the terminal, or a file when the command line redirected or
// piped it (the shell sets that in the Ctx of the core the program runs on). Output to a file is
// collected and appended in blocks. Messages that are about the command itself -
// usage, "no such file" - go to sayErr(), which is always the terminal, so that a
// pipe carries only data.

def sayRaw(text) {
    checkAbort();
    c = Ctx.me();
    if (c.pipeOut != nil) {
        c.pipeOut.put(text);
        return nil;
    }
    if (c.outPath == '') {
        if (c.background) { consoleAsync(text); } else { consoleWrite(text); }
        return nil;
    }
    push(c.buffer, text);
    c.size += len(text);
    if (c.size > 2048) { c.flush(); }
}

def say(text) {
    sayRaw(text + '\n');
}

// is the output going to the terminal (so colours are for a person), not into a pipe or a file
def toTerminal() {
    c = Ctx.me();
    return c.pipeOut == nil && c.outPath == '';
}

// 'text' in colour n (see Term.colour) - plain when the output is a pipe or a file, so data stays data
def paint(n, text) {
    if (!toTerminal()) { return text; }
    return Term.paint(n, text);
}

def paintBold(n, text) {
    if (!toTerminal()) { return text; }
    return Term.paintBold(n, text);
}

def sayErr(text) {
    text = Term.paint(1, text);
    if (Ctx.me().background) {
        consoleAsync(text + '\n');
    } else {
        consoleWriteLine(text);
    }
}

// a path as typed -> the stored name, relative to the folder the shell was in
def inCwd(path) {
    return FsPath.resolve(Ctx.me().cwd, path);
}

// a destination for cp/mv: an existing folder means "inside it"
def destination(from, to) {
    target = inCwd(to);
    if (Dirs.isDir(target)) { target = FsPath.prefix(target) + FsPath.base(from); }
    return target;
}

// everything below a folder, however deep: array of [name, size] - names in full, a folder's own marker
// ('docs/') included. 'dir' is a stored name ('' = the root).
def allUnder(dir) {
    return Fs.list(FsPath.prefix(dir));
}

// makes a folder (and the ones above it) unless it exists
def ensureDir(path) {
    if (path == '' || Dirs.isDir(path)) { return nil; }
    ensureDir(FsPath.parent(path));
    Dirs.mkdir(path);
}

// true when 'path' (a stored name) is the folder a drive is mounted on
def isMountPoint(path) {
    mounts = Fs.mountList();
    i = 0;
    while (i < len(mounts)) {
        if (mounts[i][0] == path) { return true; }
        i += 1;
    }
    return false;
}

// removes a file, or a folder with everything in it; false when there is nothing of that name
def removeTree(path) {
    if (Fs.exists(path)) { return Fs.remove(path); }
    if (!Dirs.isDir(path)) { return false; }
    entries = allUnder(path);
    i = 0;
    while (i < len(entries)) {
        Fs.remove(entries[i][0]);
        i += 1;
    }
    return true;
}

// copies a folder's contents to 'to' (a stored name that does not exist yet as a file); returns how many
// files were copied
def copyTree(from, to) {
    entries = allUnder(from);
    prefix = FsPath.prefix(from);
    target = FsPath.prefix(to);
    copied = 0;
    ensureDir(to);
    i = 0;
    while (i < len(entries)) {
        name = entries[i][0];
        rest = strSub(name, len(prefix), len(name));
        if (rest == '') {
            // the marker of 'from' itself
        } else if (strSub(rest, len(rest) - 1, len(rest)) == '/') {
            ensureDir(strSub(target + rest, 0, len(target + rest) - 1));
        } else {
            data = Fs.readData(name);
            Fs.writeData(target + rest, data);
            free(data);
            copied += 1;
        }
        i += 1;
    }
    return copied;
}

// call first thing in a program; false (after saying why) when there is no filesystem to use.
// The shell has put the command line, the working folder and the redirections in this core's Ctx:
// everything here is a shared library, so that is the same table the shell uses, not a copy. The
// disk driver, the keyboard, the console are likewise the system's own.
def startProgram() {
    if (!Fs.mounted) {
        sayErr('the disk has no filesystem');
        return false;
    }
    return true;
}

// the command line of the running program: words[0] is the command name, the rest its arguments
def progWords() {
    return Ctx.me().words;
}

// the folder the running program was started in
def progCwd() {
    return Ctx.me().cwd;
}

// runs the program; whatever it printed to a file is written out even if it fails
def programMain(main) {
    if (!startProgram()) { return nil; }
    try {
        main(progWords());
    } catch (e) {
        Ctx.me().flush();
        throw(e);
    }
    Ctx.me().flush();
}
