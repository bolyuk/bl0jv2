// aeon-os: the system page. A program the shell starts from the disk is a
// separate compiled file with its own copies of every class it imports, so the
// shell hands it what it needs through one fixed block of raw memory - the way
// a real OS gives a new process an environment: the disk driver's state, the
// command line, the working folder.
//
//   +0    magic 'AEON'
//   +4    disk sectors
//   +8    address of the disk's sector buffer
//   +12   syscall vector the disk driver uses from user mode
//   +16   the command's words, each ended by a NUL: 32-bit byte count, then UTF-8 bytes (at most 1000)
//   +1024 working folder: the same shape
//   +4096 standard input: a file path ('' = the terminal); +5120 standard output: a file path
//         to append to ('' = the terminal); the same text shape
//   +3088 keyboard ring (raw address); +3092 screen columns; +3096 screen rows
//   +3072 host folder share (--bridge-fs): present, path buffer, data buffer, syscall vector
//
// The shell reserves the page once, privileged (reserve() is), and fills it
// in; reading and writing it is peek/poke, which any ring may do.

import '../../stdlib/str/utf8.bl0';
import '../../stdlib/str/split.bl0';

def class Sys {
    static field base;
    static field textMax;
}
Sys.base = 0xF0000;
Sys.textMax = 1000;

// privileged
def sysReserve() {
    reserve(Sys.base, 8192);
}

def sysPublish(buffer, sectors, vector) {
    poke32(Sys.base, 0x41454F4E);
    poke32(Sys.base + 4, sectors);
    poke32(Sys.base + 8, buffer);
    poke32(Sys.base + 12, vector);
    sysPutText(Sys.base + 16, '');
    sysPutText(Sys.base + 1024, '');
    sysPutText(Sys.base + 4096, '');
    sysPutText(Sys.base + 5120, '');
}

def sysPutText(addr, text) {
    bytes = Utf8.encode(text);
    n = len(bytes);
    if (n > Sys.textMax) {
        free(bytes);
        throw('sys: text longer than ' + Sys.textMax + ' bytes');
    }
    poke32(addr, n);
    i = 0;
    while (i < n) {
        poke8(addr + 4 + i, bytes[i]);
        i += 1;
    }
    free(bytes);
}

def sysGetText(addr) {
    n = peek32(addr);
    if (n < 0 || n > Sys.textMax) { return ''; }
    bytes = [];
    i = 0;
    while (i < n) {
        push(bytes, peek8(addr + 4 + i));
        i += 1;
    }
    text = Utf8.decode(bytes);
    free(bytes);
    return text;
}

// the command's words travel NUL-terminated (a word may be empty or hold spaces)
def sysSetArgs(words) {
    text = '';
    i = 0;
    while (i < len(words)) {
        text = text + words[i] + strChar(0);
        i += 1;
    }
    sysPutText(Sys.base + 16, text);
}

def sysArgs() {
    text = sysGetText(Sys.base + 16);
    if (text == '') { return []; }
    parts = Split.split(text, strChar(0));
    pop(parts);
    return parts;
}

def sysSetStdio(inPath, outPath) {
    sysPutText(Sys.base + 4096, inPath);
    sysPutText(Sys.base + 5120, outPath);
}

def sysStdin() { return sysGetText(Sys.base + 4096); }
def sysStdout() { return sysGetText(Sys.base + 5120); }
def sysSetCwd(text) { sysPutText(Sys.base + 1024, text); }
def sysCwd() { return sysGetText(Sys.base + 1024); }

def sysPublishHfs(present, pathBuffer, dataBuffer, vector) {
    poke32(Sys.base + 3072, present ? 1 : 0);
    poke32(Sys.base + 3076, pathBuffer);
    poke32(Sys.base + 3080, dataBuffer);
    poke32(Sys.base + 3084, vector);
}

// the terminal: where the keyboard ring is (every copy of the keyboard driver must read
// the same one) and how big the screen is
def sysPublishTerm(keyboardBase, columns, rows) {
    poke32(Sys.base + 3088, keyboardBase);
    poke32(Sys.base + 3092, columns);
    poke32(Sys.base + 3096, rows);
}
