// aeon-os: starting programs from the virtual disk. The VM has no way to read
// a host file: a kernel reads a compiled program (.bl0c) from the disk with Fs,
// puts the bytes in raw memory and asks the VM to run them (execMem, which
// relocates the program to wherever there is room). Everything here runs
// privileged: the boot code, and the shell's kernel half (a syscall handler).
//
// journalExec() is the boot-time launcher: it runs a KERNEL program (it keeps
// its privilege and stays loaded) and records the outcome in the process
// journal and the system log. runProgram() is for user programs.

import '../kernel.bl0';
import '../../stdlib/fs/fs.bl0';
import '../../stdlib/str/split.bl0';
import 'log.bl0';

def class Loader {
    static field buffers;     // per core: where a program's bytes are put for execMem
    static field limits;
    static field mutex;
}
Loader.mutex = newMutex();

// each core loads from a buffer of its own (several cores may be starting programs at once): core 0, which
// loads the shell and the libraries, gets a big one, the others room for a command
def loaderBuffer(core) {
    lock(Loader.mutex);
    if (Loader.buffers == nil) {
        Loader.buffers = [];
        Loader.limits = [];
        i = 0;
        while (i < coreCount()) {
            push(Loader.buffers, nil);
            push(Loader.limits, i == 0 ? 262144 : 131072);
            i += 1;
        }
    }
    if (Loader.buffers[core] == nil) { Loader.buffers[core] = kalloc(Loader.limits[core]); }
    address = Loader.buffers[core];
    unlock(Loader.mutex);
    return address;
}

// reads 'path' from the disk and runs it. mode 0 = user program, 1 = kernel
// program, 2 = shared library. Errors (no such file, too big, a failing program) are thrown.
def loadAndRun(path, mode) {
    core = currentCore();
    buffer = loaderBuffer(core);
    limit = Loader.limits[core];
    data = Fs.readData(path);
    if (data == nil) { throw(path + ': no such file'); }
    size = len(data);
    if (size == 0 || size > limit) {
        free(data);
        throw(path + ': not a program (' + size + ' bytes; at most ' + limit + ' on this core)');
    }
    i = 0;
    while (i < size) {
        poke8(buffer + i, data[i]);
        i += 1;
    }
    free(data);
    execMem(buffer, size, mode);
}

// What went wrong in a program, as its author wrote it: execMem wraps the error of a failed program
// ("exec: 'memory at 4711' failed: Exception on address: 15614 - boom"); this is "boom". Whether the program
// was stopped from outside (kill, Ctrl-C) is told apart by this text being 'interrupted'.
def programError(text) {
    marker = ' - ';
    cut = -1;
    i = strFind(text, 'Exception on address: ', 0);
    if (i >= 0) { cut = strFind(text, marker, i); }
    if (cut < 0) { return text; }
    return strSub(text, cut + len(marker), len(text));
}

// The shared libraries (see libs.txt): lib/MANIFEST on the disk names their images, in load order.
// Each is loaded once, in mode 2: it runs its top level and exports what it defines, and every
// program loaded afterwards that was built against it links to that one copy - so a library's
// state (the filesystem's mounted flag, the keyboard ring, ...) is one for the whole system and a
// program carries only its own code. An image built without shared libraries has no manifest.
def loadLibraries() {
    manifest = Fs.read('lib/MANIFEST');
    if (manifest == nil) { return 0; }
    names = Split.split(manifest, strChar(10));
    count = 0;
    i = 0;
    while (i < len(names)) {
        if (names[i] != '') {
            loadAndRun(names[i], 2);
            count += 1;
        }
        i += 1;
    }
    Log.write('loader: ' + count + ' shared libraries loaded');
    return count;
}

// --- process journal: a log of every program a kernel-level caller has
// launched through journalExec() - name, outcome (ok / crashed: <message>)
// and how long it ran. execMem() itself knows nothing about this; it is pure
// kernel-side bookkeeping wrapped AROUND it, the way a real init system logs
// what it launches ---
def class ProcessJournal {
    static field entries;
    static field nextPid;
}
ProcessJournal.entries = [];
ProcessJournal.nextPid = 1;

def journalExec(name, path) {
    pid = ProcessJournal.nextPid;
    ProcessJournal.nextPid = ProcessJournal.nextPid + 1;
    startTick = ticks();
    println '  [journal] pid ' + pid + ' starting ' + name + ' (' + path + ')';
    Log.write('journal: pid ' + pid + ' starting ' + name);

    status = 'ok';
    try {
        loadAndRun(path, 1);
    } catch (e) {
        status = 'crashed: ' + e;
    }

    elapsedMs = ticks() - startTick;
    push(ProcessJournal.entries, 'pid=' + pid + ' name=' + name + ' status=' + status + ' elapsedMs=' + elapsedMs);
    println '  [journal] pid ' + pid + ' ' + name + ': ' + status + ' (' + elapsedMs + 'ms)';
    Log.write('journal: pid ' + pid + ' ' + name + ' ' + status);
    return status;
}

def printJournal() {
    println '--- process journal (' + len(ProcessJournal.entries) + ' entries) ---';
    i = 0;
    while (i < len(ProcessJournal.entries)) {
        println '  ' + ProcessJournal.entries[i];
        i = i + 1;
    }
}
