// aeon-os program: sort lines; sort [-r] [-n] [file] (standard input when no file)
// -r reverses, -n compares as numbers (lines that are not numbers count as 0).
// Loaded from the virtual disk by the shell (bin/sort.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def number(line) {
    n = 0;
    i = 0;
    neg = false;
    if (len(line) > 0 && strSub(line, 0, 1) == '-') { neg = true; i = 1; }
    while (i < len(line) && strFind('0123456789', strSub(line, i, i + 1), 0) >= 0) {
        n = n * 10 + strFind('0123456789', strSub(line, i, i + 1), 0);
        i += 1;
    }
    return neg ? -n : n;
}

// true when a should come before b
def before(a, b, numeric) {
    if (numeric) {
        x = number(a);
        y = number(b);
        if (x != y) { return x < y; }
    }
    return a < b;
}

// merge sort: stable, O(n log n)
def mergeSort(items, numeric) {
    n = len(items);
    if (n < 2) { return items; }
    mid = n / 2;
    left = mergeSort(Arr.slice(items, 0, mid), numeric);
    right = mergeSort(Arr.slice(items, mid, n), numeric);
    out = [];
    i = 0;
    j = 0;
    while (i < len(left) && j < len(right)) {
        if (before(right[j], left[i], numeric)) { push(out, right[j]); j += 1; }
        else { push(out, left[i]); i += 1; }
    }
    while (i < len(left)) { push(out, left[i]); i += 1; }
    while (j < len(right)) { push(out, right[j]); j += 1; }
    return out;
}

def main(words) {
    reverse = false;
    numeric = false;
    file = nil;
    i = 1;
    while (i < len(words)) {
        if (words[i] == '-r') { reverse = true; }
        else if (words[i] == '-n') { numeric = true; }
        else if (file == nil) { file = words[i]; }
        else { sayErr('usage: sort [-r] [-n] [file]'); return nil; }
        i += 1;
    }
    reader = openInput(file);
    if (reader == nil) { sayErr(file + ': no such file'); return nil; }
    lines = new Lines(reader);
    items = [];
    while (true) {
        line = lines.next();
        if (line == nil) { break; }
        push(items, line);
    }
    sorted = mergeSort(items, numeric);
    i = 0;
    while (i < len(sorted)) {
        say(reverse ? sorted[len(sorted) - 1 - i] : sorted[i]);
        i += 1;
    }
}

programMain(main);
