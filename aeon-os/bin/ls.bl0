// aeon-os program: list a folder
// Loaded from the virtual disk by the shell (bin/ls.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';

def main(words) {
    if (len(words) > 2) { sayErr('usage: ls [folder]'); return nil; }
    dir = progCwd();
    if (len(words) == 2) { dir = inCwd(words[1]); }
    if (!Dirs.isDir(dir)) { sayErr(words[1] + ': no such folder'); return nil; }
    entries = Dirs.list(dir);
    i = 0;
    while (i < len(entries)) {
        if (entries[i][2]) {
            say('   <dir>  ' + paintBold(4, entries[i][0] + '/'));
        } else {
            name = entries[i][0];
            if (Affix.endsWith(name, '.bl0c')) { name = paint(2, name); }
            say(Fmt.format('{:>8}  ', [entries[i][1]]) + name);
        }
        i += 1;
    }
    if (len(entries) == 0) { say('(empty)'); }
}

programMain(main);
