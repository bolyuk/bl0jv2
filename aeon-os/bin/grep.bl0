// aeon-os program: the lines containing a text; grep <text> [file] (standard input when no file)
// Loaded from the virtual disk by the shell (bin/grep.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def main(words) {
    if (len(words) < 2 || len(words) > 3) { sayErr('usage: grep <text> [file]'); return nil; }
    reader = openInput(len(words) == 3 ? words[2] : nil);
    if (reader == nil) { sayErr(words[2] + ': no such file'); return nil; }
    lines = new Lines(reader);
    found = 0;
    while (true) {
        line = lines.next();
        if (line == nil) { break; }
        if (strFind(line, words[1], 0) >= 0) {
            say(line);
            found += 1;
        }
    }
    if (found == 0) { sayErr('(no match)'); }
}

programMain(main);
