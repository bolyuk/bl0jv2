// aeon-os program: remove a file
// Loaded from the virtual disk by the shell (bin/rm.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';

def main(words) {
    if (len(words) != 2) { consoleWriteLine('usage: rm <file>'); return nil; }
    if (!Fs.remove(inCwd(words[1]))) { consoleWriteLine(words[1] + ': no such file'); }
}

if (startProgram()) { main(Prog.words); }
