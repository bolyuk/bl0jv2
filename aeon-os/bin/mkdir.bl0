// aeon-os program: make a folder
// Loaded from the virtual disk by the shell (bin/mkdir.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';

def main(words) {
    if (len(words) != 2) { consoleWriteLine('usage: mkdir <folder>'); return nil; }
    Dirs.mkdir(inCwd(words[1]));
}

if (startProgram()) { main(Prog.words); }
