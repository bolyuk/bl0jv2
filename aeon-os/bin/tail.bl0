// aeon-os program: the last lines of a file (tail [-n N] <file>)
// Loaded from the virtual disk by the shell (bin/tail.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';

def main(words) {
    count = 10;
    at = 1;
    if (len(words) >= 3 && words[1] == '-n') {
        count = portNumber(words[2]);
        if (count == nil) { consoleWriteLine('usage: tail [-n N] <file>'); return nil; }
        at = 3;
    }
    if (len(words) != at + 1) { consoleWriteLine('usage: tail [-n N] <file>'); return nil; }
    text = Fs.read(inCwd(words[at]));
    if (text == nil) { consoleWriteLine(words[at] + ': no such file'); return nil; }
    lines = Split.split(text, strChar(10));
    if (len(lines) > 0 && lines[len(lines) - 1] == '') { pop(lines); }
    from = len(lines) - count;
    if (from < 0) { from = 0; }
    printText(strJoin(Arr.slice(lines, from, len(lines)), strChar(10)));
}

if (startProgram()) { main(Prog.words); }
