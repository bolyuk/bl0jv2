// aeon-os program: the last lines of a file; tail [-n N] [file] (standard input when no file)
// Loaded from the virtual disk by the shell (bin/tail.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def main(words) {
    count = 10;
    at = 1;
    if (len(words) >= 3 && words[1] == '-n') {
        count = portNumber(words[2]);
        if (count == nil) { sayErr('usage: tail [-n N] [file]'); return nil; }
        at = 3;
    }
    if (len(words) > at + 1) { sayErr('usage: tail [-n N] [file]'); return nil; }
    text = inputText(len(words) == at + 1 ? words[at] : nil);
    if (text == nil) { sayErr(words[at] + ': no such file'); return nil; }
    lines = Split.split(text, strChar(10));
    if (len(lines) > 0 && lines[len(lines) - 1] == '') { pop(lines); }
    from = len(lines) - count;
    if (from < 0) { from = 0; }
    i = from;
    while (i < len(lines)) {
        say(lines[i]);
        i += 1;
    }
}

programMain(main);
