// aeon-os program: windows on the text screen. wm [file ...]
//
// Opens the process table, the cores (dev/cpu) and the clock (dev/time) - or the files named - each in a window, on
// the terminal's alternate screen; the windows are views onto files, so any file may be put in one (a file of dev/,
// proc/ or net/ is live). Keys:
//   Tab          the next window comes to the top        Arrows   move the top window (or size it, after r)
//   r            switch between moving and sizing        z        maximise / restore
//   n            open a file in a new window (type its name, Enter)
//   x            close the top window                    PgUp/PgDn  scroll          q, Esc, Ctrl-C   leave
// Loaded from the virtual disk by the shell (bin/wm.bl0c); see lib/win.bl0.

import '../lib/win.bl0';
import '../lib/keys.bl0';

def sizeOfNew(desk, index) {
    return [2 + index * 3, 1 + index * 2];
}

def openFile(desk, path) {
    n = len(desk.windows);
    pos = sizeOfNew(desk, n);
    w = new Window(path, 'file:' + path, pos[0], pos[1], 36, 8);
    desk.keepInside(w);
    desk.add(w);
}

// the name of a file typed on the status line: nil when cancelled
def askName(desk) {
    text = '';
    while (true) {
        desk.draw(' open: ' + text + '_');
        key = Keys.read(1000);
        checkAbort();
        if (key == nil) { continue; }
        if (key.name == 'ENTER') { return text == '' ? nil : text; }
        if (key.name == 'ESC' || key.name == 'CTRL-C') { return nil; }
        if (key.name == 'BACKSPACE') { if (len(text) > 0) { text = strSub(text, 0, len(text) - 1); } }
        else if (key.name == nil) { text += key.text; }
    }
}

def run(desk, words) {
    if (len(words) > 1) {
        i = 1;
        while (i < len(words)) { openFile(desk, words[i]); i += 1; }
    } else {
        desk.add(new Window('processes', 'ps', 1, 1, 34, 10));
        desk.add(new Window('dev/cpu', 'file:dev/cpu', 30, 6, 30, 6));
        desk.add(new Window('dev/time', 'file:dev/time', 50, 2, 26, 4));
    }
    sizing = false;
    done = false;
    while (!done) {
        top = desk.top();
        status = ' ' + (top == nil ? 'no windows' : top.title) + '   [' + (sizing ? 'size' : 'move') + ']  Tab next  arrows  r size  z max  n open  x close  q quit';
        desk.draw(status);
        key = Keys.read(1000);
        checkAbort();
        if (key == nil) { desk.refreshAll(); continue; }
        if (key.name == 'ESC' || key.name == 'CTRL-C') { done = true; }
        else if (key.name == 'TAB') { desk.cycle(); }
        else if (key.name == 'LEFT') { if (sizing) { desk.resizeBy(-2, 0); } else { desk.moveBy(-2, 0); } }
        else if (key.name == 'RIGHT') { if (sizing) { desk.resizeBy(2, 0); } else { desk.moveBy(2, 0); } }
        else if (key.name == 'UP') { if (sizing) { desk.resizeBy(0, -1); } else { desk.moveBy(0, -1); } }
        else if (key.name == 'DOWN') { if (sizing) { desk.resizeBy(0, 1); } else { desk.moveBy(0, 1); } }
        else if (key.name == 'PGUP') { desk.scrollBy(-4); }
        else if (key.name == 'PGDN') { desk.scrollBy(4); }
        else if (key.name == nil) {
            t = key.text;
            if (t == 'q' || t == 'Q') { done = true; }
            else if (t == 'r') { sizing = !sizing; }
            else if (t == 'z') { desk.toggleMaximise(); }
            else if (t == 'x') { desk.close(); }
            else if (t == 'n') {
                name = askName(desk);
                if (name != nil) { openFile(desk, name); }
            }
        }
        desk.refreshAll();
    }
}

def main(words) {
    if (!toTerminal()) { sayErr('wm: needs a terminal (its output cannot go to a file, a pipe or an ssh session)'); return nil; }
    columns = Console.columns > 20 ? Console.columns : 80;
    rows = Console.rows > 6 ? Console.rows : 24;
    desk = new Desk(columns, rows);
    consoleWrite(Term.esc + '[?1049h' + Term.esc + '[?25l' + Term.clearScreen());
    try {
        run(desk, words);
    } catch (e) {
        consoleWrite(Term.esc + '[?25h' + Term.esc + '[?1049l');
        throw(e);
    }
    consoleWrite(Term.esc + '[?25h' + Term.esc + '[?1049l');
}

programMain(main);
