// aeon-os program: the first lines of a file; head [-n N] [file] (standard input when no file)
// Loaded from the virtual disk by the shell (bin/head.bl0c); see lib/userland.bl0.
// It stops reading as soon as it has enough, which ends a producer that would never stop.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def main(words) {
    count = 10;
    at = 1;
    if (len(words) >= 3 && words[1] == '-n') {
        count = portNumber(words[2]);
        if (count == nil) { sayErr('usage: head [-n N] [file]'); return nil; }
        at = 3;
    }
    if (len(words) > at + 1) { sayErr('usage: head [-n N] [file]'); return nil; }
    reader = openInput(len(words) == at + 1 ? words[at] : nil);
    if (reader == nil) { sayErr(words[at] + ': no such file'); return nil; }
    lines = new Lines(reader);
    shown = 0;
    while (shown < count) {
        line = lines.next();
        if (line == nil) { break; }
        say(line);
        shown += 1;
    }
}

programMain(main);
