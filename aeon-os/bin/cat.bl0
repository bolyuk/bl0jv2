// aeon-os program: print files, or standard input when none is named
// Loaded from the virtual disk by the shell (bin/cat.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def copy(reader) {
    while (true) {
        piece = reader.chunk();
        if (piece == nil) { break; }
        sayRaw(piece);
    }
}

def main(words) {
    if (len(words) == 1) {
        copy(openInput(nil));
        return nil;
    }
    i = 1;
    while (i < len(words)) {
        reader = openInput(words[i]);
        if (reader == nil) {
            sayErr(words[i] + ': no such file');
        } else {
            copy(reader);
        }
        i += 1;
    }
}

programMain(main);
