// aeon-os program: the lines in which two files differ; diff <old> <new>
// Lines only in the old file are shown as '- N text', lines only in the new one as '+ N text' (N is the
// line number in that file), in file order. Common lines at the start and the end are skipped, and the
// middle is compared with a longest-common-subsequence table, so very different big files are refused.
// Loaded from the virtual disk by the shell (bin/diff.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';
import '../lib/input.bl0';

def linesOf(path) {
    reader = openInput(path);
    if (reader == nil) { return nil; }
    lines = new Lines(reader);
    out = [];
    while (true) {
        line = lines.next();
        if (line == nil) { break; }
        push(out, line);
    }
    return out;
}

def main(words) {
    if (len(words) != 3) { sayErr('usage: diff <old> <new>'); return nil; }
    a = linesOf(words[1]);
    if (a == nil) { sayErr(words[1] + ': no such file'); return nil; }
    b = linesOf(words[2]);
    if (b == nil) { sayErr(words[2] + ': no such file'); return nil; }
    start = 0;
    while (start < len(a) && start < len(b) && a[start] == b[start]) { start += 1; }
    endA = len(a);
    endB = len(b);
    while (endA > start && endB > start && a[endA - 1] == b[endB - 1]) { endA -= 1; endB -= 1; }
    n = endA - start;
    m = endB - start;
    if (n == 0 && m == 0) { say('the files are identical'); return nil; }
    if ((n + 1) * (m + 1) > 250000) { sayErr('the files differ too much (or are too big) to compare line by line'); return nil; }
    // lcs[i][j]: the common length of a[start+i ..] and b[start+j ..]
    lcs = [];
    i = 0;
    while (i <= n) {
        row = [];
        j = 0;
        while (j <= m) { push(row, 0); j += 1; }
        push(lcs, row);
        i += 1;
    }
    i = n - 1;
    while (i >= 0) {
        j = m - 1;
        while (j >= 0) {
            if (a[start + i] == b[start + j]) { lcs[i][j] = lcs[i + 1][j + 1] + 1; }
            else if (lcs[i + 1][j] >= lcs[i][j + 1]) { lcs[i][j] = lcs[i + 1][j]; }
            else { lcs[i][j] = lcs[i][j + 1]; }
            j -= 1;
        }
        i -= 1;
    }
    removed = 0;
    added = 0;
    i = 0;
    j = 0;
    while (i < n || j < m) {
        if (i < n && j < m && a[start + i] == b[start + j]) {
            i += 1;
            j += 1;
        } else if (i < n && (j == m || lcs[i + 1][j] >= lcs[i][j + 1])) {
            say(paint(1, '- ' + (start + i + 1) + ' ' + a[start + i]));
            removed += 1;
            i += 1;
        } else {
            say(paint(2, '+ ' + (start + j + 1) + ' ' + b[start + j]));
            added += 1;
            j += 1;
        }
    }
    say(removed + ' removed, ' + added + ' added');
}

programMain(main);
