// aeon-os program: a file as hex and text
// Loaded from the virtual disk by the shell (bin/hexdump.bl0c); see lib/userland.bl0.

import '../lib/userland.bl0';

def main(words) {
    if (len(words) != 2) { consoleWriteLine('usage: hexdump <file>'); return nil; }
    data = Fs.readData(inCwd(words[1]));
    if (data == nil) { consoleWriteLine(words[1] + ': no such file'); return nil; }
    limit = len(data) < 512 ? len(data) : 512;
    off = 0;
    while (off < limit) {
        hex = [];
        ascii = '';
        i = 0;
        while (i < 16) {
            if (off + i < limit) {
                b = data[off + i];
                push(hex, Fmt.format('{:02x}', [b]));
                ascii = ascii + Char.char(b == 32 ? 46 : b);
            } else {
                push(hex, '  ');
            }
            i += 1;
        }
        consoleWriteLine(Fmt.format('{:04x}  {}  {}', [off, strJoin(hex, ' '), ascii]));
        off += 16;
    }
    if (limit < len(data)) { consoleWriteLine(Fmt.format('... {} more bytes', [len(data) - limit])); }
    free(data);
}

if (startProgram()) { main(Prog.words); }
