// aeon-os: a tiny kernel written entirely in bl0jv2. Driver code (heap,
// keyboard, console, process journal) lives in aeon-os/kernel.bl0 and is
// imported below, not copy-pasted here - see that file's own header
// comment for what "shared" means now that exec() runs a loaded program in
// THIS SAME Bl0jv2_jVM instance, not a separate one (see Bl0jv2_jVM's own
// exec() doc). Everything a kernel needs (device access, interrupts, fault
// isolation, scheduling, memory management, a HID input driver, and
// launching+logging child processes) is expressed in bl0jv2, using
// primitives the VM exposes: reserve/peek/poke and in/out for hardware,
// registerHandler/raiseInterrupt/disable/enableInterrupts for interrupts,
// exec() to launch a child process, try/catch for recoverable faults,
// panic() for fatal ones. The VM deliberately does NOT provide a
// general-purpose allocator (no alloc()/free() for raw memory) - real
// hardware doesn't either, so kernel.bl0's heap allocator is this kernel's
// own, built on nothing but reserve()/peek()/poke().
//
// This file is the closest thing aeon-os has to "the OS proper": it boots,
// runs its own cooperative scheduler demo, then launches (and journals)
// three child processes - two trivial ones (child_hello, child_crash)
// proving what sharing one VM instance actually buys and costs, and
// aeon-os/shell.bl0c itself, which is how the interactive shell is reached
// now - not by running shell.bl0c directly. `bl0jv2 -e -k aeon-os/boot.bl0c`
// bridges real stdin straight through: there is only ever one VM instance
// now, so there is no "which process is currently running" redirection to
// do (see Bl0jv2_CLI's own -k doc) - whichever exec()'d code registered a
// keyboard handler just sees it.

import '../stdlib/mathlib.bl0';
import 'kernel.bl0';

// --- raw memory layout: kernel.bl0's heap counter owns address 0 (see its
// own doc) - everything else this kernel reserves has to sit AFTER it.
// The "system info" register block is a fixed MMIO-style block at 4-11,
// reserved so kalloc() can never hand those addresses out for anything
// else. initHeap() must run before the first kalloc() call anywhere in
// the whole exec() chain that follows (boot.bl0 boots first, so it's the
// one place this has to happen) ---
SYS_INFO_BASE = 4;
SYS_INFO_SIZE = 8;
SYS_MAGIC = 0xAE07C0DE;

reserve(SYS_INFO_BASE, SYS_INFO_SIZE);
poke32(SYS_INFO_BASE, SYS_MAGIC);
initHeap(SYS_INFO_BASE + SYS_INFO_SIZE);

println '=== aeon-os booting ===';
println 'sys info magic: ' + Math.toHex(peek32(SYS_INFO_BASE));
println 'uptime: ' + ticks() + 'ms';

// --- kernel-global state lives on a class's static fields, not in a
// top-level variable - a plain 'def' function has its own private frame and
// can't see or mutate a top-level variable by name (only a lambda captures
// enclosing scope); a static field is resolved by explicit qualified name
// at compile time instead, so any function can reach it regardless of
// nesting ---
def class Kernel {
    static field uptimeTicks;
    static field faultCount;
}

Kernel.uptimeTicks = 0;
Kernel.faultCount = 0;

// --- interrupt vectors --- (kernel.bl0 uses Keyboard.vector=2 and
// Console.sysWriteVector=1 for its own drivers - this one is boot.bl0's
// own, so it picks a vector kernel.bl0 doesn't use, even though boot.bl0
// itself never calls kernel.bl0's initKeyboard()/initConsole())
VECTOR_TIMER = 3;

def onTimerTick(vector) {
    Kernel.uptimeTicks = Kernel.uptimeTicks + 1;
}

registerHandler(onTimerTick, VECTOR_TIMER, 100);

// --- scheduler: a run queue of Task instances, picked by priority. Tasks
// can't be suspended mid-body (bl0jv2 has no coroutines/continuations, only
// def/lambda functions), so this is a run-to-completion cooperative
// scheduler, not preemptive multitasking - each task runs once per pick,
// end to end, then either re-queues itself or is done ---
def class Task {
    field name;
    field priority;
    field remainingRuns;
    field fn; // a plain function value - see Scheduler.runOnce() for why
              // it's called through a local var rather than task.fn()

    def init(name, priority, remainingRuns, fn) {
        this.name = name;
        this.priority = priority;
        this.remainingRuns = remainingRuns;
        this.fn = fn;
    }
}

def class Scheduler {
    field tasks;

    def init() {
        this.tasks = [];
    }

    def addTask(t) {
        push(this.tasks, t);
    }

    // index of the highest-priority ready task, or -1 if the queue is empty
    def pickIndex() {
        // bl0jv2 has no bare 'return;' - every return needs a value
        if (len(this.tasks) == 0) { return -1; }
        best = 0;
        i = 1;
        while (i < len(this.tasks)) {
            if (this.tasks[i].priority > this.tasks[best].priority) {
                best = i;
            }
            i = i + 1;
        }
        return best;
    }

    // removes index i by swapping with the last element and popping -
    // Bl0jArray only exposes push/pop, no arbitrary-index removal, and
    // scheduling order doesn't depend on queue order anyway (pickIndex()
    // rescans by priority every time)
    def removeAt(i) {
        last = len(this.tasks) - 1;
        if (i != last) {
            this.tasks[i] = this.tasks[last];
        }
        pop(this.tasks);
    }

    // runs the highest-priority task once. Mutating the run queue
    // (removeAt/re-adding) is wrapped in disable/enableInterrupts: the
    // timer handler only touches Kernel.uptimeTicks today, but a real
    // kernel's timer handler often *does* touch the run queue directly
    // (e.g. waking a sleeping task) - without masking, a tick landing
    // mid-mutation here would see a half-updated queue
    def runOnce() {
        idx = this.pickIndex();
        if (idx < 0) { return nil; }

        t = this.tasks[idx];

        disableInterrupts();
        this.removeAt(idx);
        enableInterrupts();

        fn = t.fn;
        try {
            fn();
        } catch (e) {
            println '  [fault] task ' + t.name + ' failed: ' + e;
            Kernel.faultCount = Kernel.faultCount + 1;
        }

        t.remainingRuns = t.remainingRuns - 1;
        if (t.remainingRuns > 0) {
            disableInterrupts();
            this.addTask(t);
            enableInterrupts();
        }
    }
}

// --- demo tasks ---
def taskLogger() {
    println '  [logger] uptime=' + Kernel.uptimeTicks + 'ms';
}

// allocates a scratch packet buffer from the kernel's own heap (distinct
// from the reserved MMIO region above), writes/reads through it, then
// frees it - exercises kalloc/poke/peek/kfree rather than reserve/peek/poke
def taskNetwork() {
    buf = kalloc(4);
    poke32(buf, 0xC0FFEE);
    println '  [network] received packet: ' + Math.toHex(peek32(buf));
    kfree(buf);
}

// deliberately faulty, to prove one task's error doesn't take down the
// scheduler or the rest of the system - only panic() does that
def taskFaulty() {
    x = 1 / 0;
}

println '';
println '--- starting scheduler ---';
sched = new Scheduler();
sched.addTask(new Task('logger', 5, 2, taskLogger));
sched.addTask(new Task('network', 20, 2, taskNetwork));
sched.addTask(new Task('faulty', 10, 1, taskFaulty));

// named 'cycle', not 'round' - 'round' collides with mathlib.bl0's own
// round() (imported above) and a variable can't currently shadow a
// function name (see the aeon-os build notes)
cycle = 0;
while (cycle < 5) {
    raiseInterrupt(VECTOR_TIMER);
    sched.runOnce();
    cycle = cycle + 1;
}

println '';
println 'kernel uptime ticks: ' + Kernel.uptimeTicks;
println 'faults isolated by the scheduler: ' + Kernel.faultCount;

// --- launching child processes: exec() (kernel.bl0's journalExec()
// wrapper around it) loads and runs a SEPARATE compiled file, appended
// into THIS SAME Bl0jv2_jVM's own address space (see Bl0jv2_jVM's own
// exec() doc) - same heap, same raw memory, same devices as this kernel.
// Every relocated address is unique, so child_hello/child_crash/shell can
// each define their own same-named classes/functions (they do, via their
// own kernel.bl0 import) with zero collision - but they're sharing real
// state now, which is why they all agreed on kernel.bl0's fixed heap
// layout (see its own doc) instead of each assuming address 0 is free.
// Paths are resolved against the process's own working directory, not
// this file's location (unlike import above) ---
println '';
println '--- launching child processes ---';

journalExec('child_hello', 'aeon-os/child_hello.bl0c');

// child_crash.bl0 fails with an ORDINARY runtime error on purpose (not
// panic()) - journalExec() catches it right at the exec() call site,
// exactly like any other exec() failure, and records it as a crash in the
// journal rather than letting it propagate further. This kernel keeps
// running afterward, which is the actual point: an ordinary bug in
// exec()'d code doesn't have to be fatal to the whole machine. A REAL
// panic() would be different - since everything now shares one VM
// instance, panic() anywhere sets the ONE 'panicked' flag and halts
// everything, no exceptions (see the final integrity check below, and
// Bl0jv2_jVM's own exec() doc on why that's correct, not a limitation)
journalExec('child_crash', 'aeon-os/child_crash.bl0c');

// the interactive shell - a real child process now, not inlined code.
// With -k, real stdin reaches it directly (see this file's own header
// comment); without it, the shell's own busy-poll loop just never sees
// any input and exits only if something else raises its 'exit' path -
// running boot.bl0 non-interactively will make this journal entry hang
// until killed, exactly like launching an interactive shell with no
// controlling terminal would on a real system
journalExec('shell', 'aeon-os/shell.bl0c');

println '';
printJournal();

// --- shutdown: a routine integrity check, and what happens when one
// fails. A task error is recoverable (see taskFaulty above, caught and
// logged without disturbing anything else); a corrupted system info block
// is not - this is what panic() is for, and unlike a task error it is
// never caught, even by a try/catch wrapped directly around it ---
println '';
println '--- final integrity check ---';

// simulate memory corruption: something scribbled over the reserved
// system info block
poke32(SYS_INFO_BASE, 0);

try {
    if (peek32(SYS_INFO_BASE) != SYS_MAGIC) {
        panic('system info block corrupted - expected magic ' + Math.toHex(SYS_MAGIC) +
              ', found ' + Math.toHex(peek32(SYS_INFO_BASE)));
    }
    println '=== aeon-os halted cleanly ===';
} catch (e) {
    // never reached - panic() bypasses this catch entirely
    println 'recovered from: ' + e;
}
