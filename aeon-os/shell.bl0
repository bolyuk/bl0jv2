// aeon-os (shell): a tiny bash-like REPL, running almost entirely in USER
// MODE. Single-core, like boot.bl0 - not smp_boot.bl0 - because nothing
// here needs more than one core, and it sidesteps that file's own
// cross-core interrupt-stealing hazard entirely (see its header comment).
// Driver code (heap, keyboard, console) comes from aeon-os/kernel.bl0, not
// copy-pasted here - see that file's own header comment for what "shared"
// does and doesn't mean. Normally launched as a child process of
// aeon-os/boot.bl0 (via journalExec('shell', ...) - see boot.bl0's own
// header comment), not run directly, though running this file's own
// compiled output standalone still works the same way it always did.
//
// The kernel does its one-time setup (heap, keyboard driver, console
// device + syscall gate) while still privileged, then drops to user mode
// ONCE, right before the shell starts. Everything from there on - the
// REPL loop and every command it runs - executes unprivileged. `reboot`
// proves it: it tries to bypass the console's syscall gate and write to
// the device directly, and gets blocked, the same enforcement pattern
// smp_boot.bl0's taskRogue demonstrates.
//
// Reading the keyboard needs no syscall at all: kbHasInput()/kbReadByte()
// only ever peek8() a ring buffer in raw memory (never gated - see
// requirePrivileged's own doc on why) - it's a read-only, kernel-populated
// buffer userspace polls directly, the same shape a real io_uring/vDSO
// shared ring gives userspace lock-free reads without a syscall per byte.
// Writing to the actual console device is a different story - out8() IS
// gated, so every command's output goes through syscall(sysWriteVector).
//
// A syscall handler must never itself call haltCore(): the only thing
// that can actually turn a *pending* interrupt into a *delivered* one
// (i.e. run its handler, which is what would make kbHasInput() true) is
// the outermost poll-eligible execute() loop - and a syscall trap has
// already left that loop by the time its own handler body runs. Blocking
// there waits for a delivery that can only happen after the block ends,
// which never happens. This is why the REPL loop below checks kbHasInput()
// itself (sleeping in kbWait() when there is nothing) instead of trying to
// wrap it in a "blocking read" syscall - a design this file's author tried
// first, and which hangs for exactly the reason above.

import '../stdlib/mathlib.bl0';
import 'kernel.bl0';
import 'lib/drivers.bl0';
import 'lib/netutil.bl0';
import '../stdlib/str/split.bl0';
import '../stdlib/str/trim.bl0';
import '../stdlib/str/fmt.bl0';
import 'lib/loader.bl0';
import 'lib/userland.bl0';
import 'lib/lineedit.bl0';
import 'lib/cmdline.bl0';
import 'lib/proc.bl0';
import 'lib/perm.bl0';
import 'lib/users.bl0';
import 'lib/power.bl0';
import '../stdlib/time/clock.bl0';

// when boot.bl0 exec()s this file, it already called kernel.bl0's
// initHeap() with ITS OWN reserved regions accounted for (see its own
// doc) - since exec() now shares one raw memory arena (see Bl0jv2_jVM's
// own exec() doc), calling initHeap() again here would reset that shared
// counter and let this file's own kalloc() calls overwrite whatever the
// kernel (or an earlier child) already allocated. peek32(0) reading back
// 0 is how a fresh, never-initialized counter looks (see kernel.bl0's own
// doc) - not a bulletproof test in general, but reliable for this
// project, where every initHeap() caller reserves at least a few bytes
// below the heap first, so a real heapBase is never actually 0. This is
// what lets this file still run standalone (`bl0jv2 -e -k
// aeon-os/shell.bl0c`, no boot.bl0 involved) as well as exec()'d
if (peek32(0) == 0) {
    initHeap(4);
}
initKeyboard();
initConsole();
// what interrupting a program and running several at once need: the abort words, one Ctx per core, the
// process table
initAbort(coreCount());
Ctx.setup(coreCount());
Proc.init();
// the network device: init() or initWithHostBridge(), whichever the host attached
// (privileged - reads a port and registers handlers - so it happens here, before
// dropToUserMode(); afterwards the shell sends through the kernel's syscall)
Nic.initAuto();
Dns.myIp = Net.localIp;
TcpConn.connectTimeoutMs = 5000;
// the disk, if the host attached one (privileged, like the NIC): a sector buffer
// in raw memory, then mount - an unformatted disk stays unmounted until 'format'
Disk.init(kalloc(512));
if (Disk.present()) { Fs.mount(); }
// the host folder, if the host shared one (--bridge-fs)
Hfs.init(kalloc(260), kalloc(Hfs.chunk));
Log.write('shell: started');

// --- built-in commands ---
def cmdHelp() {
    say('built in: help, clear, echo <text> [> file], uptime, whoami, reboot, exit, pwd, cd, format yes,');
    say('          NAME=value  $NAME  set  unset <name>  sh <file> [args]  (a script: one command per line, # comments)');
    say('          exec <file> [args]  (a text may hold \\n for a line break)');
    say('programs on the disk (bin/): ls cat write append touch rm mv cp stat wc head tail grep');
    say('          hexdump sort uniq find tree more diff seq chmod chown chgrp passwd useradd userdel groupadd groupdel usermod groups crond crontab date echo service logs shutdown mount umount mkfs df mkdir rmdir edit sleep yes ps top kill wait - and any program you put there, run by its name');
    say('the folder shared with --bridge-fs is the directory host/: ls host, cp host/a.txt a.txt, ...');
    say('network (programs): net netstat setip setdns ping resolve http tcp udp httpd');
}

def cmdUptime() {
    say('uptime: ' + ticks() + 'ms');
}

def cmdWhoami() {
    if (isPrivileged()) {
        say('kernel');
    } else {
        say(ShellState.userName + ' (user mode)');
    }
}

// id: the numbers behind the name
def cmdId() {
    me = syscall(Sys.who, nil);
    names = [];
    i = 0;
    while (i < len(me[4])) {
        push(names, me[4][i] + '(' + Users.groupNameOf(me[4][i]) + ')');
        i += 1;
    }
    say('uid=' + me[0] + '(' + me[3] + ') gid=' + me[1] + '(' + Users.groupNameOf(me[1]) + ') groups=' + strJoin(names, ','));
}

// what logging in as this user changes in the shell: the history is theirs, and so are the settings
def adoptIdentity(me) {
    ShellState.userName = me[3];
    ShellState.home = me[2] == '' ? 'root' : me[2];
    LineEditor.history = [];
    histLoad();
}

// su [user]: become that user (root by default); exit comes back
def cmdSu(words) {
    if (len(words) > 2) { sayErr('usage: su [user]'); return nil; }
    target = len(words) == 2 ? words[1] : 'root';
    password = '';
    if (syscall(Sys.who, nil)[0] != 0) {
        password = LineEditor.readSecret('Password: ');
        if (password == nil) { return nil; }
    }
    result = syscall(Sys.login, [target, password, false]);
    if (isString(result)) {
        sayErr('su: ' + result);
        return nil;
    }
    adoptIdentity(result);
}

// ends the shell, or - after su - goes back to the user it was run from
def cmdExit() {
    previous = syscall(Sys.logout, nil);
    if (previous == nil) {
        // root leaving the shell for good stops the machine, in order; anybody else just ends their session
        if (Ctx.me().uid == 0) { Shutdown.stopAll(true); }
        say('bye');
        ShellState.running = false;
        return nil;
    }
    adoptIdentity(previous);
}

// the login prompt, when root has a password: the shell does not start for anyone who cannot give one
def loginIfNeeded() {
    if (!Fs.mounted || !Users.hasPasswordForLogin()) { return nil; }
    while (true) {
        name = LineEditor.read('login: ');
        if (name == nil) { ShellState.running = false; return nil; }
        if (name == '') { continue; }
        password = LineEditor.readSecret('Password: ');
        if (password == nil) { continue; }
        result = syscall(Sys.login, [name, password, true]);
        if (!isString(result)) {
            adoptIdentity(result);
            return nil;
        }
        sayErr('login incorrect');
    }
}

// deliberately tries to bypass the syscall gate and write to the console
// device directly - proves the ring boundary is real, not just documented
def cmdReboot() {
    try {
        out8(Console.port, 0);
        say('rebooting...');
    } catch (e) {
        sayErr('reboot: permission denied');
    }
}

// --- files and programs ---
//
// The disk is the host's --disk image behind the block-device ports; Fs (a
// filesystem written in bl0) does the rest. Folders are name prefixes (see
// stdlib/fs/dirs.bl0); paths are relative to the current folder ('cd'),
// absolute when they start with '/', and may use '.' and '..'.
//
// Only what changes the shell's own state is built in (cd, pwd, echo >, format,
// exec, the network commands, ...). Every other command - ls, cat, cp, grep,
// ... - is a program on the virtual disk, bin/<name>.bl0c, loaded into memory
// when you type its name: the shell finds it with Fs, puts the command line and
// the current folder where the program finds them (Prog.words, Prog.cwd, Io - shared libraries
// make those the shell's own variables), and asks the kernel to
// run it. The kernel half is sysExec below, a syscall handler registered before
// dropToUserMode(): it reads the file and calls execMem, which runs the program
// UNPRIVILEGED and unloads it when it returns. A program that fails reports its
// error and the shell goes on; one that calls panic() halts the machine.

// true when the files can be used; otherwise says why
def fsReady() {
    if (!Disk.present()) {
        sayErr('no disk attached (start with --disk <image>)');
        return false;
    }
    if (!Fs.mounted) {
        sayErr('the disk has no filesystem: run "format yes" to create one (erases the disk)');
        return false;
    }
    return true;
}

def class ShellState {
    static field running;
    static field cwd;
    static field pipeSeq;
    static field vars;         // [[name, value], ...]: the shell's variables
    static field aliases;      // [[name, text], ...]
    static field depth;        // scripts running inside scripts
    static field home;         // the folder of whoever is logged in (their history lives there)
    static field userName;
}
ShellState.running = true;
ShellState.cwd = '';
ShellState.pipeSeq = 0;
ShellState.vars = [['PATH', 'bin']];
ShellState.aliases = [];
ShellState.depth = 0;
ShellState.home = 'root';
ShellState.userName = 'root';

// a path as typed -> the stored name, relative to the current folder
def here(path) {
    return FsPath.resolve(ShellState.cwd, path);
}

def prompt() {
    who = ShellState.userName == 'root' ? '' : Term.paint(3, ShellState.userName) + ' ';
    if (ShellState.cwd == '') { return who + Term.paintBold(2, '$') + ' '; }
    return who + Term.paintBold(4, '/' + ShellState.cwd) + ' ' + Term.paintBold(2, '$') + ' ';
}

def cmdPwd() {
    say('/' + ShellState.cwd);
}

def cmdCd(words) {
    if (len(words) > 2) { sayErr('usage: cd [folder]'); return nil; }
    if (!fsReady()) { return nil; }
    target = '';
    if (len(words) == 2) { target = here(words[1]); }
    if (!Dirs.isDir(target)) { sayErr(words[1] + ': no such folder'); return nil; }
    ShellState.cwd = target;
}

def cmdFormat(words) {
    if (!Disk.present()) { sayErr('no disk attached (start with --disk <image>)'); return nil; }
    if (len(words) != 2 || words[1] != 'yes') {
        say('this erases the whole disk: run "format yes" to go ahead');
        return nil;
    }
    Fs.format();
    ShellState.cwd = '';
    Log.write('shell: disk formatted');
    say('formatted ' + Disk.sectors + ' sectors');
}

def class Exec {
    static field vector;
    static field spawnVector;
}
Exec.vector = 7;
Exec.spawnVector = 9;

// the kernel half of running a program (a syscall handler, so privileged): '' or the error
def sysExec(path) {
    try {
        loadAndRun(path, 0);
        return '';
    } catch (e) {
        return str(e);
    }
}
registerHandler(sysExec, Exec.vector, 1);

// the kernel half of starting a process on another core: [true, the Process] or [false, the error]
def sysSpawn(request) {
    try {
        return [true, Proc.spawn(request[0], request[1], request[2], request[3], len(request) > 4 ? request[4] : nil)];
    } catch (e) {
        return [false, str(e)];
    }
}
registerHandler(sysSpawn, Exec.spawnVector, 1);
Clock.init();

// ---- who may do what: the kernel's half (system calls, so they run privileged) ----

// every file operation of a program in user mode: allowed for the caller's user, or an error
def sysFsGate(request) {
    c = Ctx.me();
    Perm.check(c.uid, c.groups, request[0], request[1], request[2]);
    return Fs.runAs(c.uid, c.gid, request[0], request[1], request[2]);
}
registerHandler(sysFsGate, Sys.fsGate, 1);
registerHandler(Log.writeDirect, Log.vector, 1);

// The raw disk and the host folder are reachable from user mode through system calls the drivers registered.
// With the gate in place only root may use them directly: everybody else goes through the file system.
def sysDiskGuard(request) {
    if (Ctx.me().uid != 0) { throw('fs: permission denied (the raw disk is for root)'); }
    return onDiskSyscall(request);
}
def sysHostFolderGuard(request) {
    if (Ctx.me().uid != 0) { throw('fs: permission denied (the host folder is reached through host/)'); }
    return onHfsSyscall(request);
}
registerHandler(sysDiskGuard, Disk.vector, 1);
registerHandler(sysHostFolderGuard, Hfs.vector, 1);

// [name, password, firstLogin]: becomes that user, and says [uid, gid, home, name]; an error text when it
// cannot. Root may become anyone; anybody else needs the password. 'firstLogin' is the prompt when the
// shell starts: it asks for the password whoever the shell runs as, and there is nothing to switch back to.
def sysLogin(request) {
    c = Ctx.me();
    u = Users.find(request[0]);
    if (u == nil) { return 'no such user'; }
    asked = request[2] || c.uid != 0;
    if (asked && !Users.verify(u[0], request[1])) {
        Log.writeDirect('login failed for ' + request[0]);
        return 'wrong password';
    }
    if (!request[2]) { push(c.stack, [c.uid, c.gid, c.groups]); }
    c.uid = u[1];
    c.gid = u[2];
    c.groups = Users.groupsOf(u[0]);
    if (len(c.groups) == 0) { c.groups = [u[2]]; }
    Log.writeDirect('login: ' + u[0] + ' (uid ' + u[1] + ')');
    return [u[1], u[2], u[3], u[0]];
}
registerHandler(sysLogin, Sys.login, 1);

// back to who the shell was before the last su: [uid, gid, home, name], or nil when there is nowhere to go back to
def sysLogout(request) {
    c = Ctx.me();
    if (len(c.stack) == 0) { return nil; }
    previous = pop(c.stack);
    c.uid = previous[0];
    c.gid = previous[1];
    c.groups = previous[2];
    return sysWho(nil);
}
registerHandler(sysLogout, Sys.logout, 1);

// who the caller runs as: [uid, gid, home, name, groups]
def sysWho(request) {
    c = Ctx.me();
    u = Users.findUid(c.uid);
    if (u == nil) { return [c.uid, c.gid, c.uid == 0 ? 'root' : '', c.uid == 0 ? 'root' : '#' + c.uid, c.groups]; }
    return [c.uid, c.gid, u[3], u[0], c.groups];
}
registerHandler(sysWho, Sys.who, 1);

// [user, oldPassword, newPassword]: '' when changed, else why not. Root may change anyone's without the old one.
def sysSetPassword(request) {
    c = Ctx.me();
    u = Users.find(request[0]);
    if (u == nil) { return 'no such user'; }
    if (c.uid != 0) {
        if (c.uid != u[1]) { return 'only root may change another user\'s password'; }
        if (!Users.verify(u[0], request[1])) { return 'wrong password'; }
    }
    Users.setPassword(u[0], request[2]);
    Log.writeDirect('password changed for ' + u[0]);
    return '';
}
registerHandler(sysSetPassword, Sys.setPassword, 1);

// root only: the processes have been stopped (the shutdown command did that); now the shell ends, which halts the machine
def sysShutdown(request) {
    if (Ctx.me().uid != 0) { return 'only root may do that'; }
    Log.writeDirect('shutdown: halting');
    Power.requested = true;
    ShellState.running = false;
    return '';
}
registerHandler(sysShutdown, Sys.shutdown, 1);

// folders the system needs, made while the shell is still privileged: tmp/ for everybody, root's home
def ensureSystemDirs() {
    if (!Fs.mounted) { return nil; }
    if (!Fs.exists('tmp/')) { Fs.write('tmp/', ''); }
    if (Fs.stat('tmp')[2] != 0x3FF) { Fs.chmod('tmp', 0x3FF); }      // 1777: anyone may make files there (pipes use it), only their owners remove them
    if (!Fs.exists('root/')) {
        Fs.write('root/', '');
        Fs.chmod('root', 0x1C0);             // 0700
    }
    if (!Fs.exists('home/')) { Fs.write('home/', ''); }
    if (!Fs.exists('var/run/')) { Fs.write('var/run/', ''); }
    // users' own cron tables: anyone may make theirs here, only they (and root) may remove it
    if (!Fs.exists('var/cron/')) { Fs.write('var/cron/', ''); }
    if (Fs.stat('var/cron')[2] != 0x3FF) { Fs.chmod('var/cron', 0x3FF); }
}

// etc/fstab: one line per drive to mount at start, '<drive number> <folder>'; # starts a comment. A line that
// cannot be done (no such drive, no file system on it) is logged and skipped.
def mountFstab() {
    if (!Fs.mounted || !Fs.exists('etc/fstab')) { return nil; }
    lines = Split.split(Fs.read('etc/fstab'), strChar(10));
    i = 0;
    while (i < len(lines)) {
        words = tokens(lines[i]);
        if (len(words) == 2 && strSub(words[0], 0, 1) != '#') {
            unit = unsignedNumber(words[0]);
            try {
                if (unit == nil) { throw('not a drive number'); }
                Fs.mountDrive(unit, FsPath.resolve('', words[1]));
            } catch (e) {
                Log.write('fstab: ' + lines[i] + ': ' + str(e));
            }
        }
        i += 1;
    }
}

def isBuiltin(cmd) {
    return Arr.contains(shellBuiltins(), cmd);
}

def programPath(cmd) {
    return 'bin/' + cmd + '.bl0c';
}

// the folders programs are looked for in: the variable PATH, folders separated by ':' ('.' is the
// current folder, a leading '/' is ignored)
def pathDirs() {
    value = varGet('PATH');
    dirs = [];
    if (value == nil) { return dirs; }
    parts = Split.split(value, ':');
    i = 0;
    while (i < len(parts)) {
        d = parts[i];
        if (d == '.') { push(dirs, ShellState.cwd); }
        else if (d != '') { push(dirs, FsPath.resolve('', d)); }
        i += 1;
    }
    return dirs;
}

// the file of the program 'cmd' names, or nil. A name with a '/' is a path (the .bl0c may be left
// off); any other name is looked for in the PATH folders.
def findProgram(cmd) {
    if (!Fs.mounted) { return nil; }
    if (strFind(cmd, '/', 0) >= 0) {
        path = here(cmd);
        if (Fs.size(path) >= 0 && !Dirs.isDir(path)) { return path; }
        if (Fs.size(path + '.bl0c') >= 0) { return path + '.bl0c'; }
        return nil;
    }
    dirs = pathDirs();
    i = 0;
    while (i < len(dirs)) {
        path = FsPath.prefix(dirs[i]) + cmd + '.bl0c';
        if (Fs.size(path) >= 0) { return path; }
        i += 1;
    }
    return nil;
}

// Runs the program at 'path' here, on the shell's own core, with 'words' as its command line (words[0]
// is its name). Whatever redirection or pipe this core's Ctx holds applies; the ends of the pipes
// close when it is over. Ctrl-C meanwhile is a request to stop it, not text for it.
def runProgram(path, words, label) {
    c = Ctx.me();
    if (path == nil || !Disk.present() || !Fs.mounted || Fs.size(path) < 0) {
        sayErr(label + ': command not found');
        c.finish();
        return nil;
    }
    c.words = words;
    c.cwd = ShellState.cwd;
    poke32(Abort.base, 0);
    poke32(abortForegroundWord(), 1);
    problem = syscall(Exec.vector, path);
    poke32(abortForegroundWord(), 0);
    poke32(Abort.base, 0);
    c.finish();
    if (problem != '') {
        problem = programError(problem);
        if (problem == 'interrupted') {
            sayErr('^C');
        } else {
            say(label + ': ' + problem);
            Log.write('shell: ' + label + ' failed: ' + problem);
        }
    }
}

// exec <file> [arguments]: any compiled program on the disk, by path
def cmdExec(words) {
    if (len(words) < 2) { sayErr('usage: exec <file> [arguments]'); return nil; }
    if (!fsReady()) { return nil; }
    runProgram(here(words[1]), Arr.slice(words, 1, len(words)), words[1]);
}

// echo [-n] words...
def cmdEcho(words) {
    newline = true;
    from = 1;
    if (len(words) > 1 && words[1] == '-n') { newline = false; from = 2; }
    text = restOf(words, from);
    if (newline) { say(text); } else { sayRaw(text); }
}

// a built-in that fails (disk full, bad name, ...) reports it and the shell carries on
def guarded(command, words) {
    try {
        command(words);
    } catch (e) {
        sayErr(str(e));
    }
}

// one command of a pipeline, here on the shell's core: a built-in or a program on the disk
def runStage(words) {
    cmd = words[0];
    if (cmd == 'help') { cmdHelp(); return nil; }
    if (cmd == 'clear') { consoleWrite(Term.clearScreen()); return nil; }
    if (cmd == 'uptime') { cmdUptime(); return nil; }
    if (cmd == 'whoami') { cmdWhoami(); return nil; }
    if (cmd == 'reboot') { cmdReboot(); return nil; }
    if (cmd == 'exit') { cmdExit(); return nil; }
    if (cmd == 'su') { cmdSu(words); return nil; }
    if (cmd == 'id') { cmdId(); return nil; }
    if (cmd == 'echo') { cmdEcho(words); return nil; }
    if (cmd == 'pwd') { cmdPwd(); return nil; }
    if (cmd == 'cd') { guarded(cmdCd, words); return nil; }
    if (cmd == 'exec') { guarded(cmdExec, words); return nil; }
    if (cmd == 'sh') { guarded(cmdSh, words); return nil; }
    if (cmd == 'set') { cmdSet(words); return nil; }
    if (cmd == 'unset') { guarded(cmdUnset, words); return nil; }
    if (cmd == 'alias') { guarded(cmdAlias, words); return nil; }
    if (cmd == 'unalias') { guarded(cmdUnalias, words); return nil; }
    if (cmd == 'which') { cmdWhich(words); return nil; }
    if (cmd == 'history') { cmdHistory(words); return nil; }
    if (cmd == 'format') { guarded(cmdFormat, words); return nil; }
    // anything else: a program on the disk
    found = findProgram(cmd);
    runProgram(found, words, cmd);
}

// Runs the stages one after another, on this core. Each stage's standard input and output are files:
// what a stage prints is written to a temporary file (tmp/pipe<N>) that the next stage reads.
// This is how a pipeline runs when the machine has too few cores to run its stages at the same time, or
// a stage is a built-in (which only the shell can run). '< file' and '> file' / '>> file' name the
// first stage's input and the last stage's output. The temporary files are removed afterwards,
// whatever happened.
def runSequential(stages) {
    c = Ctx.me();
    temps = [];
    last = len(stages) - 1;
    i = 0;
    while (i <= last) {
        stage = stages[i];
        inPath = '';
        outPath = '';
        if (i > 0) { inPath = temps[i - 1]; }
        if (stage.inFile != nil) {
            inPath = here(stage.inFile);
            if (!Fs.exists(inPath)) {
                sayErr(stage.inFile + ': no such file');
                break;
            }
        }
        if (i < last) {
            ShellState.pipeSeq += 1;
            outPath = 'tmp/pipe' + ShellState.pipeSeq;
            push(temps, outPath);
            Fs.write(outPath, '');
        } else if (stage.outFile != nil) {
            outPath = here(stage.outFile);
            if (!stage.append) { Fs.write(outPath, ''); }
        }
        if (!Fs.mounted && (inPath != '' || outPath != '')) {
            sayErr('redirection needs a disk with a filesystem');
            break;
        }
        c.reset();
        c.inPath = inPath;
        c.outPath = outPath;
        guarded(runStage, stage.words);
        c.finish();
        i += 1;
    }
    c.reset();
    i = 0;
    while (i < len(temps)) {
        Fs.remove(temps[i]);
        i += 1;
    }
}

// Runs the stages at the same time, each on a core of its own, joined by pipes: the output of one
// is read by the next while it is still being written. The last stage runs on the shell's core (and
// the shell waits for it, then for the rest); in the background every stage goes to a worker and the
// shell carries on at once. Needs a free worker core per stage that is not on the shell's own core.
def runConcurrent(stages, background) {
    n = len(stages);
    pipes = [];
    i = 0;
    while (i < n - 1) {
        push(pipes, new Pipe());
        i += 1;
    }
    started = background ? n : n - 1;
    spawned = [];
    failed = false;
    i = 0;
    while (i < started && !failed) {
        stage = stages[i];
        cmd = stage.words[0];
        inPath = '';
        outPath = '';
        pipeIn = nil;
        pipeOut = nil;
        if (i > 0) { pipeIn = pipes[i - 1]; }
        if (stage.inFile != nil) {
            inPath = here(stage.inFile);
            if (!Fs.exists(inPath)) {
                sayErr(stage.inFile + ': no such file');
                failed = true;
            }
        }
        if (i < n - 1) {
            pipeOut = pipes[i];
        } else if (stage.outFile != nil) {
            outPath = here(stage.outFile);
            if (!stage.append) { Fs.write(outPath, ''); }
        }
        found = failed ? nil : findProgram(cmd);
        if (!failed && found == nil) {
            sayErr(cmd + ': command not found');
            failed = true;
        }
        if (!failed) {
            result = syscall(Exec.spawnVector, [found, stage.words, ShellState.cwd, [inPath, outPath, pipeIn, pipeOut, background]]);
            if (result[0]) {
                push(spawned, result[1]);
                if (background) { say('[' + result[1].pid + '] ' + cmd); }
            } else {
                sayErr(result[1]);
                failed = true;
            }
        }
        i += 1;
    }
    if (failed) {
        // what was started cannot finish without the rest: stop it and let its pipes close
        i = 0;
        while (i < len(spawned)) {
            Proc.kill(spawned[i].pid);
            i += 1;
        }
        i = 0;
        while (i < len(pipes)) {
            pipes[i].closeWrite();
            pipes[i].closeRead();
            i += 1;
        }
        return nil;
    }
    if (background) { return nil; }

    // the last stage, here
    stage = stages[n - 1];
    c = Ctx.me();
    c.reset();
    c.pipeIn = pipes[n - 2];
    if (stage.outFile != nil) {
        c.outPath = here(stage.outFile);
        if (!stage.append) { Fs.write(c.outPath, ''); }
    }
    runStage(stage.words);
    // it is over, or it ended early (head, ...): its input pipe is closed, so a producer still writing
    // gets 'broken pipe' and stops; now wait for the others
    i = 0;
    while (i < len(spawned)) {
        Proc.waitFor(spawned[i].pid);
        i += 1;
    }
}

// how a pipeline is run: the stages at the same time when there are cores for it
def runPipeline(stages) {
    n = len(stages);
    background = stages[n - 1].background;
    programsOnly = true;
    i = 0;
    while (i < n) {
        if (isBuiltin(stages[i].words[0])) { programsOnly = false; }
        i += 1;
    }
    needed = background ? n : n - 1;
    if (background) {
        if (!programsOnly) { sayErr('a built-in cannot run in the background'); return nil; }
        if (Proc.freeCores() < needed) {
            sayErr('no free core to run it in the background (' + Proc.workers() + ' worker cores; start the machine with a higher -n)');
            return nil;
        }
        runConcurrent(stages, true);
        return nil;
    }
    if (n > 1 && programsOnly && Proc.freeCores() >= needed) {
        runConcurrent(stages, false);
    } else {
        runSequential(stages);
    }
    Ctx.me().reset();
}

def runCommand(line) {
    if (line == '') { return nil; }
    Log.write('shell: ' + line);
    stages = [];
    try {
        stages = Cmdline.parse(Cmdline.expand(line, varGet));
    } catch (e) {
        sayErr(str(e));
        return nil;
    }
    if (len(stages) == 1 && isAssignments(stages[0])) {
        i = 0;
        while (i < len(stages[0].words)) {
            eq = strFind(stages[0].words[i], '=', 0);
            varSet(strSub(stages[0].words[i], 0, eq), strSub(stages[0].words[i], eq + 1, len(stages[0].words[i])));
            i += 1;
        }
        return nil;
    }
    if (len(stages) > 0) {
        expandAliases(stages);
        try {
            runPipeline(stages);
        } catch (e) {
            // a redirection to a file the user may not write, a full disk: the command fails, the shell goes on
            sayErr(str(e));
        }
    }
}

// --- aliases ---

def aliasGet(name) {
    i = 0;
    while (i < len(ShellState.aliases)) {
        if (ShellState.aliases[i][0] == name) { return ShellState.aliases[i][1]; }
        i += 1;
    }
    return nil;
}

// alias               lists them
// alias name=text     'name' now stands for 'text' (a simple command: no pipe, no redirection)
// alias name          shows one
def cmdAlias(words) {
    if (len(words) == 1) {
        i = 0;
        while (i < len(ShellState.aliases)) {
            say('alias ' + ShellState.aliases[i][0] + "='" + ShellState.aliases[i][1] + "'");
            i += 1;
        }
        return nil;
    }
    i = 1;
    while (i < len(words)) {
        eq = strFind(words[i], '=', 0);
        if (eq < 0) {
            v = aliasGet(words[i]);
            if (v == nil) { sayErr(words[i] + ': no such alias'); }
            else { say('alias ' + words[i] + "='" + v + "'"); }
        } else {
            name = strSub(words[i], 0, eq);
            text = strSub(words[i], eq + 1, len(words[i]));
            if (name == '' || strFind(name, ' ', 0) >= 0) {
                sayErr('alias: bad name');
            } else {
                parsed = Cmdline.parse(text);
                if (len(parsed) != 1 || parsed[0].inFile != nil || parsed[0].outFile != nil || parsed[0].background || len(parsed[0].words) == 0) {
                    sayErr('alias: the text must be one simple command');
                } else {
                    unaliasOne(name);
                    push(ShellState.aliases, [name, text]);
                }
            }
        }
        i += 1;
    }
}

def unaliasOne(name) {
    kept = [];
    i = 0;
    while (i < len(ShellState.aliases)) {
        if (ShellState.aliases[i][0] != name) { push(kept, ShellState.aliases[i]); }
        i += 1;
    }
    ShellState.aliases = kept;
}

def cmdUnalias(words) {
    if (len(words) < 2) { sayErr('usage: unalias <name>...'); return nil; }
    i = 1;
    while (i < len(words)) {
        if (aliasGet(words[i]) == nil) { sayErr(words[i] + ': no such alias'); }
        unaliasOne(words[i]);
        i += 1;
    }
}

// the first word of each stage that is an alias is replaced by the alias's words (an alias that names
// another alias is followed, each at most once, so 'alias ls=ls' is fine)
def expandAliases(stages) {
    i = 0;
    while (i < len(stages)) {
        seen = [];
        while (len(stages[i].words) > 0 && !Arr.contains(seen, stages[i].words[0])) {
            text = aliasGet(stages[i].words[0]);
            if (text == nil) { break; }
            push(seen, stages[i].words[0]);
            parsed = Cmdline.parse(text);
            stages[i].words = Arr.concat(parsed[0].words, Arr.slice(stages[i].words, 1, len(stages[i].words)));
        }
        i += 1;
    }
}

// which <name>...: what a command word stands for
def cmdWhich(words) {
    if (len(words) < 2) { sayErr('usage: which <name>...'); return nil; }
    i = 1;
    while (i < len(words)) {
        w = words[i];
        if (aliasGet(w) != nil) { say(w + ": alias for '" + aliasGet(w) + "'"); }
        else if (isBuiltin(w)) { say(w + ': a built-in command'); }
        else {
            found = findProgram(w);
            if (found == nil) { sayErr(w + ': not found'); } else { say('/' + found); }
        }
        i += 1;
    }
}

// --- history ---

// history: the remembered commands, numbered (the numbers are positions in the list the editor keeps:
// the last 200). '!!' is the previous command, '!N' command N, '!-N' the Nth from the last, '!text' the
// latest one that starts with text; what follows on the line is appended.
def cmdHistory(words) {
    h = LineEditor.history;
    i = 0;
    while (i < len(h)) {
        say(Fmt.format('{:>5}  {}', [i + 1, h[i]]));
        i += 1;
    }
}

// the line with a leading !-reference replaced, or nil when there is no such command. The line itself
// (just remembered by the editor) is the last history entry and is not a candidate.
def histExpand(line) {
    h = LineEditor.history;
    last = len(h) - 2;
    sp = strFind(line, ' ', 0);
    token = sp < 0 ? line : strSub(line, 0, sp);
    rest = sp < 0 ? '' : strSub(line, sp, len(line));
    ref = strSub(token, 1, len(token));
    entry = nil;
    if (ref == '!') {
        if (last >= 0) { entry = h[last]; }
    } else if (ref != '' && strFind('0123456789', strSub(ref, 0, 1), 0) >= 0) {
        n = portNumber(ref);
        if (n != nil && n >= 1 && n <= last + 1) { entry = h[n - 1]; }
    } else if (len(ref) > 1 && strSub(ref, 0, 1) == '-') {
        n = portNumber(strSub(ref, 1, len(ref)));
        if (n != nil && n >= 1 && last + 1 - n >= 0) { entry = h[last + 1 - n]; }
    } else if (ref != '') {
        i = last;
        while (i >= 0 && entry == nil) {
            if (strFind(h[i], ref, 0) == 0) { entry = h[i]; }
            i -= 1;
        }
    }
    if (entry == nil) { return nil; }
    return entry + rest;
}

// --- variables and scripts ---

def varGet(name) {
    i = 0;
    while (i < len(ShellState.vars)) {
        if (ShellState.vars[i][0] == name) { return ShellState.vars[i][1]; }
        i += 1;
    }
    return nil;
}

def varSet(name, value) {
    i = 0;
    while (i < len(ShellState.vars)) {
        if (ShellState.vars[i][0] == name) { ShellState.vars[i][1] = value; return nil; }
        i += 1;
    }
    push(ShellState.vars, [name, value]);
}

def varUnset(name) {
    kept = [];
    i = 0;
    while (i < len(ShellState.vars)) {
        if (ShellState.vars[i][0] != name) { push(kept, ShellState.vars[i]); }
        i += 1;
    }
    ShellState.vars = kept;
}

// NAME=value (a letter or _ first, then letters, digits, _): the line only sets variables
def isAssignments(stage) {
    if (stage.inFile != nil || stage.outFile != nil || stage.background) { return false; }
    i = 0;
    while (i < len(stage.words)) {
        w = stage.words[i];
        eq = strFind(w, '=', 0);
        if (eq < 1) { return false; }
        j = 0;
        while (j < eq) {
            c = strSub(w, j, j + 1);
            if (!Cmdline.isNameChar(c) || (j == 0 && strFind('0123456789', c, 0) >= 0)) { return false; }
            j += 1;
        }
        i += 1;
    }
    return len(stage.words) > 0;
}

def cmdSet(words) {
    i = 0;
    while (i < len(ShellState.vars)) {
        say(ShellState.vars[i][0] + '=' + ShellState.vars[i][1]);
        i += 1;
    }
}

def cmdUnset(words) {
    if (len(words) < 2) { sayErr('usage: unset <name>...'); return nil; }
    i = 1;
    while (i < len(words)) {
        varUnset(words[i]);
        i += 1;
    }
}

// sh <file> [arguments]: the lines of a text file, run as commands. Empty lines and lines starting with
// # are skipped. The arguments are the variables $1, $2, ... and $0 is the file's name; they are what they
// were before once the script has ended.
def cmdSh(words) {
    if (len(words) < 2) { sayErr('usage: sh <file> [arguments]'); return nil; }
    if (!fsReady()) { return nil; }
    if (ShellState.depth >= 8) { sayErr('sh: scripts nested too deeply'); return nil; }
    text = Fs.read(here(words[1]));
    if (text == nil) { sayErr(words[1] + ': no such file'); return nil; }
    saved = [];
    i = 0;
    while (i < len(words) - 1 || i < 10) {
        saved = Arr.concat(saved, [varGet('' + i)]);
        if (i < len(words) - 1) { varSet('' + i, words[i + 1]); } else { varUnset('' + i); }
        i += 1;
    }
    ShellState.depth += 1;
    lines = Split.split(text, strChar(10));
    n = 0;
    while (n < len(lines) && ShellState.running) {
        line = Trim.trim(lines[n]);
        if (line != '' && strSub(line, 0, 1) != '#') { runCommand(line); }
        n += 1;
    }
    ShellState.depth -= 1;
    i = 0;
    while (i < len(saved)) {
        if (saved[i] == nil) { varUnset('' + i); } else { varSet('' + i, saved[i]); }
        i += 1;
    }
}

// --- command history and completion for the line editor ---

// the history lives on the disk (<home>/.history), one line per command; the editor
// keeps the last 200 in memory
def histLoad() {
    if (!Fs.mounted) { return nil; }
    text = Fs.read(histPath());
    if (text == nil) { return nil; }
    lines = Split.split(text, strChar(10));
    kept = [];
    i = 0;
    while (i < len(lines)) {
        if (lines[i] != '') { push(kept, lines[i]); }
        i += 1;
    }
    if (len(kept) > 400) {
        // the file only grows: cut it back to the lines that count
        kept = Arr.slice(kept, len(kept) - 200, len(kept));
        Fs.write(histPath(), strJoin(kept, strChar(10)) + strChar(10));
    }
    i = 0;
    while (i < len(kept)) {
        LineEditor.remember(kept[i]);
        i += 1;
    }
}

def histPath() {
    return ShellState.home + '/.history';
}

def histSave(line) {
    if (!Fs.mounted) { return nil; }
    try {
        Fs.append(histPath(), line + strChar(10));
    } catch (e) {
        // a full disk must not stop the shell
    }
}

def shellBuiltins() {
    return ['help', 'echo', 'uptime', 'whoami', 'clear', 'reboot', 'exit', 'pwd', 'cd', 'format', 'exec', 'sh', 'set', 'unset', 'alias', 'unalias', 'which', 'history', 'su', 'id'];
}

// Tab: what could replace the word under the cursor. The first word is a command
// (a built-in or a program in bin/); any other word is a path.
def shellComplete(line, pos) {
    start = pos;
    while (start > 0 && strSub(line, start - 1, start) != ' ') { start -= 1; }
    word = strSub(line, start, pos);
    firstWord = len(Substr.substr(line, 0, start)) == 0 || len(tokens(strSub(line, 0, start))) == 0;
    found = [];
    if (firstWord && strFind(word, '/', 0) < 0) {
        names = shellBuiltins();
        i = 0;
        while (i < len(names)) {
            if (strFind(names[i], word, 0) == 0) { push(found, names[i]); }
            i += 1;
        }
        i = 0;
        while (i < len(ShellState.aliases)) {
            if (strFind(ShellState.aliases[i][0], word, 0) == 0 && !Arr.contains(found, ShellState.aliases[i][0])) { push(found, ShellState.aliases[i][0]); }
            i += 1;
        }
        if (Fs.mounted) {
            dirs = pathDirs();
            d = 0;
            while (d < len(dirs)) {
                if (Dirs.isDir(dirs[d])) {
                    programs = Dirs.list(dirs[d]);
                    i = 0;
                    while (i < len(programs)) {
                        n = programs[i][0];
                        if (!programs[i][2] && len(n) > 5 && strSub(n, len(n) - 5, len(n)) == '.bl0c') { n = strSub(n, 0, len(n) - 5); }
                        if (strFind(n, word, 0) == 0 && !Arr.contains(found, n)) { push(found, n); }
                        i += 1;
                    }
                }
                d += 1;
            }
        }
        return [start, found];
    }
    if (!Fs.mounted) { return nil; }
    slash = -1;
    i = 0;
    while (i < len(word)) {
        if (strSub(word, i, i + 1) == '/') { slash = i; }
        i += 1;
    }
    dirPart = slash < 0 ? '' : strSub(word, 0, slash + 1);
    namePart = strSub(word, slash + 1, len(word));
    dir = ShellState.cwd;
    if (dirPart != '') { dir = here(dirPart); }
    if (!Dirs.isDir(dir)) { return nil; }
    entries = Dirs.list(dir);
    i = 0;
    while (i < len(entries)) {
        if (strFind(entries[i][0], namePart, 0) == 0) {
            push(found, dirPart + entries[i][0] + (entries[i][2] ? '/' : ''));
        }
        i += 1;
    }
    return [start, found];
}

LineEditor.completer = shellComplete;
ensureSystemDirs();
mountFstab();


consoleWriteLine('=== aeon-os shell booting ===');

// from here on a program in user mode reaches the disk only through the kernel's gate
Fs.gate = Sys.fsGate;
dropToUserMode();

consoleWriteLine(Term.paintBold(6, '  aeon-os') + Term.paint(7, ' - ' + coreCount() + ' core(s)'));
consoleWriteLine('aeon-shell ready - type a command, press enter (try: ' + Term.paint(3, 'help') + ')');

// the machine's own start-up: etc/rc is run as root before anybody logs in (service boot is there)
if (Fs.mounted && Fs.exists('etc/rc')) { cmdSh(['sh', 'etc/rc']); }

// who is at the keyboard: root straight away, unless root has a password
loginIfNeeded();
if (ShellState.running) {
    me = syscall(Sys.who, nil);
    adoptIdentity(me);
    if (me[0] != 0 && Fs.stat(ShellState.home) != nil) { ShellState.cwd = ShellState.home; }
}

// the user's own settings: etc/profile is run as a script before the first prompt
if (ShellState.running && Fs.mounted && Fs.exists('etc/profile')) { cmdSh(['sh', 'etc/profile']); }

commandsRun = 0;
// The line editor sleeps in kbWait() while there is no input: the keyboard handler
// signals an event on every byte, so the shell costs no CPU while idle and reacts the
// moment the handler has run (waitEvent also returns early when an interrupt this core
// can take is pending, which is what lets a single core run its own keyboard handler
// while it sits here). waitEvent is unprivileged, so this is fine after dropToUserMode().
while (ShellState.running) {
    line = LineEditor.read(prompt());
    if (line == nil) {
        // Ctrl-D on an empty line is exit (unless the machine is already going down)
        if (Power.requested) { ShellState.running = false; } else { cmdExit(); }
    } else {
        if (len(line) > 1 && strSub(line, 0, 1) == '!') {
            // the editor remembered the line as typed; what runs (and is remembered) is what it stands for
            expanded = histExpand(line);
            h = LineEditor.history;
            pop(h);
            if (expanded == nil) {
                sayErr(line + ': event not found');
                line = '';
            } else {
                line = expanded;
                LineEditor.remember(line);
                say(line);
            }
        }
        if (line != '') { histSave(line); }
        runCommand(line);
        commandsRun = commandsRun + 1;
    }
}

Log.write('shell: exiting after ' + commandsRun + ' commands');
consoleWriteLine('=== aeon-shell exiting after ' + commandsRun + ' commands ===');
consoleFlush();
