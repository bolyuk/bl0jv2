// aeon-os (shell): a tiny bash-like REPL, running almost entirely in USER
// MODE. Single-core, like boot.bl0 - not smp_boot.bl0 - because nothing
// here needs more than one core, and it sidesteps that file's own
// cross-core interrupt-stealing hazard entirely (see its header comment).
// Driver code (heap, keyboard, console) comes from aeon-os/kernel.bl0, not
// copy-pasted here - see that file's own header comment for what "shared"
// does and doesn't mean. Normally launched as a child process of
// aeon-os/boot.bl0 (via journalExec('shell', ...) - see boot.bl0's own
// header comment), not run directly, though running this file's own
// compiled output standalone still works the same way it always did.
//
// The kernel does its one-time setup (heap, keyboard driver, console
// device + syscall gate) while still privileged, then drops to user mode
// ONCE, right before the shell starts. Everything from there on - the
// REPL loop and every command it runs - executes unprivileged. `reboot`
// proves it: it tries to bypass the console's syscall gate and write to
// the device directly, and gets blocked, the same enforcement pattern
// smp_boot.bl0's taskRogue demonstrates.
//
// Reading the keyboard needs no syscall at all: kbHasInput()/kbReadChar()
// only ever peek8() a ring buffer in raw memory (never gated - see
// requirePrivileged's own doc on why) - it's a read-only, kernel-populated
// buffer userspace polls directly, the same shape a real io_uring/vDSO
// shared ring gives userspace lock-free reads without a syscall per byte.
// Writing to the actual console device is a different story - out8() IS
// gated, so every command's output goes through syscall(sysWriteVector).
//
// A syscall handler must never itself call haltCore(): the only thing
// that can actually turn a *pending* interrupt into a *delivered* one
// (i.e. run its handler, which is what would make kbHasInput() true) is
// the outermost poll-eligible execute() loop - and a syscall trap has
// already left that loop by the time its own handler body runs. Blocking
// there waits for a delivery that can only happen after the block ends,
// which never happens. This is why the REPL loop below checks kbHasInput()
// itself (sleeping in kbWait() when there is nothing) instead of trying to
// wrap it in a "blocking read" syscall - a design this file's author tried
// first, and which hangs for exactly the reason above.

import '../stdlib/mathlib.bl0';
import 'kernel.bl0';
import '../stdlib/net/icmp.bl0';
import '../stdlib/net/tcp.bl0';
import '../stdlib/net/udp.bl0';
import '../stdlib/net/dns.bl0';
import '../stdlib/net/http.bl0';
import '../stdlib/str/split.bl0';
import '../stdlib/str/fmt.bl0';
import '../stdlib/fs/fs.bl0';

// when boot.bl0 exec()s this file, it already called kernel.bl0's
// initHeap() with ITS OWN reserved regions accounted for (see its own
// doc) - since exec() now shares one raw memory arena (see Bl0jv2_jVM's
// own exec() doc), calling initHeap() again here would reset that shared
// counter and let this file's own kalloc() calls overwrite whatever the
// kernel (or an earlier child) already allocated. peek32(0) reading back
// 0 is how a fresh, never-initialized counter looks (see kernel.bl0's own
// doc) - not a bulletproof test in general, but reliable for this
// project, where every initHeap() caller reserves at least a few bytes
// below the heap first, so a real heapBase is never actually 0. This is
// what lets this file still run standalone (`bl0jv2 -e -k
// aeon-os/shell.bl0c`, no boot.bl0 involved) as well as exec()'d
if (peek32(0) == 0) {
    initHeap(4);
}
initKeyboard();
initConsole();
// the network device: init() or initWithHostBridge(), whichever the host attached
// (privileged - reads a port and registers handlers - so it happens here, before
// dropToUserMode(); afterwards the shell sends through the kernel's syscall)
Nic.initAuto();
Dns.myIp = Net.localIp;
TcpConn.connectTimeoutMs = 5000;
// the disk, if the host attached one (privileged, like the NIC): a sector buffer
// in raw memory, then mount - an unformatted disk stays unmounted until 'format'
Disk.init(kalloc(512));
if (Disk.present()) { Fs.mount(); }

// --- built-in commands ---
def cmdHelp() {
    consoleWriteLine('available commands: help, echo <text>, uptime, whoami, reboot, exit');
    consoleWriteLine('files:   ls [prefix], cat <file>, write <file> <text>, append <file> <text>, rm <file>,');
    consoleWriteLine('         mv <from> <to>, cp <from> <to>, df, format yes');
    consoleWriteLine('network: net, netstat, setip <ip>, setdns <ip>, ping <host>, resolve <host>,');
    consoleWriteLine('         http <host[:port]> [path], tcp <host> <port> <text>, udp <host> <port> <text>, httpd <port>');
}

def cmdUptime() {
    consoleWriteLine('uptime: ' + ticks() + 'ms');
}

def cmdWhoami() {
    if (isPrivileged()) {
        consoleWriteLine('kernel');
    } else {
        consoleWriteLine('user');
    }
}

// deliberately tries to bypass the syscall gate and write to the console
// device directly - proves the ring boundary is real, not just documented
def cmdReboot() {
    try {
        out8(Console.port, 0);
        consoleWriteLine('rebooting...');
    } catch (e) {
        consoleWriteLine('reboot: permission denied');
    }
}

// --- network commands ---
//
// <host> is a dotted address (10.0.0.2) or a name, looked up with 'resolve'.
// Reaching anything beyond this machine's own loopback needs the host to attach a
// bridge (bl0jv2 --bridge-outbound ...): without one, frames only ever come back
// to this same VM, so a ping to another address times out, which is the true answer.

def class ShellNet {
    static field nextPort;
}
ShellNet.nextPort = 49152;

def freePort() {
    p = ShellNet.nextPort;
    ShellNet.nextPort += 1;
    if (ShellNet.nextPort > 65000) { ShellNet.nextPort = 49152; }
    return p;
}

// the words of a command line, without the empty pieces repeated spaces leave
def tokens(text) {
    raw = Split.split(text, ' ');
    words = [];
    i = 0;
    while (i < len(raw)) {
        if (raw[i] != '') { push(words, raw[i]); }
        i += 1;
    }
    return words;
}

// everything from word 'from' on, joined with single spaces
def restOf(words, from) {
    return Arr.join(Arr.slice(words, from, len(words)), ' ');
}

// an address: dotted quad as is, otherwise a DNS lookup; nil (after saying why) if neither works
def hostAddress(name) {
    addr = Ip.parseAddr(name);
    if (addr != nil) { return addr; }
    consoleWriteLine('resolving ' + name + '...');
    addr = Dns.resolve(name);
    if (addr == 0) {
        consoleWriteLine(name + ': name not found (no answer from DNS server ' + Ip.formatAddr(Dns.serverIp) + ')');
        return nil;
    }
    return addr;
}

def portNumber(text) {
    n = 0;
    i = 0;
    if (len(text) == 0 || len(text) > 5) { return nil; }
    while (i < len(text)) {
        c = int(text[i]);
        if (c < 48 || c > 57) { return nil; }
        n = n * 10 + (c - 48);
        i += 1;
    }
    if (n < 1 || n > 65535) { return nil; }
    return n;
}

def cmdNet() {
    bridge = Nic.hostBridgeEnabled ? 'attached' : 'none (loopback only)';
    consoleWriteLine(Fmt.format('address  {}', [Ip.formatAddr(Net.localIp)]));
    consoleWriteLine(Fmt.format('dns      {}', [Ip.formatAddr(Dns.serverIp)]));
    consoleWriteLine(Fmt.format('bridge   {}', [bridge]));
    consoleWriteLine(Fmt.format('frames   {} sent, {} received, {} waiting, {} dropped by the IP layer', [Nic.txCount, Nic.rxCount, Nic.pending(), Net.dropped]));
}

def cmdNetstat() {
    consoleWriteLine('proto  local                  remote                 state');
    n = 0;
    i = 0;
    while (i < len(TcpRegistry.conns)) {
        c = TcpRegistry.conns[i];
        remote = '*';
        if (c.remoteIp != nil) { remote = Ip.formatAddr(c.remoteIp) + ':' + c.remotePort; }
        consoleWriteLine(Fmt.format('tcp    {:<22} {:<22} {}', [Ip.formatAddr(c.localIp) + ':' + c.localPort, remote, c.state]));
        n += 1;
        i += 1;
    }
    if (n == 0) { consoleWriteLine('(no connections)'); }
}

def cmdSetIp(words) {
    if (len(words) != 2) { consoleWriteLine('usage: setip <a.b.c.d>'); return nil; }
    addr = Ip.parseAddr(words[1]);
    if (addr == nil) { consoleWriteLine(words[1] + ': not an address'); return nil; }
    Net.localIp = addr;
    Dns.myIp = addr;
    consoleWriteLine('address is now ' + Ip.formatAddr(addr));
}

def cmdSetDns(words) {
    if (len(words) != 2) { consoleWriteLine('usage: setdns <a.b.c.d>'); return nil; }
    addr = Ip.parseAddr(words[1]);
    if (addr == nil) { consoleWriteLine(words[1] + ': not an address'); return nil; }
    Dns.serverIp = addr;
    consoleWriteLine('dns server is now ' + Ip.formatAddr(addr));
}

def cmdPing(words) {
    if (len(words) != 2) { consoleWriteLine('usage: ping <host>'); return nil; }
    addr = hostAddress(words[1]);
    if (addr == nil) { return nil; }
    consoleWriteLine('PING ' + Ip.formatAddr(addr) + ' with 32 bytes of data');
    received = 0;
    seq = 1;
    while (seq <= 4) {
        rtt = Icmp.ping(Net.localIp, addr, seq, 1000);
        if (rtt < 0) {
            consoleWriteLine(Fmt.format('seq={}: request timed out', [seq]));
        } else {
            consoleWriteLine(Fmt.format('reply from {}: seq={} time={}ms', [Ip.formatAddr(addr), seq, rtt]));
            received += 1;
        }
        seq += 1;
    }
    consoleWriteLine(Fmt.format('4 sent, {} received', [received]));
}

def cmdResolve(words) {
    if (len(words) != 2) { consoleWriteLine('usage: resolve <host>'); return nil; }
    addr = Dns.resolve(words[1]);
    if (addr == 0) {
        consoleWriteLine(words[1] + ': no answer from DNS server ' + Ip.formatAddr(Dns.serverIp));
    } else {
        consoleWriteLine(words[1] + ' is ' + Ip.formatAddr(addr));
    }
}

def cmdHttp(words) {
    if (len(words) < 2 || len(words) > 3) { consoleWriteLine('usage: http <host[:port]> [path]'); return nil; }
    target = words[1];
    port = 80;
    colon = strFind(target, ':', 0);
    if (colon >= 0) {
        port = portNumber(strSub(target, colon + 1, len(target)));
        target = strSub(target, 0, colon);
        if (port == nil) { consoleWriteLine('bad port'); return nil; }
    }
    path = '/';
    if (len(words) == 3) { path = words[2]; }
    addr = hostAddress(target);
    if (addr == nil) { return nil; }
    response = Http.get(Net.localIp, freePort(), addr, port, path);
    if (response == nil) {
        consoleWriteLine('connection to ' + Ip.formatAddr(addr) + ':' + port + ' timed out');
        return nil;
    }
    parsed = HttpResponse.parse(response);
    consoleWriteLine(parsed.statusLine);
    consoleWriteLine(parsed.body);
}

def cmdTcp(words) {
    if (len(words) < 4) { consoleWriteLine('usage: tcp <host> <port> <text>'); return nil; }
    addr = hostAddress(words[1]);
    if (addr == nil) { return nil; }
    port = portNumber(words[2]);
    if (port == nil) { consoleWriteLine('bad port'); return nil; }
    conn = TcpConn.connect(Net.localIp, freePort(), addr, port);
    if (conn == nil) {
        consoleWriteLine('connection to ' + Ip.formatAddr(addr) + ':' + port + ' timed out');
        return nil;
    }
    conn.send(restOf(words, 3));
    reply = '';
    while (conn.waitData(2000)) { reply = reply + conn.receive(); }
    conn.close();
    if (reply == '') {
        consoleWriteLine('(no reply)');
    } else {
        consoleWriteLine(reply);
    }
}

def cmdUdp(words) {
    if (len(words) < 4) { consoleWriteLine('usage: udp <host> <port> <text>'); return nil; }
    addr = hostAddress(words[1]);
    if (addr == nil) { return nil; }
    port = portNumber(words[2]);
    if (port == nil) { consoleWriteLine('bad port'); return nil; }
    local = freePort();
    Udp.send(Net.localIp, local, addr, port, restOf(words, 3));
    // the datagram we just sent also comes back to us through the loopback NIC:
    // skip it, wait for something that is not from ourselves
    deadline = ticks() + 2000;
    while (true) {
        remaining = deadline - ticks();
        if (remaining <= 0) { consoleWriteLine('(no reply)'); return nil; }
        pkt = Udp.recvWait(local, remaining);
        if (pkt == nil) { consoleWriteLine('(no reply)'); return nil; }
        if (pkt.srcIp == Net.localIp && pkt.srcPort == local) { continue; }
        consoleWriteLine(Fmt.format('reply from {}:{}: {}', [Ip.formatAddr(pkt.srcIp), pkt.srcPort, pkt.message]));
        return nil;
    }
}

def httpdPage(path) {
    return 'hello from aeon-os, you asked for ' + path;
}

// serves exactly ONE request, then returns to the prompt (TcpConn.listen()
// accepts one connection per call - see its own doc); run it again for the next
def cmdHttpd(words) {
    if (len(words) != 2) { consoleWriteLine('usage: httpd <port>'); return nil; }
    port = portNumber(words[1]);
    if (port == nil) { consoleWriteLine('bad port'); return nil; }
    consoleWriteLine('listening on ' + Ip.formatAddr(Net.localIp) + ':' + port + ' for one request...');
    Http.serve(Net.localIp, port, httpdPage);
    consoleWriteLine('served one request');
}

// --- file commands ---
//
// The disk is the host's --disk image behind the block-device ports; Fs (a
// filesystem written in bl0) does the rest. Names are flat: 'docs/a.txt' is one
// name, and 'ls docs/' lists the ones starting with that prefix.

// true when the files can be used; otherwise says why
def fsReady() {
    if (!Disk.present()) {
        consoleWriteLine('no disk attached (start with --disk <image>)');
        return false;
    }
    if (!Fs.mounted) {
        consoleWriteLine('the disk has no filesystem: run "format yes" to create one (erases the disk)');
        return false;
    }
    return true;
}

def cmdLs(words) {
    if (!fsReady()) { return nil; }
    prefix = '';
    if (len(words) > 1) { prefix = words[1]; }
    entries = Fs.list(prefix);
    i = 0;
    while (i < len(entries)) {
        consoleWriteLine(Fmt.format('{:>8}  {}', [entries[i][1], entries[i][0]]));
        i += 1;
    }
    if (len(entries) == 0) { consoleWriteLine('(no files)'); }
}

def cmdCat(words) {
    if (len(words) != 2) { consoleWriteLine('usage: cat <file>'); return nil; }
    if (!fsReady()) { return nil; }
    text = Fs.read(words[1]);
    if (text == nil) {
        consoleWriteLine(words[1] + ': no such file');
    } else {
        consoleWriteLine(text);
    }
}

def cmdWrite(words) {
    if (len(words) < 2) { consoleWriteLine('usage: write <file> <text>'); return nil; }
    if (!fsReady()) { return nil; }
    text = restOf(words, 2);
    Fs.write(words[1], text);
    consoleWriteLine(Fmt.format('wrote {} bytes to {}', [Fs.size(words[1]), words[1]]));
}

def cmdAppend(words) {
    if (len(words) < 3) { consoleWriteLine('usage: append <file> <text>'); return nil; }
    if (!fsReady()) { return nil; }
    Fs.append(words[1], restOf(words, 2));
    consoleWriteLine(Fmt.format('{} is now {} bytes', [words[1], Fs.size(words[1])]));
}

def cmdRm(words) {
    if (len(words) != 2) { consoleWriteLine('usage: rm <file>'); return nil; }
    if (!fsReady()) { return nil; }
    if (!Fs.remove(words[1])) { consoleWriteLine(words[1] + ': no such file'); }
}

def cmdMv(words) {
    if (len(words) != 3) { consoleWriteLine('usage: mv <from> <to>'); return nil; }
    if (!fsReady()) { return nil; }
    if (!Fs.rename(words[1], words[2])) { consoleWriteLine(words[1] + ': no such file'); }
}

def cmdCp(words) {
    if (len(words) != 3) { consoleWriteLine('usage: cp <from> <to>'); return nil; }
    if (!fsReady()) { return nil; }
    text = Fs.read(words[1]);
    if (text == nil) { consoleWriteLine(words[1] + ': no such file'); return nil; }
    Fs.write(words[2], text);
}

def cmdDf(words) {
    if (!fsReady()) { return nil; }
    info = Fs.info();
    consoleWriteLine(Fmt.format('{} files, {} of {} data sectors free ({} bytes free)', [info[3], info[2], info[1], info[2] * 512]));
}

def cmdFormat(words) {
    if (!Disk.present()) { consoleWriteLine('no disk attached (start with --disk <image>)'); return nil; }
    if (len(words) != 2 || words[1] != 'yes') {
        consoleWriteLine('this erases the whole disk: run "format yes" to go ahead');
        return nil;
    }
    Fs.format();
    consoleWriteLine('formatted ' + Disk.sectors + ' sectors');
}

def class ShellState {
    static field running;
}
ShellState.running = true;

// a file command that fails (disk full, bad name, ...) reports it and the shell carries on
def guarded(command, words) {
    try {
        command(words);
    } catch (e) {
        consoleWriteLine(str(e));
    }
}

def runCommand(line) {
    if (line == 'help') { cmdHelp(); return nil; }
    if (line == 'uptime') { cmdUptime(); return nil; }
    if (line == 'whoami') { cmdWhoami(); return nil; }
    if (line == 'reboot') { cmdReboot(); return nil; }
    if (line == 'exit') {
        consoleWriteLine('bye');
        ShellState.running = false;
        return nil;
    }
    if (Affix.startsWith(line, 'echo ')) {
        consoleWriteLine(Substr.substr(line, 5, len(line)));
        return nil;
    }
    if (line == '') { return nil; }

    words = tokens(line);
    if (len(words) == 0) { return nil; }
    cmd = words[0];
    if (cmd == 'ls') { guarded(cmdLs, words); return nil; }
    if (cmd == 'cat') { guarded(cmdCat, words); return nil; }
    if (cmd == 'write') { guarded(cmdWrite, words); return nil; }
    if (cmd == 'append') { guarded(cmdAppend, words); return nil; }
    if (cmd == 'rm') { guarded(cmdRm, words); return nil; }
    if (cmd == 'mv') { guarded(cmdMv, words); return nil; }
    if (cmd == 'cp') { guarded(cmdCp, words); return nil; }
    if (cmd == 'df') { guarded(cmdDf, words); return nil; }
    if (cmd == 'format') { guarded(cmdFormat, words); return nil; }
    if (cmd == 'net') { cmdNet(); return nil; }
    if (cmd == 'netstat') { cmdNetstat(); return nil; }
    if (cmd == 'setip') { cmdSetIp(words); return nil; }
    if (cmd == 'setdns') { cmdSetDns(words); return nil; }
    if (cmd == 'ping') { cmdPing(words); return nil; }
    if (cmd == 'resolve') { cmdResolve(words); return nil; }
    if (cmd == 'http') { cmdHttp(words); return nil; }
    if (cmd == 'tcp') { cmdTcp(words); return nil; }
    if (cmd == 'udp') { cmdUdp(words); return nil; }
    if (cmd == 'httpd') { cmdHttpd(words); return nil; }
    consoleWriteLine(line + ': command not found');
}

println '=== aeon-os shell booting ===';

dropToUserMode();

println 'aeon-shell ready - type a command, press enter (try: help)';
print '$ ';

line = '';
commandsRun = 0;
// sleeps in kbWait() while there is no input: the keyboard ISR signals an
// event on every key, so the shell costs no CPU while idle and reacts to a key
// the moment the ISR has run (waitEvent also returns early when an interrupt
// this core can take is pending, which is what lets a single core run its own
// keyboard ISR while it sits here). waitEvent is unprivileged, so this is fine
// after dropToUserMode().
while (ShellState.running) {
    if (kbHasInput()) {
        b = kbReadChar();
        if (b == 13) {
            println '';
            runCommand(line);
            line = '';
            commandsRun = commandsRun + 1;
            if (ShellState.running) {
                print '$ ';
            }
        } else {
            ch = Char.char(b);
            line = line + ch;
            print ch;
        }
    } else {
        kbWait(1000); // sleeps until a key arrives - see kernel.bl0's kbWait()
    }
}

println '';
println '=== aeon-shell exiting after ' + commandsRun + ' commands ===';
