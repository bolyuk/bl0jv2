// aeon-os (kernel): shared kernel-level building blocks, imported by every
// aeon-os program that needs them (boot.bl0, shell.bl0, and anything
// exec()'d from either) - a single source of truth instead of the same
// driver code copy-pasted into every file that needs a heap/keyboard/
// console. exec() (see Bl0jv2_jVM's own doc) runs a loaded program in the
// SAME Bl0jv2_jVM instance as whatever called it - same managed heap, raw
// memory, ports and interrupt table, not a second one - so this really is
// shared RUNTIME state now, not just shared source: boot.bl0's own
// reservations and this file's heap counter are things every exec()'d
// program genuinely shares, the same way every process on one real
// computer shares its one physical memory.
//
// That sharing is exactly why the heap bump-counter below lives in RAW
// MEMORY at a fixed address instead of a managed static field: a managed
// field is a SEPARATE piece of storage for every program that imports this
// file, even though they're now all running in the same address space -
// only an agreed-upon fixed address is actually common ground between
// them, the same way real physical memory works. Every OTHER program that
// wants a heap has to agree on that address too (see initHeap()'s own doc).

// Char.char()/Affix.startsWith()/Substr.substr() used to be reimplemented
// right here instead of imported - stdlib/str/char.bl0 in particular
// replaces an old byteToChar() that only covered lowercase letters, digits
// and 7 symbols (any uppercase letter or most punctuation silently
// rendered as '?'; the stdlib version covers the full printable ASCII
// range instead)
import '../stdlib/str/char.bl0';
import '../stdlib/str/affix.bl0';
import '../stdlib/str/substr.bl0';
import '../stdlib/str/utf8.bl0';

// --- kernel heap: a minimal bump allocator, backed by one 32-bit counter
// at raw address 0. No free-list, no reuse - kfree() is a deliberate
// no-op. A real allocator (free-list, buddy, slab, whatever policy a
// kernel wants) is exactly the kind of decision that belongs in the OS,
// not baked into the VM - this is the simplest one that proves the
// pattern works end to end ---

// call ONCE, by whichever code boots first (boot.bl0, in this project) -
// NOT by every importer, and NOT at import time (kernel.bl0 is spliced in
// wherever the import statement sits, so calling kalloc() unconditionally
// here would race the caller's own MMIO reservations, however early the
// import happens to appear - see Bl0jv2_Linker's own doc). heapBase is the
// first address the allocator may hand out; the caller picks it based on
// whatever else needs to sit below it (a reserve()'d MMIO block, etc) -
// the same reserve()-then-set-the-bump-pointer pattern this project has
// used since before exec() existed, just via a fixed raw address instead
// of a managed field
def initHeap(heapBase) {
    poke32(0, heapBase);
}

def kalloc(size) {
    return atomicAdd(0, size);
}

def kfree(addr) {
    // no-op - see this section's own header comment
}

// --- keyboard: the receive side of the serial terminal. The device is a FIFO
// behind two ports (data, status) and an interrupt: the interrupt handler drains
// it into a ring buffer, readers take bytes from the ring. What arrives are the
// bytes the terminal sends - UTF-8 text and ANSI sequences for the arrow keys and
// so on; turning those into characters and keys is the job of whoever reads
// (see lib/lineedit.bl0), the driver only moves bytes.
//
// The ring lives in RAW MEMORY, head and tail included, not in static fields:
// a program started from the disk has its own copy of this file (and so its own
// statics), but all copies must see one ring, and raw memory is what they share.
//   +0 head (next slot the handler writes)   +4 tail (next slot a reader takes)
//   +8 the bytes (Keyboard.size of them)
// One slot is always left empty so head==tail means "empty"; when the ring is
// full the newest byte is dropped rather than overwriting unread input ---
def class Keyboard {
    static field dataPort;
    static field statusPort;
    static field vector;
    static field base;     // raw address of the ring (see above)
    static field size;
    static field event;    // signalled by the handler; only the copy that registered it has it
}
Keyboard.dataPort = 0x0F48;
Keyboard.statusPort = 0x0F49;
Keyboard.vector = 2;
Keyboard.size = 256;

def onKeyboardIRQ(vector) {
    while (in8(Keyboard.statusPort) == 1) {
        b = in8(Keyboard.dataPort);
        head = peek32(Keyboard.base);
        next = (head + 1) % Keyboard.size;
        if (next != peek32(Keyboard.base + 4)) {
            poke8(Keyboard.base + 8 + head, b);
            poke32(Keyboard.base, next);
        }
    }
    signalEvent(Keyboard.event);
}

// call once, privileged, after the importer has reserved whatever fixed regions it
// needs (it allocates the ring from the kernel heap - NOT at import time, see
// initHeap)
def initKeyboard() {
    Keyboard.base = kalloc(8 + Keyboard.size);
    poke32(Keyboard.base, 0);
    poke32(Keyboard.base + 4, 0);
    Keyboard.event = newEvent();
    registerHandler(onKeyboardIRQ, Keyboard.vector, 50);
    // bytes the terminal sent before the handler existed are in the FIFO but their interrupt
    // was dropped: take them now
    onKeyboardIRQ(Keyboard.vector);
}

// for a program started from the disk: use the ring the kernel already set up
def attachKeyboard(base) {
    Keyboard.base = base;
}

def kbHasInput() {
    return peek32(Keyboard.base) != peek32(Keyboard.base + 4);
}

// sleeps until a byte is available or timeoutMs passes; true if one is. Not a
// device access, so no privilege needed. The copy that owns the event sleeps on
// it (generation read before the check, so a byte arriving in between is not slept
// through); a program's copy has no event to wait on - handles cannot live in raw
// memory - and sleeps in short steps instead, which costs one timer wake-up per
// step the way an idle loop does on any machine without a better primitive.
def kbWait(timeoutMs) {
    if (Keyboard.event == nil) {
        waited = 0;
        while (!kbHasInput() && waited < timeoutMs) {
            wait(5);
            waited += 5;
        }
        return kbHasInput();
    }
    gen = eventGen(Keyboard.event);
    if (kbHasInput()) { return true; }
    waitEvent(Keyboard.event, gen, timeoutMs);
    return kbHasInput();
}

// the next byte; the caller must check kbHasInput() first
def kbReadByte() {
    tail = peek32(Keyboard.base + 4);
    b = peek8(Keyboard.base + 8 + tail);
    poke32(Keyboard.base + 4, (tail + 1) % Keyboard.size);
    return b;
}

// --- console: the transmit side of the same serial terminal - one port taking
// UTF-8 bytes (and ANSI escape sequences, see lib/term.bl0). Only kernel code may
// out8() to it (see requirePrivileged's own doc); everything else writes through
// the syscall, which takes a whole string: one trap per write, not per byte ---
def class Console {
    static field port;
    static field sysWriteVector;
    static field columns;
    static field rows;
}
Console.port = 0x0F40;
Console.sysWriteVector = 1;
Console.columns = 80;
Console.rows = 24;

// runs ELEVATED (syscall()'s trap gate - see invokeAsTrap), regardless of which
// ring the caller was in
def sysConsoleWrite(text) {
    bytes = Utf8.encode(text);
    i = 0;
    while (i < len(bytes)) {
        out8(Console.port, bytes[i]);
        i += 1;
    }
    free(bytes);
}

// call once, privileged: the write syscall, and the screen size the device reports
def initConsole() {
    registerHandler(sysConsoleWrite, Console.sysWriteVector, 1);
    Console.columns = in16(0x0F44);
    Console.rows = in16(0x0F46);
}

def consoleWrite(s) {
    if (len(s) > 0) { syscall(Console.sysWriteVector, s); }
}

def consoleWriteLine(s) {
    syscall(Console.sysWriteVector, s + '\n');
}
